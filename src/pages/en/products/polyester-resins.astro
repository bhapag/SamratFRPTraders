---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import CategoryHubDetail from '../../../components/product/CategoryHubDetail.astro';
import StatusNotice from '../../../components/StatusNotice.astro';
import { getGroup, productHref, productsInGroup } from '../../../data/products.js';
import { productImageAlt } from '../../../utils/product-page.js';
import Base from '../../../layouts/Base.astro';

const group = getGroup('polyester-resins');
const items = productsInGroup('polyester-resins');
---
<Base
  title="Polyester Resins — Supplier & Importer in Nepal"
  description="Explore the Polyester Resins range supplied and imported by Samrat FRP Traders for buyers across Nepal."
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">Product category</p>
      <h1>{group.name}</h1>
      <p class="page-lead">{group.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/en/' },
          { label: 'Products', href: '/en/products/' },
          { label: group.name },
        ]}
      />

      <div class="category-intro" data-reveal>
        <p>
          Unsaturated polyester resin (UPR) is the broader family represented in this section. Samrat FRP Traders supplies and imports products in this family for buyers across Nepal. Individual grades are listed separately so each product can carry its own verified technical information.
        </p>
        <p>
          If you are specifically searching for a product sold as "Unsaturated Polyester Resin" or "UPR",
          see the <a href="/en/products/unsaturated-polyester-resin/">Unsaturated Polyester Resin</a> page.
          Samrat Poly Resins' documentation confirms this generic commercial description corresponds to
          <a href="/en/products/gp-clear-resin/">GP Clear Resin</a> — see that page for the full technical data.
        </p>
        <p>
          The grades here are not interchangeable. Across this family the supplier publishes
          viscosities from under 350 cPs up to 1,100 cPs and gel times from 5 to 15 minutes — in
          practice the difference between a resin that wets glass out quickly and one bodied for
          casting and button work. Colour is also a stocking decision rather than a cosmetic one,
          since clear, white and yellow grades are listed separately. The table below places the
          published values side by side so you can see which grade your process actually needs.
        </p>
      </div>

      <StatusNotice
        title="Supplier documentation"
        message="Technical data sheets and safety data sheets are linked from each product page. Supplier technical data is attributed to the issuer and is not a Samrat FRP Traders certification."
      />

      <div class="category-grid" data-reveal style="--reveal-delay: 80ms">
        {items.map((product) => (
          <CatalogCard
            name={product.name}
            eyebrow={group.name}
            href={productHref(product, '/en')}
            showMedia
            image={product.images?.[0]}
            imageAlt={productImageAlt(product, false)}
            ctaLabel="View product"
          />
        ))}
      </div>

      <CategoryHubDetail groupSlug="polyester-resins" lang="en" />

      <div class="section-actions" data-reveal style="--reveal-delay: 160ms">
        <a class="button" href="/en/products/">View full catalogue</a>
        <a class="button" href="/en/documents/">Document library</a>
        <a class="button" href="/en/contact/">Send an enquiry</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Product-discovery priority: get real product photography in view
     quickly rather than running the full-height brand hero every other
     page uses. Scoped to this page only. */
  .page-hero {
    min-height: clamp(14rem, 26vh, 19rem);
  }

  .page-hero-content {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .section:first-of-type {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .category-intro {
    max-width: 46rem;
    margin-block: 1.25rem;
    color: var(--ink-dim);
  }

  .category-intro p {
    margin-bottom: 0;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
    margin-top: 1.75rem;
  }
</style>
