---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import CategoryHubDetail from '../../../components/product/CategoryHubDetail.astro';
import StatusNotice from '../../../components/StatusNotice.astro';
import { getGroup, productHref, productsInGroup } from '../../../data/products.js';
import { productImageAlt } from '../../../utils/product-page.js';
import Base from '../../../layouts/Base.astro';

const group = getGroup('gelcoat');
const items = productsInGroup('gelcoat');
---
<Base
  title="Gelcoat — Supplier in Nepal"
  description="Gelcoat products supplied and imported by Samrat FRP Traders for buyers across Nepal — the moulded surface layer of an FRP part, in general-purpose and isophthalic routes."
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">Product category</p>
      <h1>{group.name}</h1>
      <p class="page-lead">{group.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/en/' },
          { label: 'Products', href: '/en/products/' },
          { label: group.name },
        ]}
      />

      <div class="category-intro" data-reveal>
        <p>
          A gelcoat goes into the mould first, against the mould face, before any glass or laminating resin.
          When the part is released it is the face the customer sees, cleans and weathers. Everything structural
          sits behind it. That ordering is what separates this category from the laminating resins: nothing here
          carries load, and a thicker gelcoat does not make a stronger part.
        </p>
        <p>
          Two routes sit in this family and the difference is the acid in the backbone. GP Gelcoat Resin is the
          general-purpose orthophthalic route, and its supplier Technical Data Sheet and Safety Data Sheet are on
          file. ISO Gelcoat is the isophthalic route, which the industry specifies where a surface has to hold its
          gloss outdoors or stay sound in permanently wet service. Its supplier documentation is not yet in our
          library, so no figures for that grade are published anywhere on this site.
        </p>
        <p>
          The two are indistinguishable once pigmented and cured, so where a customer requires the isophthalic
          route it is carried by documentation and traceability rather than by inspection. Samrat FRP Traders
          supplies and imports both for the Nepal market as a trader, supplier, importer and reseller.
        </p>
      </div>

      <StatusNotice
        title="Supplier documentation"
        message="Technical data sheets and safety data sheets are linked from each product page. Supplier technical data is attributed to the issuer and is not a Samrat FRP Traders certification."
      />

      <div class="category-grid" data-reveal style="--reveal-delay: 80ms">
        {items.map((product) => (
          <CatalogCard
            name={product.name}
            eyebrow={group.name}
            href={productHref(product, '/en')}
            showMedia
            image={product.images?.[0]}
            imageAlt={productImageAlt(product, false)}
            ctaLabel="View product"
          />
        ))}
      </div>

      <CategoryHubDetail groupSlug="gelcoat" lang="en" />

      <div class="section-actions" data-reveal style="--reveal-delay: 160ms">
        <a class="button" href="/en/resources/what-is-gelcoat/">What is a gelcoat?</a>
        <a class="button" href="/en/products/">View full catalogue</a>
        <a class="button" href="/en/contact/">Send an enquiry</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Product-discovery priority: get real product photography in view
     quickly rather than running the full-height brand hero every other
     page uses. Scoped to this page only. */
  .page-hero {
    min-height: clamp(14rem, 26vh, 19rem);
  }

  .page-hero-content {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .section:first-of-type {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .category-intro {
    max-width: 46rem;
    margin-block: 1.25rem;
    color: var(--ink-dim);
  }

  .category-intro p {
    margin-bottom: 0;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
    margin-top: 1.75rem;
  }
</style>
