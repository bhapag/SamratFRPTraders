---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import StatusNotice from '../../../components/StatusNotice.astro';
import { getGroup, productHref, productsInGroup } from '../../../data/products.js';
import { productImageAlt } from '../../../utils/product-page.js';
import Base from '../../../layouts/Base.astro';

const group = getGroup('sheet-grade-resins');
const items = productsInGroup('sheet-grade-resins');
---
<Base
  title="Sheet Grade Resins — Supplier & Importer in Nepal"
  description="Sheet grade and roof light resin products supplied and imported by Samrat FRP Traders for panel and sheet fabrication across Nepal."
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">Product category</p>
      <h1>{group.name}</h1>
      <p class="page-lead">{group.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/en/' },
          { label: 'Products', href: '/en/products/' },
          { label: group.name },
        ]}
      />

      <div class="category-intro" data-reveal>
        <p>
          These grades are used where the finished item is a panel or sheet — roofing, light-transmitting
          sheet and similar profiles. That end use puts weight on properties a general-purpose resin is not
          selected for: behaviour across a large continuous surface, appearance and light transmission where
          the sheet is meant to be translucent, and durability under prolonged outdoor exposure.
        </p>
        <p>
          Because sheet work is usually produced in runs rather than one-offs, batch consistency is worth
          raising directly in an enquiry. State the profile, the process and whether the sheet is structural
          or light-transmitting, as those change which grade is appropriate.
        </p>
      </div>

      <StatusNotice
        title="Supplier documentation"
        message="Technical data sheets and safety data sheets are linked from each product page. Supplier technical data is attributed to the issuer and is not a Samrat FRP Traders certification."
      />

      <div class="category-grid" data-reveal style="--reveal-delay: 80ms">
        {items.map((product) => (
          <CatalogCard
            name={product.name}
            eyebrow={group.name}
            href={productHref(product, '/en')}
            showMedia
            image={product.images?.[0]}
            imageAlt={productImageAlt(product, false)}
            ctaLabel="View product"
          />
        ))}
      </div>

      <div class="section-actions" data-reveal style="--reveal-delay: 160ms">
        <a class="button" href="/en/products/">View full catalogue</a>
        <a class="button" href="/en/contact/">Send an enquiry</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    min-height: clamp(14rem, 26vh, 19rem);
  }

  .page-hero-content {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .section:first-of-type {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .category-intro {
    max-width: 46rem;
    margin-block: 1.25rem;
    color: var(--ink-dim);
  }

  .category-intro p {
    margin-bottom: 0;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
    margin-top: 1.75rem;
  }
</style>
