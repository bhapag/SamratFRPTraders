---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import CategoryHubDetail from '../../../components/product/CategoryHubDetail.astro';
import StatusNotice from '../../../components/StatusNotice.astro';
import { getGroup, productHref, productsInGroup } from '../../../data/products.js';
import { productImageAlt } from '../../../utils/product-page.js';
import Base from '../../../layouts/Base.astro';

const group = getGroup('epoxy-casting-resins');
const items = productsInGroup('epoxy-casting-resins');
---
<Base
  title="Epoxy & Casting Resins — Supplier in Nepal"
  description="Explore epoxy and casting resin products supplied and imported by Samrat FRP Traders for buyers across Nepal."
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">Product category</p>
      <h1>{group.name}</h1>
      <p class="page-lead">{group.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/en/' },
          { label: 'Products', href: '/en/products/' },
          { label: group.name },
        ]}
      />

      <div class="category-intro" data-reveal>
        <p>
          The Epoxy &amp; Casting Resins category groups epoxy resin systems, UV-curing resin and hardener components.
          Samrat FRP Traders supplies and imports these products for buyers across Nepal. Products in this category have
          distinct chemistries and are documented individually — properties are not shared across products, and
          resin/hardener pairing should be confirmed per product.
        </p>
        <p>
          Two resins and one curing agent sit in this family, and the pairing matters more than
          the label. Clear Casting Resin and Epoxy Art Resin are both mixed with a hardener and
          cure over hours — for Clear Casting Resin the supplier publishes 24 hours to initial cure
          and 72 hours to full cure at 25 °C, reaching Shore D 82 with under 0.2% shrinkage. The
          two grades differ in what they are published for: casting depth against self-levelling
          surface work.
        </p>
        <p>
          The Epoxy Hardener listed here is a polyamide, amine-based curing agent. The supplier
          documentation asks that the resin and hardener pairing be confirmed before ordering
          rather than assumed, so name the resin you intend to pair it with when you enquire —
          that is the one detail that most often decides whether an order is correct.
        </p>
      </div>

      <StatusNotice
        title="Supplier documentation"
        message="Technical data sheets and safety data sheets are linked from each product page. Supplier technical data is attributed to the issuer and is not a Samrat FRP Traders certification."
      />

      <div class="category-grid" data-reveal style="--reveal-delay: 80ms">
        {items.map((product) => (
          <CatalogCard
            name={product.name}
            eyebrow={group.name}
            href={productHref(product, '/en')}
            showMedia
            image={product.images?.[0]}
            imageAlt={productImageAlt(product, false)}
            ctaLabel="View product"
          />
        ))}
      </div>

      <CategoryHubDetail groupSlug="epoxy-casting-resins" lang="en" />

      <div class="section-actions" data-reveal style="--reveal-delay: 160ms">
        <a class="button" href="/en/products/">View full catalogue</a>
        <a class="button" href="/en/documents/">TDS &amp; SDS library</a>
        <a class="button" href="/en/contact/">Send an enquiry</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Product-discovery priority: get real product photography in view
     quickly rather than running the full-height brand hero every other
     page uses. Scoped to this page only. */
  .page-hero {
    min-height: clamp(14rem, 26vh, 19rem);
  }

  .page-hero-content {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .section:first-of-type {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .category-intro {
    max-width: 46rem;
    margin-block: 1.25rem;
    color: var(--ink-dim);
  }

  .category-intro p {
    margin-bottom: 0;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
    margin-top: 1.75rem;
  }
</style>
