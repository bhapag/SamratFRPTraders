---
import CatalogCard from '../../components/CatalogCard.astro';
import ResourceIcon from '../../components/ResourceIcon.astro';
import BusinessDetails from '../../components/home/BusinessDetails.astro';
import CoverageNepal from '../../components/home/CoverageNepal.astro';
import HeroBackground from '../../components/home/HeroBackground.astro';
import SupplyVideo from '../../components/home/SupplyVideo.astro';
import WhyChoose from '../../components/home/WhyChoose.astro';
import { applications } from '../../data/applications.js';
import { catalogGroups, getGroup, productHref, products } from '../../data/products.js';
import { resources } from '../../data/resources.js';
import { productImageAlt } from '../../utils/product-page.js';
import { buildWhatsAppLink, whatsAppMessages } from '../../data/site.js';
import Base from '../../layouts/Base.astro';

const indexableCategories = catalogGroups.filter((group) => group.indexable);
const featuredProducts = products.filter((product) => product.tier === 'A');
const groupName = (slug) => getGroup(slug)?.name;
const featuredApplications = applications.slice(0, 6);
const featuredResources = resources.slice(0, 3);
---
<Base
  title="FRP Materials Supplier & Importer in Nepal"
  description="Samrat FRP Traders supplies and imports FRP materials and industrial resins across Nepal — polyester resins, gelcoat, glass fiber mat, hardeners and more, with supplier technical documentation."
>
  <section class="hero">
    <HeroBackground />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow">Trusted FRP &amp; Industrial Material Supplier</p>
      <h1 class="hero-title">
        Polyester, Epoxy &amp; Composite Materials
        <span class="hl" data-text="Supplier Across Nepal">Supplier Across Nepal</span>
      </h1>
      <p class="hero-tagline">
        Quality <strong>materials</strong>. Reliable <strong>supply</strong>.
      </p>
      <p class="hero-sub">
        Samrat FRP Traders supplies FRP materials, polyester resins, epoxy systems, gelcoats,
        glass fiber and related industrial materials across Nepal.
      </p>
      <div class="hero-trust">
        <span class="hero-trust-item">
          <span class="hero-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 L20 6 L20 12 C20 17 16.5 20.5 12 22 C7.5 20.5 4 17 4 12 L4 6 Z" /><path d="M8.5 12 L11 14.5 L15.5 9.5" /></svg></span>
          Trader · Supplier
        </span>
        <span class="hero-trust-item">
          <span class="hero-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><line x1="3" y1="10" x2="21" y2="10" /><line x1="8" y1="3" x2="8" y2="7" /><line x1="16" y1="3" x2="16" y2="7" /></svg></span>
          Importer · Reseller
        </span>
        <span class="hero-trust-item">
          <span class="hero-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22 C12 22 19 15 19 9.5 A7 7 0 0 0 5 9.5 C5 15 12 22 12 22 Z" /><circle cx="12" cy="9.5" r="2.4" /></svg></span>
          All Nepal
        </span>
        <span class="hero-trust-item">
          <span class="hero-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 H14 L18 6 V22 H6 Z" /><path d="M14 2 V6 H18" /><path d="M9 13 L11.5 15.5 L16 10.5" /></svg></span>
          TDS &amp; SDS available
        </span>
      </div>
      <div class="hero-cta">
        <a class="button button-primary" href="/en/products/">View Products</a>
        <a class="button" href="/en/contact/">Contact Us</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading section-heading-split" data-reveal>
        <div>
          <p class="eyebrow">Product families</p>
          <h2>Resins and FRP materials</h2>
        </div>
        <p class="section-lead">
          A {products.length}-product catalogue of FRP materials supplied and imported for the Nepal market — every product page
          carries supplier-attributed technical data and TDS/SDS links.
        </p>
      </div>

      <div class="catalogue-categories" data-reveal>
        {indexableCategories.map((group) => (
          <CatalogCard
            name={group.name}
            eyebrow="Product category"
            href={`/en/products/${group.slug}/`}
            description={group.summary}
          />
        ))}
      </div>

      <div class="featured-heading" data-reveal>
        <p class="eyebrow">Featured products</p>
      </div>
      <div class="catalogue-grid" data-reveal>
        {featuredProducts.map((product) => (
          <CatalogCard
            name={product.name}
            eyebrow={groupName(product.group)}
            href={productHref(product, '/en')}
            showMedia
            image={product.images?.[0]}
            imageAlt={productImageAlt(product, false)}
            ctaLabel="View product"
          />
        ))}
      </div>

      <div class="section-actions" data-reveal>
        <a class="button button-primary" href="/en/products/">View full product catalogue</a>
        <a
          class="button"
          href="/downloads/samrat-frp-traders-product-catalogue.pdf"
          target="_blank"
          rel="noopener"
          download
        >
          Product catalogue (PDF)
        </a>
      </div>
    </div>
  </section>

  <section class="section section-framed">
    <div class="container">
      <div class="section-heading section-heading-split" data-reveal>
        <div>
          <p class="eyebrow">Applications</p>
          <h2>Where FRP materials are used</h2>
        </div>
        <p class="section-lead">
          Application guides covering the product portfolio — water tanks, roofing sheets, boats, panels,
          casting and industrial fabrication.
        </p>
      </div>

      <div class="app-gallery" data-reveal>
        {featuredApplications.map((app, i) => (
          <a class:list={['apps-tile', { 'apps-tile-lead': i === 0 }]} href={`/en/applications/${app.slug}/`}>
            <img
              src={`/images/applications/${app.cardImage}`}
              alt={app.cardImageAlt}
              loading="lazy"
              width="700"
              height="466"
            />
            <span class="apps-tile-scrim" aria-hidden="true"></span>
            <span class="apps-tile-body">
              <span class="apps-tile-title">{app.title}</span>
              <span class="apps-tile-desc">{app.cardDescription}</span>
            </span>
          </a>
        ))}
      </div>

      <div class="section-actions" data-reveal>
        <a class="button" href="/en/applications/">Browse all applications</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container supplier-band" data-reveal>
      <div class="supplier-media">
        <img
          src="/images/supplier/supplier-production.jpg"
          alt="Supplier production infrastructure — Samrat Poly Resins reference photography"
          loading="lazy"
          width="700"
          height="466"
        />
      </div>
      <div class="supplier-copy">
        <p class="eyebrow">Trusted supply relationship</p>
        <h2>Source-backed supply for Nepal.</h2>
        <p>
          Samrat FRP Traders is a trader, supplier, importer and reseller serving all of Nepal.
          Samrat Poly Resins, India is a trusted supplier to Samrat FRP Traders for resins and related FRP materials.
          Supplier reference media is attributed to Samrat Poly Resins and does not represent Samrat FRP Traders facilities.
        </p>
        <div class="supplier-stats">
          <div><strong>24</strong><span>products</span></div>
          <div><strong>48</strong><span>TDS &amp; SDS links</span></div>
          <div><strong>37</strong><span>application guides</span></div>
        </div>
        <a class="button button-primary" href="/en/about/">About Samrat FRP Traders</a>
      </div>
    </div>
  </section>

  <SupplyVideo lang="en" />

  <WhyChoose lang="en" />

  <CoverageNepal lang="en" />

  <BusinessDetails lang="en" />

  <section class="section ledger">
    <div class="container">
      <div class="section-heading section-heading-split" data-reveal>
        <div>
          <p class="eyebrow">Knowledge centre</p>
          <h2>Buyer resources</h2>
        </div>
        <p class="section-lead">
          Selection guides, comparisons and technical explainers from the resource library.
        </p>
      </div>

      <div class="resource-strip" data-reveal>
        {featuredResources.map((resource) => (
          <a class="doc-row" href={`/en/resources/${resource.slug}/`}>
            <span class="doc-row-icon" aria-hidden="true"><ResourceIcon name={resource.icon} /></span>
            <span class="doc-row-main">
              <span class="doc-row-title">{resource.title}</span>
              <span class="doc-row-desc">{resource.description}</span>
            </span>
            <span class="doc-row-time">{resource.readingTime}</span>
            <span class="doc-row-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>

      <div class="section-actions" data-reveal>
        <a class="button" href="/en/resources/">Open the knowledge centre</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-band" data-reveal>
      <div>
        <p class="eyebrow">Enquiries</p>
        <h2>Looking for FRP materials in Nepal?</h2>
        <p>
          Price on request. Browse the product catalogue with TDS/SDS documentation, then send your
          requirement via WhatsApp, phone or email.
        </p>
      </div>
      <div class="cta-actions">
        <a
          class="button button-primary"
          href={buildWhatsAppLink(whatsAppMessages.en)}
          target="_blank"
          rel="noopener"
        >
          Ask on WhatsApp
        </a>
        <a class="button" href="/en/products/">Browse products</a>
        <a class="button" href="tel:+9779805526904">+977 9805526904</a>
        <a class="button" href="mailto:samratfrptraders@gmail.com">Email</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Homepage-only section rhythm: tighter than the site-wide default so
     consecutive sections read as a deliberate cadence rather than a
     uniform void between every block. Scoped to this page by Astro's CSS
     scoping — does not affect product/resource/application pages, which
     keep the shared foundation.css default. */
  .section {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .catalogue-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: 1rem;
  }

  /* Category identity: a restrained left-edge accent bar whose opacity
     cycles by position, using the single gold accent rather than a
     distinct color per category. Presentation-only — no product-data
     field is introduced for this. */
  .catalogue-categories :global(.catalog-card) {
    border-left-width: 0.2rem;
    border-left-style: solid;
  }

  .catalogue-categories :global(.catalog-card:nth-of-type(8n+1)) { border-left-color: rgba(var(--gold-rgb), 0.85); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+2)) { border-left-color: rgba(var(--gold-rgb), 0.72); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+3)) { border-left-color: rgba(var(--gold-rgb), 0.6); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+4)) { border-left-color: rgba(var(--gold-rgb), 0.48); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+5)) { border-left-color: rgba(var(--gold-rgb), 0.6); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+6)) { border-left-color: rgba(var(--gold-rgb), 0.72); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+7)) { border-left-color: rgba(var(--gold-rgb), 0.85); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+8)) { border-left-color: rgba(var(--gold-rgb), 0.36); }

  .featured-heading {
    margin: 2.5rem 0 1.1rem;
  }

  .catalogue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
  }

  /* Same image-led poster language as the Applications index (src/pages/
     applications/index.astro) — a homepage preview of Applications should
     look like Applications, not a third flat-card pattern. */
  .app-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: 0.9rem;
  }

  .apps-tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-3);
    color: var(--ink);
    text-decoration: none;
  }

  .apps-tile-lead {
    grid-column: span 2;
  }

  .apps-tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 550ms var(--ease-premium);
  }

  .apps-tile:hover img,
  .apps-tile:focus-visible img {
    transform: scale(1.045);
  }

  .apps-tile-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 10, 14, 0) 38%, rgba(8, 10, 14, 0.92) 100%);
    transition: opacity 300ms var(--ease-premium);
  }

  .apps-tile:hover .apps-tile-scrim,
  .apps-tile:focus-visible .apps-tile-scrim {
    opacity: 0.88;
  }

  .apps-tile-body {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 1.2rem 1.2rem;
  }

  .apps-tile-title {
    max-width: 30ch;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  .apps-tile-lead .apps-tile-title {
    max-width: 34ch;
    font-size: clamp(1.2rem, 2.1vw, 1.6rem);
  }

  .apps-tile-desc {
    display: -webkit-box;
    overflow: hidden;
    max-width: 36ch;
    color: rgba(244, 242, 238, 0.82);
    font-size: 0.8rem;
    line-height: 1.4;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.45);
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .apps-tile-lead .apps-tile-desc {
    max-width: 42ch;
    font-size: 0.86rem;
    -webkit-line-clamp: 3;
  }

  .apps-tile:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
  }

  @media (max-width: 60rem) {
    .app-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 36rem) {
    .app-gallery {
      grid-template-columns: 1fr;
    }

    .apps-tile-lead {
      grid-column: span 1;
    }

    .apps-tile {
      aspect-ratio: 3 / 2;
    }
  }

  .supplier-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
  }

  .supplier-media img {
    width: 100%;
    display: block;
    border: 1px solid var(--line-2);
    box-shadow: var(--surface-shadow-rest);
  }

  .supplier-copy h2 {
    max-width: 15ch;
    margin-top: 0.7rem;
  }

  .supplier-copy p {
    color: var(--ink-dim);
  }

  .supplier-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
    margin: 1.75rem 0;
  }

  .supplier-stats div {
    display: grid;
  }

  .supplier-stats strong {
    color: var(--accent-gold-light);
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 700;
    line-height: 1;
  }

  .supplier-stats span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Same document-row language as the Resources index (src/pages/resources/
     index.astro) — a homepage preview of the library should read as the
     library, not as a third card-grid pattern. Colors come entirely from
     the semantic tokens the Ledger wrapper already retints, so no light/
     dark variants are needed here. */
  .resource-strip {
    display: flex;
    flex-direction: column;
  }

  .doc-row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.1rem;
    padding: 1.1rem 0.9rem;
    padding-left: 1.15rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: background 200ms var(--ease-premium);
  }

  .resource-strip .doc-row:first-child {
    border-top: 1px solid var(--line);
  }

  .doc-row::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0.2rem;
    background: transparent;
    transition: background 200ms var(--ease-premium);
  }

  .doc-row:hover,
  .doc-row:focus-visible {
    background: rgba(var(--gold-rgb), 0.045);
  }

  .doc-row:hover::before,
  .doc-row:focus-visible::before {
    background: var(--accent-gold);
  }

  .doc-row:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: -2px;
  }

  .doc-row-icon {
    display: flex;
    color: var(--accent-gold);
    opacity: 0.85;
  }

  .doc-row-icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .doc-row-main {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .doc-row-title {
    font-size: 0.98rem;
    font-weight: 600;
  }

  .doc-row-desc {
    overflow: hidden;
    max-width: 60ch;
    color: var(--ink-faint);
    font-size: 0.82rem;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .doc-row-time {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .doc-row-arrow {
    color: var(--accent-gold);
    font-size: 1rem;
    transition: transform 200ms var(--ease-premium);
  }

  .doc-row:hover .doc-row-arrow,
  .doc-row:focus-visible .doc-row-arrow {
    transform: translateX(0.25rem);
  }

  @media (max-width: 40rem) {
    .doc-row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      row-gap: 0.3rem;
    }

    .doc-row-time {
      grid-column: 2;
      grid-row: 2;
    }

    .doc-row-desc {
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
  }

  @media (max-width: 53.75rem) {
    .supplier-band {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .section {
      padding-block: 3rem;
    }

    .section-heading-split {
      gap: 0.85rem;
    }

    .catalogue-categories,
    .catalogue-grid {
      gap: 0.85rem;
    }

    .featured-heading {
      margin: 2rem 0 0.9rem;
    }

    .app-gallery {
      gap: 0.75rem;
    }

    .supplier-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.65rem;
      margin: 1.3rem 0;
    }

    .supplier-stats div {
      gap: 0.25rem;
      padding: 0.75rem 0.65rem;
      border: 1px solid var(--line);
      background: var(--bg-3);
    }

    .supplier-stats strong {
      font-size: 1.7rem;
    }

    .supplier-stats span {
      font-size: 0.55rem;
      letter-spacing: 0.06em;
    }
  }
</style>
