---
import Base from '../../layouts/Base.astro';
---
<Base title="Page not found" description="The requested page could not be found." noindex canonical={false}>
  <section class="page-hero hero-shell page-hero-centered">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container narrow page-hero-content">
      <p class="eyebrow">404</p>
      <h1>Page <span class="metal-text">not found.</span></h1>
      <p>This page may have moved, or the address may be incorrect. You can browse the product catalogue, review material applications, or contact us with your requirement.</p>
      <div class="section-actions">
        <a class="button button-primary" href="/en/products/">View products</a>
        <a class="button" href="/en/applications/">Applications</a>
        <a class="button" href="/en/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Base>
