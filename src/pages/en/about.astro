---
import BusinessDetails from '../../components/home/BusinessDetails.astro';
import { buildWhatsAppLink, whatsAppMessages } from '../../data/site.js';
import { catalogGroups, products } from '../../data/products.js';
import { applications } from '../../data/applications.js';
import { resources } from '../../data/resources.js';
import Base from '../../layouts/Base.astro';

const applicationCount = applications.filter((a) => !a.draft).length;
const resourceCount = resources.filter((r) => !r.draft).length;
const docCount = products.reduce((sum, p) => sum + (p.documents ? p.documents.length : 0), 0);
---
<Base
  title="About — Biratnagar, Nepal"
  description="Samrat FRP Traders is a trader, supplier, importer and reseller based in Biratnagar, Nepal — supplying FRP materials and industrial resins across all of Nepal."
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">About</p>
      <h1>From Biratnagar, <span class="metal-text">across Nepal.</span></h1>
      <p class="page-lead">
        Samrat FRP Traders is a trader, supplier, importer and reseller of FRP materials and
        industrial resins for buyers across Nepal.
      </p>
    </div>
  </section>

  <div class="container">
    <div class="about-stats" data-reveal>
      <div class="stat">
        <span class="stat-num">{products.length}</span>
        <span class="stat-label">Products</span>
      </div>
      <div class="stat">
        <span class="stat-num">{catalogGroups.length}</span>
        <span class="stat-label">Categories</span>
      </div>
      <div class="stat">
        <span class="stat-num">{applicationCount}</span>
        <span class="stat-label">Application guides</span>
      </div>
      <div class="stat">
        <span class="stat-num">{resourceCount}</span>
        <span class="stat-label">Technical resources</span>
      </div>
      <div class="stat">
        <span class="stat-num">{docCount}</span>
        <span class="stat-label">TDS / SDS documents</span>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container about-layout">
      <div class="copy-stack" data-reveal>
        <div class="section-heading">
          <p class="eyebrow">Business role</p>
          <h2>Trader · Supplier · Importer · Reseller.</h2>
        </div>

        <p>
          Samrat FRP Traders (registered as M/s SAMRAT F.R.P TRADERS) is a Biratnagar, Nepal-based
          business supplying and importing polyester resins, gelcoats, glass fiber, hardeners, epoxy
          systems and related FRP materials for buyers across Nepal — with supplier-issued TDS and SDS
          documentation for every product.
        </p>
        <p>
          Samrat Poly Resins, India is a trusted supplier to Samrat FRP Traders for resins and related
          FRP materials. Supplier reference media (photos/videos) is attributed to Samrat Poly Resins
          and does not represent Samrat FRP Traders facilities.
        </p>
        <p>
          We present a {products.length}-product catalogue, {applicationCount} application guides and {resourceCount} technical
          resources in both Nepali and English, so buyers across Nepal can select the right material
          with the right documentation.
        </p>

        <div class="button-row">
          <a class="button button-primary" href="/en/products/">Browse product catalogue</a>
          <a
            class="button"
            href="/downloads/samrat-frp-traders-product-catalogue.pdf"
            target="_blank"
            rel="noopener"
            download
          >
            Product catalogue (PDF)
          </a>
          <a
            class="button"
            href={buildWhatsAppLink(whatsAppMessages.generic.en)}
            target="_blank"
            rel="noopener"
          >
            Ask on WhatsApp
          </a>
        </div>
      </div>

      <aside class="info-rail" aria-label="Business details" data-reveal style="--reveal-delay: 120ms">
        <div class="info-row">
          <span>Business name</span>
          <strong>Samrat FRP Traders</strong>
        </div>
        <div class="info-row">
          <span>Base location</span>
          <strong>Biratnagar, Nepal</strong>
        </div>
        <div class="info-row">
          <span>Market</span>
          <strong>All Nepal</strong>
        </div>
        <div class="info-row">
          <span>Supplier relationship</span>
          <strong>Samrat Poly Resins, India</strong>
        </div>
        <div class="info-row">
          <span>Languages</span>
          <strong>Nepali + English</strong>
        </div>
        <div class="info-row">
          <span>Pricing policy</span>
          <strong>Price on request</strong>
        </div>
      </aside>
    </div>
  </section>

  <BusinessDetails lang="en" />

  <section class="section section-framed">
    <div class="container">
      <div class="section-heading section-heading-split" data-reveal>
        <div>
          <p class="eyebrow">Our approach</p>
          <h2>Supply with the paperwork.</h2>
        </div>
        <p class="section-lead">
          Supplier-issued technical documentation with every product — so buyers know exactly what they are buying.
        </p>
      </div>
      <div class="approach-grid">
        <article data-reveal>
          <span>01</span>
          <h3>Confirmed facts only</h3>
          <p>Product descriptions and technical values come from supplier documentation; unverified commercial terms are not published.</p>
        </article>
        <article data-reveal style="--reveal-delay: 70ms">
          <span>02</span>
          <h3>TDS &amp; SDS included</h3>
          <p>Direct access to the Technical Data Sheet and Safety Data Sheet for every product.</p>
        </article>
        <article data-reveal style="--reveal-delay: 140ms">
          <span>03</span>
          <h3>Direct enquiry</h3>
          <p>WhatsApp, phone and email enquiries — price on request.</p>
        </article>
        <article data-reveal style="--reveal-delay: 210ms">
          <span>04</span>
          <h3>Bilingual information</h3>
          <p>Product and technical information available in Nepali and English.</p>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Real, build-time-computed counts as a dense data band — the "prove it
     with numbers" opener DESIGN.md calls for, never hand-typed so it can't
     go stale the way the old hardcoded prose count did. */
  .about-stats {
    display: flex;
    flex-wrap: wrap;
    margin-block: clamp(-1rem, -2vw, -0.5rem) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .stat {
    flex: 1 1 8rem;
    padding: 1.6rem 1.5rem;
    border-left: 1px solid var(--line);
  }

  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .stat-num {
    display: block;
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .stat-label {
    display: block;
    margin-top: 0.5rem;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 40rem) {
    .stat {
      flex: 1 1 45%;
      border-left: 0;
      padding-left: 0;
      padding-block: 1.2rem;
    }

    .stat:nth-child(odd) {
      padding-right: 1rem;
    }

    .stat:nth-child(even) {
      padding-left: 1rem;
      border-left: 1px solid var(--line);
    }
  }

  .about-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.8fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }

  .copy-stack > p {
    max-width: 46rem;
    color: var(--ink-dim);
    font-size: 1rem;
    line-height: 1.75;
  }

  .info-rail {
    border: 1px solid var(--line);
    background: var(--bg-2);
    box-shadow: var(--surface-shadow-rest);
  }

  .info-row {
    display: grid;
    gap: 0.35rem;
    padding: 1.2rem 1.3rem;
    border-bottom: 1px solid var(--line);
    transition: background 200ms var(--ease-premium);
  }

  .info-row:hover {
    background: rgba(var(--gold-rgb), 0.04);
  }

  .info-row:last-child {
    border-bottom: 0;
  }

  .info-row span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .info-row strong {
    color: var(--ink);
    font-size: 0.94rem;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .approach-grid article {
    min-height: 13rem;
    padding: 1.4rem;
    background: var(--bg-3);
  }

  .approach-grid span {
    color: var(--accent-gold);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .approach-grid h3 {
    margin-block: 2.4rem 0.65rem;
  }

  .approach-grid p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 0.86rem;
  }

  @media (max-width: 53.75rem) {
    .approach-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 48rem) {
    .about-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32rem) {
    .approach-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
