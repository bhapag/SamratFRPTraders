---
import ResourceCard from '../../../components/ResourceCard.astro';
import { resources } from '../../../data/resources.js';
import Base from '../../../layouts/Base.astro';
import { clusterByProduct, foundationResources } from '../../../utils/resource-hub.js';

const published = resources.filter((r) => !r.draft);
const featured = foundationResources(published);
const featuredSlugs = new Set(featured.map((r) => r.slug));

const { clusters, ungrouped } = clusterByProduct(published);
const nonFeaturedClusters = clusters
  .map((cluster) => ({ ...cluster, resources: cluster.resources.filter((r) => !featuredSlugs.has(r.slug)) }))
  .filter((cluster) => cluster.resources.length > 0);
const nonFeaturedUngrouped = ungrouped.filter((r) => !featuredSlugs.has(r.slug));
---
<Base
  title="Resources & Knowledge Centre"
  description="Buyer resources for FRP materials in Nepal — selection guides, comparisons, procurement checklists and technical explainers from the Samrat FRP Traders knowledge centre."
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">Knowledge centre</p>
      <h1>Resources for <span class="metal-text">Nepal buyers.</span></h1>
      <p class="page-lead">
        Selection guides, comparisons, procurement checklists and technical explainers — {published.length} guides, organized by product.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="kc-downloads" data-reveal>
        <div>
          <h2 class="kc-downloads-title">Samrat FRP Traders Product Catalogue</h2>
          <p class="kc-downloads-desc">Explore our complete FRP materials and resin range.</p>
          <p class="kc-downloads-meta">PDF</p>
        </div>
        <a
          class="button button-primary"
          href="/downloads/samrat-frp-traders-product-catalogue.pdf"
          target="_blank"
          rel="noopener"
          download
          aria-label="Download Samrat FRP Traders Product Catalogue (PDF)"
        >
          Download Product Catalogue
        </a>
      </div>

      <nav class="jump-nav" aria-label="Browse by product">
        <a href="#featured">Featured guides</a>
        {nonFeaturedClusters.map((cluster) => (
          <a href={`#cluster-${cluster.productSlug}`}>{cluster.productName}</a>
        ))}
        {nonFeaturedUngrouped.length > 0 && <a href="#general">General guides</a>}
      </nav>

      <div class="resource-group" id="featured" data-reveal>
        <h2 class="group-title">Featured guides</h2>
        <p class="group-lead">Start here — the foundation guide for each product.</p>
        <div class="resource-grid">
          {featured.map((resource) => (
            <ResourceCard
              href={`/en/resources/${resource.slug}/`}
              title={resource.title}
              description={resource.description}
              readingTime={resource.readingTime}
              icon={resource.icon}
            />
          ))}
        </div>
      </div>

      {nonFeaturedClusters.map((cluster) => (
        <div class="resource-group" id={`cluster-${cluster.productSlug}`} data-reveal>
          <h2 class="group-title">
            {cluster.productName}
            {cluster.productSlug && (
              <a class="group-title-link" href={`/en/products/${cluster.productSlug}/`}>View product page →</a>
            )}
          </h2>
          <div class="resource-grid">
            {cluster.resources.map((resource) => (
              <ResourceCard
                href={`/en/resources/${resource.slug}/`}
                title={resource.title}
                description={resource.description}
                readingTime={resource.readingTime}
                icon={resource.icon}
              />
            ))}
          </div>
        </div>
      ))}

      {nonFeaturedUngrouped.length > 0 && (
        <div class="resource-group" id="general" data-reveal>
          <h2 class="group-title">General guides</h2>
          <div class="resource-grid">
            {nonFeaturedUngrouped.map((resource) => (
              <ResourceCard
                href={`/en/resources/${resource.slug}/`}
                title={resource.title}
                description={resource.description}
                readingTime={resource.readingTime}
                icon={resource.icon}
              />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .kc-downloads {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
    padding: 1.3rem 1.5rem;
    border: 1px solid rgba(var(--gold-rgb), 0.4);
    border-left-width: 0.26rem;
    background: rgba(var(--gold-rgb), 0.05);
  }

  .kc-downloads-title {
    margin: 0;
    font-size: 1.15rem;
  }

  .kc-downloads-desc {
    margin: 0.3rem 0 0.25rem;
    color: var(--ink-dim);
    font-size: 0.88rem;
  }

  .kc-downloads-meta {
    margin: 0;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .jump-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .jump-nav a {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line);
    background: var(--bg-2);
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: border-color 180ms var(--ease-premium), color 180ms var(--ease-premium);
  }

  .jump-nav a:hover {
    border-color: var(--accent-gold);
    color: var(--accent-gold-light);
  }

  .resource-group {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
    scroll-margin-top: 5.5rem;
  }

  .group-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 0.4rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid rgba(var(--gold-rgb), 0.22);
    font-size: 1.5rem;
  }

  .group-title-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--accent-gold-light);
    text-decoration: none;
  }

  .group-title-link:hover {
    color: var(--accent-gold);
  }

  .group-lead {
    margin-bottom: 1.1rem;
    color: var(--ink-faint);
    font-size: 0.88rem;
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: 1.1rem;
  }
</style>
