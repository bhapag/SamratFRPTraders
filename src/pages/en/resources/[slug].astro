---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Callout from '../../../components/Callout.astro';
import DataTable from '../../../components/DataTable.astro';
import ReadingProgress from '../../../components/ReadingProgress.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import TechIcon from '../../../components/TechIcon.astro';
import { resources } from '../../../data/resources.js';
import { buildCanonicalUrl } from '../../../data/site.js';
import Base from '../../../layouts/Base.astro';
import { enHref, enHtml } from '../../../utils/lang.js';

export function getStaticPaths() {
  return resources
    .filter((resource) => !resource.draft)
    .map((resource) => ({ params: { slug: resource.slug }, props: { resource } }));
}

const { resource } = Astro.props;

const relatedResources = (resource.relatedSlugs ?? [])
  .map((slug) => resources.find((r) => r.slug === slug))
  .filter(Boolean);

const recommendedLinks = (resource.recommendedLinks ?? []).map((link) => ({
  ...link,
  href: enHref(link.href),
}));

const sections = (resource.sections ?? []).map((s, i) => ({ ...s, id: `section-${i + 1}` }));
const tocItems = sections.filter((s) => s.heading).map((s) => ({ id: s.id, label: s.heading }));
const isLongForm = sections.length >= 4;

const breadcrumbItems = [
  { label: 'Home', href: '/en/' },
  { label: 'Resources', href: '/en/resources/' },
  { label: resource.title },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: buildCanonicalUrl(item.href) } : {}),
  })),
};

const faqSchema =
  resource.faqs && resource.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: resource.faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.q,
          acceptedAnswer: { '@type': 'Answer', text: faq.a },
        })),
      }
    : null;
---
<Base title={resource.title} description={resource.description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: resource.title,
    description: resource.description,
    inLanguage: 'en',
    datePublished: resource.publishDate,
    publisher: { '@type': 'Organization', name: 'Samrat FRP Traders' },
  })} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {isLongForm && <ReadingProgress />}
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">{resource.category} · {resource.readingTime}</p>
      <h1>{resource.title}</h1>
      <p class="page-lead">{resource.description}</p>
    </div>
  </section>

  <section class="section ledger resource-doc-surface">
    <div class="container">
      <Breadcrumbs items={breadcrumbItems} />

      <div class:list={['article-body', { 'article-body-wide': isLongForm }]}>
        {isLongForm && (
          <aside class="article-side" data-reveal>
            {resource.quickFacts && Object.keys(resource.quickFacts).length > 0 && (
              <div class="quick-facts">
                <h2 class="block-title">Quick facts</h2>
                <dl>
                  {Object.entries(resource.quickFacts).map(([label, value]) => (
                    <div class="qf-row">
                      <dt>{label}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )}
            <TableOfContents items={tocItems} label="Table of Contents" />
          </aside>
        )}

        <article class="article" data-reveal>
          {!isLongForm && resource.quickFacts && Object.keys(resource.quickFacts).length > 0 && (
            <div class="quick-facts">
              <h2 class="block-title">Quick facts</h2>
              <dl>
                {Object.entries(resource.quickFacts).map(([label, value]) => (
                  <div class="qf-row">
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}

          {sections.map((section) => {
            const table = section.table ? resource[section.table] : null;
            return (
              <div class="block" id={section.id}>
                {section.heading && <h2 class="block-title">{section.heading}</h2>}
                {section.body?.map((paragraph) => <p set:html={enHtml(paragraph)} />)}

                {section.photo && (
                  <figure class="article-photo">
                    <img
                      src={`/images/supplier/${section.photo.src}`}
                      alt={section.photo.alt}
                      loading="lazy"
                      width="1200"
                      height="800"
                    />
                    {section.photo.caption && <figcaption>{section.photo.caption}</figcaption>}
                  </figure>
                )}

                {table && <DataTable headers={table.headers} rows={table.rows} note={table.note} />}

                {section.visuals?.map((visual) => (
                  visual.type === 'steps' ? (
                    <div class="process-block">
                      <ol class="process-list">
                        {visual.items.map((item, i) => (
                          <li class="process-step">
                            <span class="process-num">{String(i + 1).padStart(2, '0')}</span>
                            <span class="process-label">{item.label}</span>
                          </li>
                        ))}
                      </ol>
                      {visual.branchItems && (
                        <div class="process-branch">
                          <p class="process-branch-label">{visual.branchLabel}</p>
                          <div class="process-branch-chips">
                            {visual.branchItems.map((b) => <span class="process-chip">{b}</span>)}
                          </div>
                        </div>
                      )}
                      {visual.caption && <p class="diagram-caption">{visual.caption}</p>}
                    </div>
                  ) : visual.type === 'icongrid' ? (
                    <div class="diagram-block">
                      <div class="diagram-icongrid">
                        {visual.items.map((item) => (
                          <div class="diagram-icon-card">
                            <span class="diagram-icon" aria-hidden="true"><TechIcon name={item.icon} /></span>
                            <span class="diagram-icon-label">{item.label}</span>
                          </div>
                        ))}
                      </div>
                      {visual.caption && <p class="diagram-caption">{visual.caption}</p>}
                    </div>
                  ) : null
                ))}

                {section.subsections?.map((sub) => (
                  <div class="article-subsection">
                    <h3>{sub.heading}</h3>
                    <p set:html={enHtml(sub.body)} />
                  </div>
                ))}

                {section.visualsAfter?.map((visual) => (
                  visual.type === 'steps' ? (
                    <div class="process-block">
                      <ol class="process-list">
                        {visual.items.map((item, i) => (
                          <li class="process-step">
                            <span class="process-num">{String(i + 1).padStart(2, '0')}</span>
                            <span class="process-label">{item.label}</span>
                          </li>
                        ))}
                      </ol>
                      {visual.caption && <p class="diagram-caption">{visual.caption}</p>}
                    </div>
                  ) : visual.type === 'icongrid' ? (
                    <div class="diagram-block">
                      <div class="diagram-icongrid">
                        {visual.items.map((item) => (
                          <div class="diagram-icon-card">
                            <span class="diagram-icon" aria-hidden="true"><TechIcon name={item.icon} /></span>
                            <span class="diagram-icon-label">{item.label}</span>
                          </div>
                        ))}
                      </div>
                      {visual.caption && <p class="diagram-caption">{visual.caption}</p>}
                    </div>
                  ) : null
                ))}

                {section.callouts?.map((c) => (
                  <Callout label={c.label} variant={c.variant}>
                    {c.text && <p set:html={enHtml(c.text)} />}
                    {c.items && <ul>{c.items.map((item) => <li>{item}</li>)}</ul>}
                  </Callout>
                ))}
              </div>
            );
          })}

          {resource.propertiesTable && (
            <div class="block">
              <h2 class="block-title">Key properties</h2>
              <DataTable
                headers={resource.propertiesTable.headers}
                rows={resource.propertiesTable.rows}
                note={resource.propertiesTable.note}
              />
            </div>
          )}

          {resource.comparisonTable && (
            <div class="block">
              <h2 class="block-title">{resource.comparisonTable.title ?? 'Comparison'}</h2>
              <DataTable
                headers={resource.comparisonTable.headers}
                rows={resource.comparisonTable.rows}
                note={resource.comparisonTable.note}
              />
            </div>
          )}

          {resource.faqs?.length > 0 && (
            <div class="block">
              <h2 class="block-title">Frequently asked questions</h2>
              <div class="faq-list">
                {resource.faqs.map((faq) => (
                  <details class="faq-item">
                    <summary>{faq.q}</summary>
                    <p>{faq.a}</p>
                  </details>
                ))}
              </div>
            </div>
          )}
        </article>
      </div>

      <div class="article-foot" data-reveal>
        <p class="note">
          Technical information reflects published supplier documentation and general FRP guidance.
          Confirm exact product values against the current supplier TDS/SDS.
        </p>

        {recommendedLinks.length > 0 && (
          <div class="related">
            <p class="related-title">Related products</p>
            <div class="related-list">
              {recommendedLinks.map((link) => (
                <a href={link.href}>
                  <strong>{link.label}</strong>
                  <span>{link.description}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {relatedResources.length > 0 && (
          <div class="related">
            <p class="related-title">Related resources</p>
            <div class="related-list">
              {relatedResources.map((r) => (
                <a href={`/en/resources/${r.slug}/`}>
                  <strong>{r.title}</strong>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="section-actions">
          <a class="button button-primary" href="/en/products/">Browse the product catalogue</a>
          <a class="button" href="/en/contact/">Contact</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The resource article body is long-form reading — Ledger surface,
     tighter top padding since the breadcrumb sits right under the hero. */
  .resource-doc-surface {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .article-body {
    margin-top: 2rem;
  }

  .article-body-wide {
    display: grid;
    grid-template-columns: 17rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }

  .article-side {
    display: grid;
    gap: 1.4rem;
    position: sticky;
    top: 5.5rem;
  }

  .article {
    max-width: 52rem;
  }

  .article :global(p) {
    color: var(--ink-dim);
    font-size: 0.96rem;
    line-height: 1.75;
  }

  .article :global(a) {
    color: var(--accent-gold-light);
  }

  .block {
    margin-top: 2rem;
    scroll-margin-top: 5.5rem;
  }

  .block-title {
    margin-bottom: 0.9rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(var(--gold-rgb), 0.22);
    font-size: 1.35rem;
  }

  .quick-facts {
    padding: 1.2rem 1.3rem;
    border: 1px solid var(--line);
    background: var(--bg-2);
  }

  .quick-facts .block-title {
    font-size: 1rem;
    margin-bottom: 0.7rem;
  }

  .qf-row {
    display: grid;
    grid-template-columns: minmax(9rem, 14rem) 1fr;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
  }

  .article-body-wide .qf-row {
    grid-template-columns: 1fr;
    gap: 0.2rem;
  }

  .qf-row:last-child {
    border-bottom: 0;
  }

  .qf-row dt {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .qf-row dd {
    margin: 0;
    color: var(--ink);
    font-size: 0.9rem;
  }

  .article-photo {
    border: 1px solid var(--line-2);
    box-shadow: var(--surface-shadow-rest);
    overflow: hidden;
    margin-block: 1.6rem;
  }

  .article-photo img {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-photo figcaption {
    padding: 0.7rem 0.9rem;
    border-top: 1px solid var(--line);
    background: var(--bg-3);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .article-subsection {
    margin-top: 1.6rem;
  }

  .article-subsection h3 {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink);
  }

  .article-subsection p {
    margin-bottom: 0;
  }

  .process-block,
  .diagram-block {
    background: var(--bg-3);
    border: 1px solid var(--line);
    box-shadow: var(--surface-shadow-rest);
    padding: clamp(1.4rem, 4vw, 2rem);
    margin-block: 1.6rem;
  }

  .process-list {
    list-style: none;
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: 1.4rem;
    margin: 0;
    padding: 0;
  }

  .process-step {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.45rem;
    padding: 1.1rem 0.7rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-top: 2px solid var(--accent-gold);
  }

  .process-step:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -1.3rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent-gold);
    font-size: 1.1rem;
    line-height: 1;
  }

  .process-num {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--accent-gold-light);
  }

  .process-label {
    font-size: 0.9rem;
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .process-list {
      flex-direction: column;
      flex-wrap: wrap;
    }

    .process-step {
      flex: 1 1 auto;
    }

    .process-step:not(:last-child)::after {
      content: '↓';
      right: auto;
      left: 50%;
      top: auto;
      bottom: -1.1rem;
      transform: translateX(-50%);
    }
  }

  .process-branch {
    margin-top: 1.6rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--line);
  }

  .process-branch-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.8rem;
  }

  .process-branch-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .process-chip {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--accent-gold-dark);
    color: var(--accent-gold-light);
  }

  .diagram-icongrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.9rem;
  }

  .diagram-icon-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
    padding: 1.1rem 0.8rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-top: 2px solid var(--accent-gold);
    transition: transform 0.3s var(--ease-premium), box-shadow 0.3s var(--ease-premium);
  }

  .diagram-icon-card:hover {
    transform: translateY(-3px) scale(1.015);
    box-shadow: var(--surface-shadow-hover);
  }

  .diagram-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    color: var(--accent-gold);
  }

  .diagram-icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  .diagram-icon-label {
    font-size: 0.86rem;
    color: var(--ink);
  }

  .diagram-caption {
    text-align: center;
    margin-top: 1.3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--ink-faint);
    letter-spacing: 0.03em;
  }

  .faq-item {
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    cursor: pointer;
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .faq-item p {
    margin: 0.6rem 0 0;
    color: var(--ink-dim);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .article-foot {
    max-width: 52rem;
    margin-top: 2.5rem;
  }

  .note {
    padding: 1rem 1.1rem;
    border: 1px solid rgba(var(--gold-rgb), 0.4);
    background: rgba(var(--gold-rgb), 0.06);
    color: var(--ink-dim);
    font-size: 0.84rem;
  }

  .related {
    margin-top: 1.4rem;
    border: 1px solid var(--line);
    background: var(--bg-2);
  }

  .related-title {
    margin: 0;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .related-list {
    display: grid;
  }

  .related-list a {
    display: grid;
    gap: 0.15rem;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: color 180ms var(--ease-premium);
  }

  .related-list a:last-child {
    border-bottom: 0;
  }

  .related-list a:hover strong {
    color: var(--accent-gold-light);
  }

  .related-list strong {
    font-size: 0.9rem;
  }

  .related-list span {
    color: var(--ink-faint);
    font-size: 0.78rem;
  }

  @media (max-width: 820px) {
    .article-body-wide {
      grid-template-columns: 1fr;
    }

    .article-side {
      position: static;
    }
  }

  @media (max-width: 40rem) {
    .qf-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
