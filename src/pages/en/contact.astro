---
import { buildWhatsAppLink, site, whatsAppMessages } from '../../data/site.js';
import Base from '../../layouts/Base.astro';
---
<Base
  title="Contact — Samrat FRP Traders"
  description="Contact Samrat FRP Traders — Biratnagar, Nepal. WhatsApp: +977 9805526904, email: samratfrptraders@gmail.com. Price on request."
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">Contact</p>
      <h1>Send an <span class="metal-text">enquiry.</span></h1>
      <p class="page-lead">
        Reach us directly on WhatsApp, by phone or by email — price on request.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-info" data-reveal>
        <p class="eyebrow">Contact details</p>
        <h2>Samrat FRP Traders</h2>
        <p class="contact-lead">
          {site.business.addressLine1}, {site.business.city}, {site.business.country}
        </p>

        <div class="contact-actions">
          <a
            class="button button-primary"
            href={buildWhatsAppLink(whatsAppMessages.en)}
            target="_blank"
            rel="noopener"
          >
            WhatsApp
          </a>
          <a class="button" href={`tel:${site.business.tel}`}>{site.business.phone}</a>
          <a class="button" href={`mailto:${site.business.email}`}>Email</a>
        </div>

        <div class="contact-lines" aria-label="Business details">
          <div>
            <span>Address</span>
            <strong>{site.business.addressLine1}, {site.business.city}, {site.business.country}</strong>
          </div>
          <div>
            <span>Phone / WhatsApp</span>
            <strong>{site.business.phone}</strong>
          </div>
          <div>
            <span>Email</span>
            <strong>{site.business.email}</strong>
          </div>
          <div>
            <span>PAN</span>
            <strong>{site.business.pan}</strong>
          </div>
          <div>
            <span>VAT</span>
            <strong>{site.business.vat}</strong>
          </div>
          <div>
            <span>EXIM Code</span>
            <strong>{site.business.exim}</strong>
          </div>
        </div>
      </div>

      <div class="form-panel" data-reveal style="--reveal-delay: 140ms">
        <p class="form-note">
          Submitting this form opens WhatsApp with your details pre-filled, ready to send to
          +977 9805526904. The form sends no data anywhere else.
        </p>

        <form class="form-shell" id="waForm">
          <legend>Enquiry form</legend>
          <div class="form-grid">
            <label>
              <span>Name</span>
              <input type="text" name="name" required placeholder="Your name" />
            </label>
            <label>
              <span>Company</span>
              <input type="text" name="company" placeholder="Company name (optional)" />
            </label>
          </div>
          <label>
            <span>Product / requirement</span>
            <input type="text" name="product" placeholder="e.g. GP Clear Resin, Glass Fiber Mat…" />
          </label>
          <label>
            <span>Quantity</span>
            <input type="text" name="quantity" placeholder="e.g. estimated quantity, drums/packaging" />
          </label>
          <label>
            <span>Message</span>
            <textarea name="message" rows="5" placeholder="Describe your requirement"></textarea>
          </label>
          <button class="button button-primary" type="submit">Open in WhatsApp</button>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('waForm');
    if (form && form.dataset.wired !== 'true') {
      form.dataset.wired = 'true';
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const fd = new FormData(form);
        const lines = [
          'Hello, I would like to contact Samrat FRP Traders.',
          'Name: ' + (fd.get('name') || ''),
          'Company: ' + (fd.get('company') || ''),
          'Product: ' + (fd.get('product') || ''),
          'Quantity: ' + (fd.get('quantity') || ''),
          'Message: ' + (fd.get('message') || ''),
        ].filter((line) => !line.endsWith(': '));
        window.open(
          'https://wa.me/{site.business.whatsapp}?text=' + encodeURIComponent(lines.join('\n')),
          '_blank',
          'noopener',
        );
      });
    }
  </script>
</Base>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }

  .contact-info h2 {
    max-width: 18ch;
    margin-top: 0.7rem;
  }

  .contact-lead {
    max-width: 42rem;
    color: var(--ink-dim);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 1.4rem 0 2rem;
  }

  .contact-lines {
    border-block: 1px solid var(--line);
  }

  .contact-lines div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
  }

  .contact-lines div:last-child {
    border-bottom: 0;
  }

  .contact-lines span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-lines strong {
    color: var(--ink);
    font-size: 0.9rem;
  }

  .form-panel {
    display: grid;
    gap: 1.3rem;
    padding: clamp(1.2rem, 4vw, 2rem);
    border: 1px solid var(--line);
    background: var(--bg-3);
    box-shadow: var(--surface-shadow-rest);
  }

  .form-note {
    margin: 0;
    padding: 1rem 1.1rem;
    border-left: 0.25rem solid var(--accent-gold);
    background: rgba(var(--gold-rgb), 0.06);
    color: var(--ink-dim);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .form-shell {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .form-shell legend {
    width: 100%;
    margin-bottom: 0.2rem;
    padding: 0 0 0.8rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-shell label {
    display: grid;
    gap: 0.4rem;
  }

  .form-shell label span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .form-shell input,
  .form-shell textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: 0;
    background: var(--bg);
    color: var(--ink);
  }

  @media (max-width: 48rem) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32rem) {
    .contact-lines div {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
