---
import CatalogCard from '../components/CatalogCard.astro';
import BusinessDetails from '../components/home/BusinessDetails.astro';
import CoverageNepal from '../components/home/CoverageNepal.astro';
import SupplyVideo from '../components/home/SupplyVideo.astro';
import WhyChoose from '../components/home/WhyChoose.astro';
import { applications } from '../data/applications.js';
import { catalogGroups, getGroup, productHref, products } from '../data/products.js';
import { resources } from '../data/resources.js';
import { buildWhatsAppLink, whatsAppMessages } from '../data/site.js';
import Base from '../layouts/Base.astro';

const indexableCategories = catalogGroups.filter((group) => group.indexable);
const featuredProducts = products.filter((product) => product.tier === 'A');
const groupName = (slug) => getGroup(slug)?.name;
const featuredApplications = applications.slice(0, 6);
const featuredResources = resources.slice(0, 3);
---
<Base
  lang="ne"
  title="नेपालभर FRP सामग्री आपूर्तिकर्ता र आयातकर्ता"
  description="Samrat FRP Traders ले नेपालभर FRP सामग्री र औद्योगिक resin हरू आपूर्ति तथा आयात गर्दछ — polyester resin, gelcoat, glass fiber mat, hardener लगायत, आपूर्तिकर्ताको प्राविधिक कागजातसहित।"
>
  <section class="hero">
    <div class="hero-media" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow">नेपालभर FRP तथा औद्योगिक रेजिन आपूर्ति</p>
      <h1 class="hero-title">
        Polyester, Epoxy<br />
        &amp; Composite Materials<br />
        <span class="hl" data-text="नेपालभर विश्वसनीय आपूर्ति">नेपालभर विश्वसनीय आपूर्ति</span>
      </h1>
      <p class="hero-tagline">
        गुणस्तरीय <strong>सामग्री</strong>। भरपर्दो <strong>आपूर्ति</strong>।
      </p>
      <p class="hero-sub">
        Samrat FRP Traders ले नेपालभर FRP, Polyester Resin, Epoxy Resin, Gelcoat, Glass Fiber
        तथा सम्बन्धित औद्योगिक सामग्री आपूर्ति गर्दछ।
      </p>
      <div class="hero-trust">
        <span class="hero-trust-item">
          <span class="hero-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 L20 6 L20 12 C20 17 16.5 20.5 12 22 C7.5 20.5 4 17 4 12 L4 6 Z" /><path d="M8.5 12 L11 14.5 L15.5 9.5" /></svg></span>
          व्यापारी · आपूर्तिकर्ता
        </span>
        <span class="hero-trust-item">
          <span class="hero-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2" /><line x1="3" y1="10" x2="21" y2="10" /><line x1="8" y1="3" x2="8" y2="7" /><line x1="16" y1="3" x2="16" y2="7" /></svg></span>
          आयातकर्ता · पुनर्विक्रेता
        </span>
        <span class="hero-trust-item">
          <span class="hero-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22 C12 22 19 15 19 9.5 A7 7 0 0 0 5 9.5 C5 15 12 22 12 22 Z" /><circle cx="12" cy="9.5" r="2.4" /></svg></span>
          सम्पूर्ण नेपाल
        </span>
        <span class="hero-trust-item">
          <span class="hero-trust-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 H14 L18 6 V22 H6 Z" /><path d="M14 2 V6 H18" /><path d="M9 13 L11.5 15.5 L16 10.5" /></svg></span>
          TDS र SDS उपलब्ध
        </span>
      </div>
      <div class="hero-cta">
        <a class="button button-primary" href="/products/">उत्पादनहरू हेर्नुहोस्</a>
        <a class="button" href="/contact/">सम्पर्क गर्नुहोस्</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading section-heading-split" data-reveal>
        <div>
          <p class="eyebrow">उत्पादन परिवारहरू</p>
          <h2>Resin र FRP सामग्रीहरू</h2>
        </div>
        <p class="section-lead">
          नेपाल बजारका लागि आपूर्ति तथा आयात गरिने २४ उत्पादनको सूची — हरेक पृष्ठमा आपूर्तिकर्ता-स्रोत
          प्राविधिक विवरण र TDS/SDS लिंकहरू।
        </p>
      </div>

      <div class="catalogue-categories" data-reveal>
        {indexableCategories.map((group) => (
          <CatalogCard
            name={group.name}
            eyebrow="उत्पादन वर्ग"
            href={`/products/${group.slug}/`}
            description={group.summary}
          />
        ))}
      </div>

      <div class="featured-heading" data-reveal>
        <p class="eyebrow">मुख्य उत्पादनहरू</p>
      </div>
      <div class="catalogue-grid" data-reveal>
        {featuredProducts.map((product) => (
          <CatalogCard
            name={product.name}
            eyebrow={groupName(product.group)}
            href={`/products/${product.slug}/`}
          />
        ))}
      </div>

      <div class="section-actions" data-reveal>
        <a class="button button-primary" href="/products/">पूरा उत्पादन सूची हेर्नुहोस्</a>
        <a
          class="button"
          href="/downloads/samrat-frp-traders-product-catalogue.pdf"
          target="_blank"
          rel="noopener"
          download
        >
          उत्पादन क्याटलग (PDF)
        </a>
      </div>
    </div>
  </section>

  <section class="section section-framed">
    <div class="container">
      <div class="section-heading section-heading-split" data-reveal>
        <div>
          <p class="eyebrow">प्रयोगहरू</p>
          <h2>FRP सामग्री कहाँ प्रयोग हुन्छ</h2>
        </div>
        <p class="section-lead">
          पानी ट्यांकी, छाना पाता, डुंगा, प्यानल, casting र औद्योगिक निर्माणसम्बन्धी प्रयोग गाइडहरू।
        </p>
      </div>

      <div class="app-gallery" data-reveal>
        {featuredApplications.map((app) => (
          <a class="app-card" href={`/applications/${app.slug}/`}>
            <span class="app-media">
              <img src={`/images/applications/${app.cardImage}`} alt={app.cardImageAlt} loading="lazy" width="700" height="466" />
            </span>
            <span class="app-body">
              <span class="app-title">{app.title}</span>
              <span class="app-desc">{app.cardDescription}</span>
            </span>
          </a>
        ))}
      </div>

      <div class="section-actions" data-reveal>
        <a class="button" href="/applications/">सबै प्रयोगहरू हेर्नुहोस्</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container supplier-band" data-reveal>
      <div class="supplier-media">
        <img
          src="/images/supplier/supplier-production.jpg"
          alt="आपूर्तिकर्ताको उत्पादन पूर्वाधार — Samrat Poly Resins सन्दर्भ तस्बिर"
          loading="lazy"
          width="700"
          height="466"
        />
      </div>
      <div class="supplier-copy">
        <p class="eyebrow">विश्वसनीय आपूर्ति सम्बन्ध</p>
        <h2>नेपालका लागि स्रोत-सहितको आपूर्ति।</h2>
        <p>
          Samrat FRP Traders नेपालभर सेवा दिने व्यापारी, आपूर्तिकर्ता, आयातकर्ता र पुनर्विक्रेता हो।
          Samrat Poly Resins, India resin र सम्बन्धित FRP सामग्रीका लागि Samrat FRP Traders को विश्वसनीय आपूर्तिकर्ता हो।
          आपूर्तिकर्ता सन्दर्भ मिडिया Samrat Poly Resins को हो — यसले Samrat FRP Traders का भौतिक संरचनाहरू जनाउँदैन।
        </p>
        <div class="supplier-stats">
          <div><strong>२४</strong><span>उत्पादनहरू</span></div>
          <div><strong>४८</strong><span>TDS र SDS लिंक</span></div>
          <div><strong>३७</strong><span>प्रयोग गाइडहरू</span></div>
        </div>
        <a class="button button-primary" href="/about/">Samrat FRP Traders बारे</a>
      </div>
    </div>
  </section>

  <SupplyVideo lang="ne" />

  <WhyChoose lang="ne" />

  <CoverageNepal lang="ne" />

  <BusinessDetails lang="ne" />

  <section class="section">
    <div class="container">
      <div class="section-heading section-heading-split" data-reveal>
        <div>
          <p class="eyebrow">जानकारी केन्द्र</p>
          <h2>खरिदकर्ताका लागि स्रोतहरू</h2>
        </div>
        <p class="section-lead">
          छनोट गाइड, तुलना, खरिद चेकलिस्ट र प्राविधिक व्याख्याहरू — नेपालका खरिदकर्ताहरूका लागि।
        </p>
      </div>

      <div class="resource-strip" data-reveal>
        {featuredResources.map((resource) => (
          <a class="resource-card" href={`/resources/${resource.slug}/`}>
            <span class="resource-cat">{resource.category}</span>
            <span class="resource-title">{resource.title}</span>
            <span class="resource-desc">{resource.description}</span>
            <span class="resource-meta">{resource.readingTime} · {resource.publishDate}</span>
          </a>
        ))}
      </div>

      <div class="section-actions" data-reveal>
        <a class="button" href="/resources/">जानकारी केन्द्र खोल्नुहोस्</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-band" data-reveal>
      <div>
        <p class="eyebrow">सोधपुछ</p>
        <h2>नेपालमा FRP सामग्री खोज्दै हुनुहुन्छ?</h2>
        <p>
          मूल्य: अनुरोधमा। TDS/SDS कागजातसहितको उत्पादन सूची हेर्नुहोस्, अनि WhatsApp, फोन वा इमेलबाट
          आफ्नो आवश्यकता पठाउनुहोस्।
        </p>
      </div>
      <div class="cta-actions">
        <a
          class="button button-primary"
          href={buildWhatsAppLink(whatsAppMessages.ne)}
          target="_blank"
          rel="noopener"
        >
          WhatsApp मा सोध्नुहोस्
        </a>
        <a class="button" href="/products/">उत्पादनहरू हेर्नुहोस्</a>
        <a class="button" href="tel:+9779805526904">+977 9805526904</a>
        <a class="button" href="mailto:samratfrptraders@gmail.com">इमेल</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .catalogue-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: 1rem;
  }

  /* Category identity: a restrained left-edge accent bar whose opacity
     cycles by position, using the single gold accent rather than a
     distinct color per category. Presentation-only — no product-data
     field is introduced for this. */
  .catalogue-categories :global(.catalog-card) {
    border-left-width: 0.2rem;
    border-left-style: solid;
  }

  .catalogue-categories :global(.catalog-card:nth-of-type(8n+1)) { border-left-color: rgba(var(--gold-rgb), 0.85); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+2)) { border-left-color: rgba(var(--gold-rgb), 0.72); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+3)) { border-left-color: rgba(var(--gold-rgb), 0.6); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+4)) { border-left-color: rgba(var(--gold-rgb), 0.48); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+5)) { border-left-color: rgba(var(--gold-rgb), 0.6); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+6)) { border-left-color: rgba(var(--gold-rgb), 0.72); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+7)) { border-left-color: rgba(var(--gold-rgb), 0.85); }
  .catalogue-categories :global(.catalog-card:nth-of-type(8n+8)) { border-left-color: rgba(var(--gold-rgb), 0.36); }

  .featured-heading { margin: 2.5rem 0 1.1rem; }

  .catalogue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
  }

  .app-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: 1.1rem;
  }

  .app-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg-3);
    box-shadow: var(--surface-shadow-rest);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 220ms var(--ease-premium), transform 220ms var(--ease-premium), box-shadow 220ms var(--ease-premium);
  }

  .app-card:hover {
    transform: translateY(-0.2rem);
    border-color: rgba(var(--gold-rgb), 0.65);
    box-shadow: var(--surface-shadow-hover);
  }

  .app-media img {
    width: 100%;
    aspect-ratio: 3 / 2;
    display: block;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }

  .app-body { display: grid; gap: 0.45rem; padding: 1.05rem 1.2rem 1.2rem; }

  .app-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .app-desc { color: var(--ink-dim); font-size: 0.84rem; line-height: 1.5; }

  .supplier-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: center;
  }

  .supplier-media img {
    width: 100%;
    display: block;
    border: 1px solid var(--line-2);
    box-shadow: var(--surface-shadow-rest);
  }

  .supplier-copy h2 { max-width: 15ch; margin-top: 0.7rem; }
  .supplier-copy p { color: var(--ink-dim); }

  .supplier-stats { display: flex; flex-wrap: wrap; gap: 1.5rem 2.5rem; margin: 1.75rem 0; }
  .supplier-stats div { display: grid; }
  .supplier-stats strong {
    color: var(--accent-gold-light);
    font-family: var(--font-display);
    font-size: 2.1rem;
    font-weight: 700;
    line-height: 1;
  }
  .supplier-stats span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .resource-strip {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: 1.1rem;
  }

  .resource-card {
    display: grid;
    gap: 0.5rem;
    padding: 1.2rem 1.3rem;
    border: 1px solid var(--line);
    background: var(--bg-3);
    box-shadow: var(--surface-shadow-rest);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 220ms var(--ease-premium), transform 220ms var(--ease-premium);
  }

  .resource-card:hover {
    transform: translateY(-0.2rem);
    border-color: rgba(var(--gold-rgb), 0.65);
  }

  .resource-cat {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .resource-title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .resource-desc {
    color: var(--ink-dim);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .resource-meta {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 53.75rem) {
    .supplier-band { grid-template-columns: 1fr; }
  }
</style>
