---
import CatalogCard from '../components/CatalogCard.astro';
import { catalogGroups, getGroup, productHref, products } from '../data/products.js';
import Base from '../layouts/Base.astro';

const indexableCategories = catalogGroups.filter((group) => group.indexable);
const featuredProducts = products.filter((product) => product.tier === 'A');
const groupName = (slug) => getGroup(slug)?.name;
---
<Base description="Development scaffold for the Samrat FRP Traders Nepal website. Verified business and product information is pending.">
  <section class="hero-shell hero-home">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container hero-layout">
      <div class="hero-content">
        <p class="eyebrow">Local website foundation</p>
        <h1 class="hero-title">
          Clear structure.<br />
          <span class="metal-text">Verified facts</span><br />
          when ready.
        </h1>
        <p class="hero-lead">
          Samrat FRP Traders is represented here only as an FRP materials trader and supplier.
          This local interface remains provisional until business, product, and contact information is verified.
        </p>
        <div class="hero-status" aria-label="Website foundation status">
          <span>Trader / supplier scope</span>
          <span>Product data pending</span>
          <span>Contact integration pending</span>
        </div>
        <div class="button-row">
          <a class="button button-primary" href="/products/">Explore product foundation</a>
          <a class="button" href="/about/">Review project boundaries</a>
        </div>
      </div>

      <figure class="hero-figure" aria-hidden="true" data-reveal style="--reveal-delay: 420ms">
        <span class="figure-tick figure-tick-tr"></span>
        <span class="figure-tick figure-tick-bl"></span>
        <div class="hero-figure-frame">
          <div class="laminate">
            <span class="l-a"></span>
            <span class="l-b"></span>
            <span class="l-c"></span>
            <span class="l-d"></span>
            <span class="l-e"></span>
            <span class="l-f"></span>
            <span class="l-g"></span>
            <span class="l-h"></span>
          </div>
        </div>
        <figcaption>
          <span>Fig. 01</span>
          <span>Material study</span>
        </figcaption>
      </figure>

      <div class="scroll-cue" aria-hidden="true">
        <span>Scroll</span>
        <i></i>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading section-heading-split" data-reveal>
        <div>
          <p class="eyebrow">Foundation scope</p>
          <h2>Structure before claims</h2>
        </div>
        <p class="section-lead">
          The shared shell now carries a stronger industrial visual language while keeping every commercial detail behind a verification gate.
        </p>
      </div>

      <div class="foundation-grid">
        <article class="foundation-card" data-reveal>
          <p class="card-number">01</p>
          <div>
            <p class="card-label">Product structure</p>
            <h3>Records with clear boundaries</h3>
            <p>Reusable card and listing patterns are ready for verified categories and product records.</p>
          </div>
        </article>
        <article class="foundation-card" data-reveal style="--reveal-delay: 80ms">
          <p class="card-number">02</p>
          <div>
            <p class="card-label">Information layers</p>
            <h3>Source-led documentation</h3>
            <p>Specifications and supporting files remain absent until source and publishing rights are confirmed.</p>
          </div>
        </article>
        <article class="foundation-card" data-reveal style="--reveal-delay: 160ms">
          <p class="card-number">03</p>
          <div>
            <p class="card-label">Enquiry foundation</p>
            <h3>Interface without transmission</h3>
            <p>The contact layout is present, but every field and destination remains deliberately inactive.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-framed">
    <div class="container">
      <div class="section-heading section-heading-split" data-reveal>
        <div>
          <p class="eyebrow">Product catalogue</p>
          <h2>FRP materials for Nepal</h2>
        </div>
        <p class="section-lead">
          The full product range supplied and imported by Samrat FRP Traders, grouped by product family.
          Detailed product information is being verified before publication.
        </p>
      </div>

      <div class="catalogue-categories" data-reveal>
        {indexableCategories.map((group) => (
          <CatalogCard
            name={group.name}
            eyebrow="Product category"
            href={`/products/${group.slug}/`}
            description={group.summary}
          />
        ))}
      </div>

      <div class="featured-heading" data-reveal>
        <p class="eyebrow">Featured products</p>
      </div>
      <div class="catalogue-grid" data-reveal>
        {featuredProducts.map((product) => (
          <CatalogCard
            name={product.name}
            eyebrow={groupName(product.group)}
            href={productHref(product)}
          />
        ))}
      </div>

      <div class="section-actions" data-reveal style="--reveal-delay: 200ms">
        <a class="button button-primary" href="/products/">View full product catalogue</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container cta-band" data-reveal>
      <div>
        <p class="eyebrow">Next information gate</p>
        <h2>Verification comes before publication.</h2>
        <p>
          No telephone number, email address, physical address, or live form destination is configured in this local foundation.
        </p>
      </div>
      <div class="cta-actions">
        <a class="button button-primary" href="/about/">See required business facts</a>
        <a class="button" href="/contact/">View disabled contact shell</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .foundation-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .foundation-card {
    min-height: 20rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.4rem, 4vw, 2rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.025), transparent);
    transition: background 220ms var(--ease-premium), transform 220ms var(--ease-premium);
  }

  .foundation-card:hover {
    transform: translateY(-0.2rem);
    background: rgba(var(--gold-rgb), 0.055);
  }

  .card-number {
    margin: 0;
    color: var(--accent-gold-light);
    font-family: var(--font-display);
    font-size: 3.7rem;
    font-weight: 700;
    line-height: 1;
  }

  .foundation-card h3 {
    margin-bottom: 0.7rem;
    font-size: 1.35rem;
  }

  .foundation-card div > p:last-child {
    margin-bottom: 0;
    color: var(--ink-dim);
    font-size: 0.9rem;
  }

  .catalogue-categories {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: 1rem;
  }

  .featured-heading {
    margin: 2.5rem 0 1.1rem;
  }

  .catalogue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
  }

  @media (max-width: 53.75rem) {
    .foundation-grid {
      grid-template-columns: 1fr;
    }

    .foundation-card {
      min-height: 15rem;
    }
  }
</style>
