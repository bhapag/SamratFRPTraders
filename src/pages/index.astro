---
import StatusNotice from '../components/StatusNotice.astro';
import Base from '../layouts/Base.astro';
---
<Base description="Development scaffold for the Samrat FRP Traders Nepal website. Verified business and product information is pending.">
  <section class="hero">
    <div class="container hero-content">
      <p class="eyebrow">Pre-foundation website scaffold</p>
      <h1>Samrat FRP Traders</h1>
      <p class="hero-lead">
        A restrained technical foundation for a future Nepal-focused FRP materials supplier website.
        Business, product, and contact details will be published only after verification.
      </p>
      <div class="button-row">
        <a class="button button-primary" href="/products/">View product scaffold</a>
        <a class="button" href="/about/">About this foundation</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Foundation scope</p>
        <h2>Structure before claims</h2>
        <p>
          This phase establishes routing, reusable layout, responsive navigation, and technical SEO hooks.
          It intentionally does not present unverified commercial information.
        </p>
      </div>

      <div class="card-grid">
        <article class="card">
          <p class="card-label">Foundation 01</p>
          <h3>Product structure</h3>
          <p>A clean place for verified categories and product records when they become available.</p>
        </article>
        <article class="card">
          <p class="card-label">Foundation 02</p>
          <h3>Technical information</h3>
          <p>Future specifications and documents will require source and rights verification before publication.</p>
        </article>
        <article class="card">
          <p class="card-label">Foundation 03</p>
          <h3>Enquiry flow</h3>
          <p>The contact structure is present, while submission and contact details remain deliberately inactive.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container narrow">
      <StatusNotice
        title="Contact integration pending"
        message="No telephone number, email address, physical address, or live form destination is configured in this foundation."
      />
      <div class="section-actions">
        <a class="button" href="/contact/">Open contact scaffold</a>
      </div>
    </div>
  </section>
</Base>
