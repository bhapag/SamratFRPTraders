---
import BrandEntity from '../components/BrandEntity.astro';
import DocumentLibrary from '../components/DocumentLibrary.astro';
import { documentStats } from '../data/documents.js';
import Base from '../layouts/Base.astro';

const stats = documentStats();
---
<Base
  lang="ne"
  title="TDS र SDS कागजात पुस्तकालय"
  description={`Samrat FRP Traders ले नेपालका लागि आपूर्ति तथा आयात गर्ने ${stats.documentedProducts} उत्पादनका प्राविधिक तथा सुरक्षा डाटा शीट — Samrat Poly Resins, India ले जारी गरेका ${stats.documentEntries} कागजात।`}
>
  <DocumentLibrary lang="ne" />
  <BrandEntity />
</Base>
