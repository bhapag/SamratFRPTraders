---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="The requested page could not be found." noindex canonical={false}>
  <section class="page-hero page-hero-centered">
    <div class="container narrow">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p>The requested page is not part of this development foundation.</p>
      <div class="section-actions">
        <a class="button button-primary" href="/">Return home</a>
      </div>
    </div>
  </section>
</Base>
