---
import Base from '../layouts/Base.astro';
---
<Base
  lang="ne"
  title="पृष्ठ भेटिएन"
  description="अनुरोध गरिएको पृष्ठ फेला पार्न सकिएन।"
  noindex
  canonical={false}
>
  <section class="page-hero hero-shell page-hero-centered">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container narrow page-hero-content">
      <p class="eyebrow">४०४</p>
      <h1>पृष्ठ <span class="metal-text">भेटिएन।</span></h1>
      <p>यो पृष्ठ सारिएको हुन सक्छ, वा ठेगाना मिलेको नहुन सक्छ। तपाईं उत्पादन सूची हेर्न, प्रयोगहरू हेर्न वा आफ्नो आवश्यकताबारे सम्पर्क गर्न सक्नुहुन्छ।</p>
      <div class="section-actions">
        <a class="button button-primary" href="/products/">उत्पादनहरू हेर्नुहोस्</a>
        <a class="button" href="/applications/">प्रयोगहरू</a>
        <a class="button" href="/contact/">सम्पर्क गर्नुहोस्</a>
      </div>
    </div>
  </section>
</Base>
