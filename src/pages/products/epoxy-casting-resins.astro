---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CatalogCard from '../../components/CatalogCard.astro';
import CategoryHubDetail from '../../components/product/CategoryHubDetail.astro';
import { getGroup, productHref, productsInGroup } from '../../data/products.js';
import { productImageAlt } from '../../utils/product-page.js';
import Base from '../../layouts/Base.astro';

const group = getGroup('epoxy-casting-resins');
const items = productsInGroup('epoxy-casting-resins');
---
<Base
  lang="ne"
  title="Epoxy र Casting Resins — नेपालमा आपूर्तिकर्ता"
  description="नेपालका खरिदकर्ताका लागि Samrat FRP Traders ले आपूर्ति तथा आयात गर्ने epoxy र casting resin उत्पादनहरू।"
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">उत्पादन वर्ग</p>
      <h1>{group.name}</h1>
      <p class="page-lead">नेपाल बजारका लागि आपूर्ति तथा आयात गरिने epoxy र casting resin परिवार।</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'गृहपृष्ठ', href: '/' },
          { label: 'उत्पादनहरू', href: '/products/' },
          { label: group.name },
        ]}
      />

      <div class="category-intro" data-reveal>
        <p>
          यो वर्गमा epoxy resin प्रणाली, UV-curing resin र hardener कम्पोनेन्टहरू पर्छन्। यी उत्पादनहरूको
          रसायन भिन्न छन् र हरेकको कागजात अलग-अलग छ — resin/hardener जोडा प्रति-उत्पादन पुष्टि गर्नुपर्छ।
        </p>
        <p>
          यस परिवारमा तीन resin र एक curing agent छन्, र सबै एउटै तरिकाले cure हुँदैनन्। Clear Casting Resin
          र Epoxy Art Resin लाई hardener सँग मिसाइन्छ र घण्टौँमा cure हुन्छन् — Clear Casting Resin का
          लागि आपूर्तिकर्ताले 25 °C मा 24 घण्टामा initial cure र 72 घण्टामा full cure, Shore D 82 र
          0.2% भन्दा कम shrinkage प्रकाशित गरेको छ। UV Resin भने epoxy acrylate हो र UV/LED प्रकाशमा
          cure हुन्छ, त्यसैले उही वर्गमा भए पनि यसको कार्यप्रवाह पूरै फरक छ।
        </p>
        <p>
          यहाँ सूचीकृत Epoxy Hardener polyamide (amine आधारित) curing agent हो। आपूर्तिकर्ताको कागजातले
          resin र hardener को जोडा अनुमान नगरी अर्डर गर्नुअघि पुष्टि गर्न भन्छ — त्यसैले enquiry गर्दा
          कुन resin सँग जोड्ने हो, नाम लेख्नुहोस्। प्रायः अर्डर सही हुने कि नहुने यही एउटा विवरणले
          निर्धारण गर्छ।
        </p>
      </div>

      <div class="category-grid" data-reveal style="--reveal-delay: 80ms">
        {items.map((product) => (
          <CatalogCard
            name={product.name}
            eyebrow={group.name}
            href={`/products/${product.slug}/`}
            showMedia
            image={product.images?.[0]}
            imageAlt={productImageAlt(product, true)}
            ctaLabel="उत्पादन हेर्नुहोस्"
          />
        ))}
      </div>

      <CategoryHubDetail groupSlug="epoxy-casting-resins" lang="ne" />

      <div class="section-actions" data-reveal style="--reveal-delay: 160ms">
        <a class="button" href="/products/">पूरा सूची हेर्नुहोस्</a>
        <a class="button" href="/documents/">TDS / SDS पुस्तकालय</a>
        <a class="button" href="/contact/">Enquiry पठाउनुहोस्</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Product-discovery priority: get real product photography in view
     quickly rather than running the full-height brand hero every other
     page uses. Scoped to this page only. */
  .page-hero {
    min-height: clamp(14rem, 26vh, 19rem);
  }

  .page-hero-content {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .section:first-of-type {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .category-intro {
    max-width: 46rem;
    margin-block: 1.25rem;
    color: var(--ink-dim);
  }

  .category-intro p {
    margin-bottom: 0;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
    margin-top: 1.75rem;
  }
</style>
