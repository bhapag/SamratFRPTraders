---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CatalogCard from '../../components/CatalogCard.astro';
import { getGroup, productHref, productsInGroup } from '../../data/products.js';
import Base from '../../layouts/Base.astro';

const group = getGroup('epoxy-casting-resins');
const items = productsInGroup('epoxy-casting-resins');
---
<Base
  lang="ne"
  title="Epoxy र Casting Resins — नेपालमा आपूर्तिकर्ता"
  description="नेपालका खरिदकर्ताका लागि Samrat FRP Traders ले आपूर्ति तथा आयात गर्ने epoxy र casting resin उत्पादनहरू।"
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">उत्पादन वर्ग</p>
      <h1>{group.name}</h1>
      <p class="page-lead">नेपाल बजारका लागि आपूर्ति तथा आयात गरिने epoxy र casting resin परिवार।</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'गृहपृष्ठ', href: '/' },
          { label: 'उत्पादनहरू', href: '/products/' },
          { label: group.name },
        ]}
      />

      <div class="category-intro" data-reveal>
        <p>
          यो वर्गमा epoxy resin प्रणाली, UV-curing resin र hardener कम्पोनेन्टहरू पर्छन्। यी उत्पादनहरूको
          रसायन भिन्न छन् र हरेकको कागजात अलग-अलग छ — resin/hardener जोडा प्रति-उत्पादन पुष्टि गर्नुपर्छ।
        </p>
      </div>

      <div class="category-grid" data-reveal style="--reveal-delay: 80ms">
        {items.map((product) => (
          <CatalogCard name={product.name} eyebrow={group.name} href={`/products/${product.slug}/`} />
        ))}
      </div>

      <div class="section-actions" data-reveal style="--reveal-delay: 160ms">
        <a class="button" href="/products/">पूरा सूची हेर्नुहोस्</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .category-intro {
    max-width: 46rem;
    margin-block: 1.75rem;
    color: var(--ink-dim);
  }

  .category-intro p {
    margin-bottom: 0;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
    margin-top: 1.75rem;
  }
</style>
