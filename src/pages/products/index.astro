---
import CatalogCard from '../../components/CatalogCard.astro';
import { catalogGroups, categoryHref, productHref, products, productsInGroup } from '../../data/products.js';
import { documentStats } from '../../data/documents.js';
import { productImageAlt } from '../../utils/product-page.js';
import Base from '../../layouts/Base.astro';

const docs = documentStats();
---
<Base
  lang="ne"
  title="उत्पादन सूची — नेपालमा FRP सामग्री"
  description="Samrat FRP Traders को उत्पादन सूची — नेपाल बजारका लागि आपूर्ति तथा आयात गरिने FRP सामग्रीहरू, आपूर्तिकर्ताको प्राविधिक कागजातसहित।"
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">उत्पादन सूची</p>
      <h1>Samrat FRP Traders <span class="metal-text">उत्पादन सूची।</span></h1>
      <p class="page-lead">
        Samrat FRP Traders ले नेपाल बजारका लागि आपूर्ति तथा आयात गर्ने सम्पूर्ण उत्पादन दायरा,
        उत्पादन परिवारअनुसार समूहबद्ध। हरेक उत्पादन पृष्ठमा आपूर्तिकर्ताको प्राविधिक कागजात जोडिएको छ।
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="catalogue-shell">
        <aside class="catalogue-rail" data-reveal>
          <div class="catalogue-rail-search">
            <label class="visually-hidden" for="product-search">उत्पादन खोज्नुहोस्</label>
            <input
              type="search"
              id="product-search"
              class="catalogue-rail-search-input"
              placeholder="उत्पादन खोज्नुहोस्…"
              autocomplete="off"
              aria-label="उत्पादन खोज्नुहोस्"
            />
          </div>
          <div class="catalogue-rail-scroll" data-rail-scroll>
            <nav class="catalogue-rail-nav" role="group" aria-label="उत्पादन वर्ग फिल्टर">
              <button type="button" class="rail-link is-active" data-chip-cat="all" aria-pressed="true">
                <span class="rail-link-name">सबै उत्पादनहरू</span>
                <span class="rail-link-count">{products.length}</span>
              </button>
              {catalogGroups.map((group, index) => (
                <button type="button" class="rail-link" data-chip-cat={group.slug} aria-pressed="false">
                  <span class="rail-link-index">{String(index + 1).padStart(2, '0')}</span>
                  <span class="rail-link-name">{group.name}</span>
                  <span class="rail-link-count">{productsInGroup(group.slug).length}</span>
                </button>
              ))}
            </nav>
          </div>
        </aside>

        <div class="catalogue-main">
          <p class="catalogue-empty" data-catalogue-empty hidden>कुनै उत्पादन फेला परेन। खोज वा फिल्टर मिलाउनुहोस्।</p>

          <div class="catalogue" data-catalogue-index>
            {catalogGroups.map((group, index) => {
              const items = productsInGroup(group.slug);
              return (
                <section class="catalogue-group" id={group.slug} data-reveal data-cat-block={group.slug}>
                  <header class="catalogue-group-head">
                    <span class="catalogue-group-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                    <div class="catalogue-group-head-text">
                      <h2>{group.name}</h2>
                      {group.summary && <p class="catalogue-group-summary">{group.summary}</p>}
                    </div>
                    <span class="catalogue-count">{items.length} {items.length === 1 ? 'उत्पादन' : 'उत्पादनहरू'}</span>
                    {group.indexable && <a class="catalogue-group-link" href={`/products/${group.slug}/`}>वर्ग हेर्नुहोस् →</a>}
                  </header>
                  <div class="catalogue-grid">
                    {items.map((product) => (
                      <CatalogCard
                        name={product.name}
                        eyebrow={group.name}
                        href={`/products/${product.slug}/`}
                        category={group.slug}
                        showMedia
                        image={product.images?.[0]}
                        imageAlt={productImageAlt(product, true)}
                        ctaLabel="उत्पादन हेर्नुहोस्"
                      />
                    ))}
                  </div>
                </section>
              );
            })}
          </div>
        </div>
      </div>

      <div class="catalogue-support">
        <div class="catalogue-download" data-reveal>
          <div>
            <p class="eyebrow">कागजात</p>
            <h2>TDS र SDS कागजात पुस्तकालय।</h2>
            <p>
              {docs.totalProducts} मध्ये {docs.documentedProducts} उत्पादनका आपूर्तिकर्ता डाटा शीट —
              जम्मा {docs.documentEntries} कागजात, उत्पादन परिवारअनुसार एकै ठाउँमा।
            </p>
          </div>
          <a class="button button-primary" href="/documents/">पुस्तकालय खोल्नुहोस्</a>
        </div>

        <div class="catalogue-download" data-reveal>
          <div>
            <p class="eyebrow">PDF क्याटलग</p>
            <h2>पूर्ण उत्पादन क्याटलग डाउनलोड गर्नुहोस्।</h2>
            <p>हाम्रो पूर्ण FRP सामग्री तथा रेजिन दायरा हेर्नुहोस्।</p>
          </div>
          <a
            class="button button-primary"
            href="/products/"
                      >
            उत्पादन क्याटलग डाउनलोड गर्नुहोस् (PDF)
          </a>
        </div>

        <div class="catalogue-download catalogue-download-crsr" data-reveal>
          <div>
            <p class="eyebrow">अनुकूल आवश्यकता</p>
            <h2>तपाईंको आफ्नै रेजिन स्पेसिफिकेसन चाहिन्छ?</h2>
            <p>विस्कोसिटी, रङ, फायर-रिटार्डेन्ट आदि जस्ता लक्षित गुणहरू अनुरोध गर्नुहोस् — प्राविधिक समीक्षाका लागि।</p>
          </div>
          <a class="button" href="/custom-resin-specification-request/">
            अनुकूल रेजिन स्पेसिफिकेसन अनुरोध गर्नुहोस् →
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  function initProductFilter() {
    const root = document.querySelector('[data-catalogue-index]');
    if (!root) return;

    const searchInput = document.getElementById('product-search');
    const chips = document.querySelectorAll('[data-chip-cat]');
    const emptyNotice = document.querySelector('[data-catalogue-empty]');
    const blocks = root.querySelectorAll('[data-cat-block]');
    let activeCategory = 'all';

    function applyFilter() {
      const query = (searchInput && searchInput.value ? searchInput.value : '').trim().toLowerCase();
      let totalVisible = 0;

      blocks.forEach((block) => {
        const blockCat = block.getAttribute('data-cat-block');
        const catMatches = activeCategory === 'all' || blockCat === activeCategory;
        let blockVisible = 0;

        block.querySelectorAll('[data-catalog-card]').forEach((card) => {
          const haystack = card.getAttribute('data-search') || '';
          const searchMatches = !query || haystack.includes(query);
          const visible = catMatches && searchMatches;
          card.hidden = !visible;
          if (visible) blockVisible += 1;
        });

        block.hidden = blockVisible === 0;
        totalVisible += blockVisible;
      });

      if (emptyNotice) emptyNotice.hidden = totalVisible !== 0;
    }

    if (searchInput) {
      searchInput.addEventListener('input', applyFilter);
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeCategory = chip.getAttribute('data-chip-cat') || 'all';
        chips.forEach((c) => {
          const isActive = c === chip;
          c.classList.toggle('is-active', isActive);
          c.setAttribute('aria-pressed', String(isActive));
        });
        applyFilter();
      });
    });

    applyFilter();
  }

  // The chip strip's edge cues track its scroll position: a fade is shown
  // only on a side that still has chips behind it.
  function initRailOverflowCue() {
    const scroller = document.querySelector('[data-rail-scroll]');
    const rail = scroller ? scroller.querySelector('.catalogue-rail-nav') : null;
    if (!rail) return;

    const sync = () => {
      const overflow = rail.scrollWidth - rail.clientWidth;
      if (overflow <= 1) {
        scroller.setAttribute('data-overflow', 'none');
        return;
      }
      const offset = Math.abs(rail.scrollLeft);
      const edges = [];
      if (offset > 2) edges.push('start');
      if (offset < overflow - 2) edges.push('end');
      scroller.setAttribute('data-overflow', edges.join(' ') || 'none');
    };

    // Tabbing must not leave a chip half-under a fade. scroll-padding-inline
    // covers scrollIntoView but is not honoured for focus scrolling in every
    // engine, so the focused chip is brought fully into the strip explicitly.
    rail.addEventListener('focusin', (event) => {
      const chip = event.target.closest ? event.target.closest('.rail-link') : null;
      if (!chip) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      chip.scrollIntoView({ inline: 'nearest', block: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
    });

    rail.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
    if ('ResizeObserver' in window) new ResizeObserver(sync).observe(rail);
    sync();
  }

  initProductFilter();
  initRailOverflowCue();
</script>

<style>
  /* Product-discovery priority: get real product photography in view
     quickly rather than running the full-height brand hero every other
     page uses. Scoped to this page only. */
  .page-hero {
    min-height: clamp(14rem, 26vh, 19rem);
  }

  .page-hero-content {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .section:first-of-type {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  /* Opaque panel behind the catalogue controls — they previously washed out
     against the page's decorative background. */
  .catalogue-rail {
    position: relative;
    z-index: 1;
    padding: clamp(0.85rem, 2.5vw, 1.15rem);
    border: 1px solid var(--line);
    background: var(--bg-3);
    box-shadow: var(--surface-shadow-rest);
  }

  /* Supporting blocks sit after the catalogue so buyers reach products
     first. See the English catalogue index for the measured rationale. */
  .catalogue-support {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--line);
  }

  .catalogue-download {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
    padding: 1rem 1.3rem;
    border: 1px solid rgba(var(--gold-rgb), 0.4);
    border-left-width: 0.26rem;
    background: rgba(var(--gold-rgb), 0.05);
  }

  .catalogue-download h2 {
    margin: 0.35rem 0 0.25rem;
    font-size: 1.35rem;
  }

  .catalogue-download p:last-child {
    margin: 0;
    color: var(--ink-dim);
    font-size: 0.88rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- Asymmetric shell: sticky category index + reading column ---------- */
  .catalogue-shell {
    display: grid;
    grid-template-columns: minmax(13.5rem, 15rem) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
    margin-top: 1.5rem;
  }

  .catalogue-rail {
    position: sticky;
    top: 5.5rem;
    display: grid;
    gap: 1.25rem;
  }

  .catalogue-rail-search-input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    background: var(--bg-3);
    color: var(--ink);
    font-size: 0.88rem;
    transition: border-color 180ms var(--ease-premium);
  }

  .catalogue-rail-search-input:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
    border-color: rgba(var(--gold-rgb), 0.65);
  }

  .catalogue-rail-nav {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .rail-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.72rem 0.15rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    text-align: left;
    cursor: pointer;
    transition: color 180ms var(--ease-premium);
  }

  .rail-link:first-child {
    grid-template-columns: 1fr auto;
  }

  .rail-link-index {
    color: var(--ink-faint);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }

  .rail-link-name {
    font-size: 0.76rem;
    letter-spacing: 0.03em;
  }

  .rail-link-count {
    color: var(--ink-faint);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .rail-link:hover {
    color: var(--ink);
  }

  .rail-link:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: -2px;
  }

  .rail-link.is-active {
    color: var(--accent-gold-light);
  }

  .rail-link.is-active .rail-link-index,
  .rail-link.is-active .rail-link-count {
    color: var(--accent-gold-light);
  }

  .catalogue-empty {
    padding: 1rem 1.1rem;
    border: 1px dashed var(--line);
    color: var(--ink-dim);
    font-size: 0.88rem;
  }

  .catalogue {
    display: grid;
    gap: clamp(2.5rem, 7vw, 4.5rem);
  }

  .catalogue-group {
    scroll-margin-top: 6rem;
  }

  .catalogue-group-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    column-gap: 1.1rem;
    row-gap: 0.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(var(--gold-rgb), 0.22);
  }

  .catalogue-group-index {
    color: var(--accent-gold);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .catalogue-group-head-text h2 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.1rem);
  }

  .catalogue-group-summary {
    max-width: 46ch;
    margin: 0.35rem 0 0;
    color: var(--ink-dim);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .catalogue-count {
    grid-column: 3;
    grid-row: 1;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .catalogue-group-link {
    grid-column: 3;
    grid-row: 2;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms var(--ease-premium);
  }

  .catalogue-group-link:hover {
    color: var(--ink);
  }

  .catalogue-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: 1rem;
  }

  @media (max-width: 61.25rem) {
    .catalogue-shell {
      grid-template-columns: 1fr;
    }

    .catalogue-rail {
      position: static;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }

    .catalogue-rail-search {
      grid-column: 1 / -1;
    }

    .catalogue-rail-scroll {
      grid-column: 1 / -1;
    }

    .catalogue-rail-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0 1.5rem;
      border-top: 0;
      border-bottom: 1px solid var(--line);
      padding-bottom: 0.5rem;
    }

    .rail-link,
    .rail-link:first-child {
      grid-template-columns: auto auto;
      width: auto;
      border-bottom: 0;
      padding-block: 0.5rem;
    }

    .rail-link-index {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .catalogue-group-head {
      grid-template-columns: auto 1fr;
    }

    .catalogue-count,
    .catalogue-group-link {
      grid-column: 2;
    }
  }

  /* Mobile: rail (search + filter chips) stacks above the grid here, so
     it gets its own tighter budget to keep the first product photo close
     to view — same goal as the desktop hero/section trims above. */
  @media (max-width: 61.25rem) {
    .catalogue-download {
      padding: 0.85rem 1.1rem;
    }

    .catalogue-download h2 {
      font-size: 1.15rem;
    }

    .rail-link,
    .rail-link:first-child {
      min-height: 2.75rem;
      padding-block: 0.35rem;
    }

    .catalogue-group-head {
      margin-bottom: 0.75rem;
      padding-bottom: 0.6rem;
    }
  }

  @media (max-width: 40rem) {
    .catalogue-rail {
      gap: 0.85rem;
    }

    /* Horizontal chip strip on phones — see the English catalogue index for
       the measured rationale. Nepali category names are longer, so nowrap
       plus horizontal scroll matters more here, not less. */
    .catalogue-rail-nav {
      display: flex;
      flex-wrap: nowrap;
      gap: 0.5rem;
      padding: 0.7rem 0;
      overflow-x: auto;
      scroll-padding-inline: 2.5rem;
      overscroll-behavior-inline: contain;
      -webkit-overflow-scrolling: touch;
      border-bottom: 0;
      /* The strip used to hide its scrollbar, which removed the only native
         signal that seven more categories existed. A thin bar is the cue most
         people already know how to read; the edge fades below carry the same
         message on touch platforms that only paint a scrollbar mid-gesture. */
      scrollbar-width: thin;
      scrollbar-color: rgba(var(--gold-rgb), 0.5) transparent;
    }

    .catalogue-rail-nav::-webkit-scrollbar {
      height: 0.25rem;
    }

    .catalogue-rail-nav::-webkit-scrollbar-track {
      background: transparent;
    }

    .catalogue-rail-nav::-webkit-scrollbar-thumb {
      border-radius: 999px;
      background: rgba(var(--gold-rgb), 0.5);
    }

    /* Nine categories do not fit one phone-width row, and a strip with its
       scrollbar hidden gave no sign that seven of them existed: measured at
       390px, 329px of a 1599px strip was visible. These gradients fade the
       strip into the panel at whichever edge still has chips behind it, so the
       clipped chip reads as "more this way" rather than as a broken layout.
       The start cue is off and the end cue on before the script runs, which is
       the correct state for an unscrolled strip — so the cue is still right if
       the script never runs at all. */
    .catalogue-rail-scroll {
      position: relative;
    }

    .catalogue-rail-scroll::before,
    .catalogue-rail-scroll::after {
      content: '';
      position: absolute;
      inset-block: 0;
      inline-size: 3rem;
      pointer-events: none;
      transition: opacity 180ms var(--ease-premium);
    }

    .catalogue-rail-scroll::before {
      inset-inline-start: 0;
      opacity: 0;
      background: linear-gradient(to right, var(--bg-3), transparent);
    }

    .catalogue-rail-scroll::after {
      inset-inline-end: 0;
      opacity: 1;
      background: linear-gradient(to left, var(--bg-3), transparent);
    }

    .catalogue-rail-scroll[data-overflow~='start']::before {
      opacity: 1;
    }

    .catalogue-rail-scroll[data-overflow]:not([data-overflow~='end'])::after {
      opacity: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .catalogue-rail-scroll::before,
      .catalogue-rail-scroll::after {
        transition: none;
      }
    }

    .rail-link,
    .rail-link:first-child {
      flex: 0 0 auto;
      width: auto;
      min-height: 2.75rem;
      grid-template-columns: auto auto;
      gap: 0.4rem;
      padding: 0.5rem 0.8rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--bg-3);
      white-space: nowrap;
    }

    .rail-link-index {
      display: none;
    }

    .rail-link-name {
      font-size: 0.7rem;
      line-height: 1.25;
    }

    .rail-link-count {
      color: var(--accent-gold-light);
    }

    .rail-link.is-active {
      border-color: rgba(var(--gold-rgb), 0.62);
      background: rgba(var(--gold-rgb), 0.1);
    }
  }
</style>
