---
import ProductPage from '../../components/product/ProductPage.astro';
import { getProductContent } from '../../data/product-content.js';
import { getGroup, productParentGroup, products } from '../../data/products.js';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const group = getGroup(product.group);
const parent = productParentGroup(product);
const content = getProductContent(product.slug);
const localized = content?.ne ?? null;

const breadcrumbItems = [
  { label: 'गृहपृष्ठ', href: '/' },
  { label: 'उत्पादनहरू', href: '/products/' },
  ...(parent ? [{ label: parent.name, href: `/products/${parent.slug}/` }] : []),
  { label: product.name },
];

const seoTitle = localized?.seoTitle ?? product.titleInput ?? product.name;
const seoDescription =
  localized?.seoDescription ??
  product.metaDescription ??
  `${product.name} — Samrat FRP Traders ले नेपाल बजारका लागि आपूर्ति तथा आयात गर्ने उत्पादन।`;
---
<Base lang="ne" title={seoTitle} description={seoDescription}>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">{group?.name}</p>
      <h1>{product.name}</h1>
      <p class="page-lead">
        Samrat FRP Traders ले नेपाल बजारका लागि आपूर्ति तथा आयात गर्ने उत्पादन —
        आपूर्तिकर्ता Samrat Poly Resins, India को प्राविधिक कागजातसहित।
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <ProductPage
        lang="ne"
        prefix=""
        product={product}
        breadcrumbItems={breadcrumbItems}
        description={seoDescription}
      />
    </div>
  </section>
</Base>
