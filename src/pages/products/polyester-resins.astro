---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CatalogCard from '../../components/CatalogCard.astro';
import { getGroup, productHref, productsInGroup } from '../../data/products.js';
import { productImageAlt } from '../../utils/product-page.js';
import Base from '../../layouts/Base.astro';

const group = getGroup('polyester-resins');
const items = productsInGroup('polyester-resins');
---
<Base
  lang="ne"
  title="Polyester Resins — नेपालमा आपूर्तिकर्ता र आयातकर्ता"
  description="नेपालका खरिदकर्ताका लागि Samrat FRP Traders ले आपूर्ति तथा आयात गर्ने polyester resin उत्पादन परिवार।"
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">उत्पादन वर्ग</p>
      <h1>{group.name}</h1>
      <p class="page-lead">नेपाल बजारका लागि आपूर्ति तथा आयात गरिने polyester resin परिवार।</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'गृहपृष्ठ', href: '/' },
          { label: 'उत्पादनहरू', href: '/products/' },
          { label: group.name },
        ]}
      />

      <div class="category-intro" data-reveal>
        <p>
          Samrat FRP Traders ले यो उत्पादन परिवार नेपालभरका खरिदकर्ताका लागि आपूर्ति तथा आयात गर्दछ।
          Unsaturated Polyester Resin (UPR) व्यापक परिवार हो; तल सूचीकृत हरेक grade को आफ्नै आपूर्तिकर्ता
          प्राविधिक कागजात छ। कुनै खास प्रयोगका लागि उपयुक्तता grade-अनुसार पुष्टि गर्नुपर्छ।
        </p>
        <p>
          विशेष गरी "Unsaturated Polyester Resin" वा "UPR" नामले नै उत्पादन खोज्दै हुनुहुन्छ भने,
          <a href="/products/unsaturated-polyester-resin/">Unsaturated Polyester Resin</a> पृष्ठ हेर्नुहोस्।
          Samrat Poly Resins को कागजातले यो generic commercial नाम
          <a href="/products/gp-clear-resin/">GP Clear Resin</a> सँग मिल्दो भएको पुष्टि गर्छ — पूर्ण
          प्राविधिक डाटाका लागि GP Clear Resin पृष्ठ हेर्नुहोस्।
        </p>
      </div>

      <div class="category-grid" data-reveal style="--reveal-delay: 80ms">
        {items.map((product) => (
          <CatalogCard
            name={product.name}
            eyebrow={group.name}
            href={`/products/${product.slug}/`}
            showMedia
            image={product.images?.[0]}
            imageAlt={productImageAlt(product, true)}
            ctaLabel="उत्पादन हेर्नुहोस्"
          />
        ))}
      </div>

      <div class="section-actions" data-reveal style="--reveal-delay: 160ms">
        <a class="button" href="/products/">पूरा सूची हेर्नुहोस्</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Product-discovery priority: this page's job is to get real product
     photography in view quickly, not to run the full-height brand hero
     every other page uses. Scoped to this page only — the shared
     .page-hero/.section rules in foundation.css stay untouched for the
     rest of the site. */
  .page-hero {
    min-height: clamp(14rem, 26vh, 19rem);
  }

  .page-hero-content {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .section:first-of-type {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .category-intro {
    max-width: 46rem;
    margin-block: 1.25rem;
    color: var(--ink-dim);
  }

  .category-intro p {
    margin-bottom: 0;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
    margin-top: 1.75rem;
  }
</style>
