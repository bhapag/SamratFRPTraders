---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CatalogCard from '../../components/CatalogCard.astro';
import StatusNotice from '../../components/StatusNotice.astro';
import { getGroup, productHref, productsInGroup } from '../../data/products.js';
import Base from '../../layouts/Base.astro';

const group = getGroup('polyester-resins');
const items = productsInGroup('polyester-resins');
---
<Base
  title={group.name}
  description={`${group.name} supplied and imported for Nepal by Samrat FRP Traders. Product details are being verified.`}
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">Product category</p>
      <h1>{group.name}</h1>
      <p class="page-lead">{group.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Products', href: '/products/' },
          { label: group.name },
        ]}
      />

      <div class="category-intro" data-reveal>
        <p>
          Samrat FRP Traders supplies and imports this product family for buyers across Nepal.
          Detailed product information, technical documentation and commercial terms are being verified before publication.
        </p>
      </div>

      <StatusNotice
        title="Verification in progress"
        message="Each product page below remains a structural shell until its documentation and details are verified."
      />

      <div class="category-grid" data-reveal style="--reveal-delay: 80ms">
        {items.map((product) => (
          <CatalogCard name={product.name} eyebrow={group.name} href={productHref(product)} />
        ))}
      </div>

      <div class="section-actions" data-reveal style="--reveal-delay: 160ms">
        <a class="button" href="/products/">View full catalogue</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .category-intro {
    max-width: 46rem;
    margin-block: 1.75rem;
    color: var(--ink-dim);
  }

  .category-intro p {
    margin-bottom: 0;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
    margin-top: 1.75rem;
  }
</style>
