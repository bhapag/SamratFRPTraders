---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CatalogCard from '../../components/CatalogCard.astro';
import CategoryHubDetail from '../../components/product/CategoryHubDetail.astro';
import { getGroup, productHref, productsInGroup } from '../../data/products.js';
import { productImageAlt } from '../../utils/product-page.js';
import Base from '../../layouts/Base.astro';

const group = getGroup('gelcoat');
const items = productsInGroup('gelcoat');
---
<Base
  lang="ne"
  title="Gelcoat — नेपालमा आपूर्तिकर्ता"
  description="नेपालका खरिदकर्ताका लागि Samrat FRP Traders ले आपूर्ति तथा आयात गर्ने gelcoat उत्पादनहरू — FRP भागको साँचोमा बन्ने सतह तह, सामान्य प्रयोजन र isophthalic दुवै बाटोमा।"
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">उत्पादन वर्ग</p>
      <h1>{group.name}</h1>
      <p class="page-lead">नेपाल बजारका लागि आपूर्ति तथा आयात गरिने gelcoat परिवार।</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Breadcrumbs
        items={[
          { label: 'गृहपृष्ठ', href: '/' },
          { label: 'उत्पादनहरू', href: '/products/' },
          { label: group.name },
        ]}
      />

      <div class="category-intro" data-reveal>
        <p>
          Gelcoat सबैभन्दा पहिले, कुनै glass वा laminating resin अघि नै साँचोको सतहमा जान्छ।
          भाग निकाल्दा ग्राहकले देख्ने, सफा गर्ने र मौसम खप्ने अनुहार त्यही हुन्छ; संरचनात्मक
          सबै कुरा त्यसको पछाडि रहन्छ। यही क्रमले यस वर्गलाई laminating resin बाट छुट्याउँछ:
          यहाँ कुनै पनि उत्पादनले भार बोक्दैन, र बाक्लो gelcoat ले भाग बलियो बनाउँदैन।
        </p>
        <p>
          यस परिवारमा दुई बाटो छन् र फरक संरचनाको acid मा छ। GP Gelcoat Resin सामान्य प्रयोजनको
          orthophthalic बाटो हो र यसका supplier Technical Data Sheet तथा Safety Data Sheet फाइलमा छन्।
          ISO Gelcoat isophthalic बाटो हो, जुन सतहले बाहिर चमक टिकाउनुपर्ने वा सधैँ भिजेको सेवामा
          राम्रो रहनुपर्ने ठाउँमा उद्योगले तोक्छ। त्यस grade को supplier कागजात हाम्रो पुस्तकालयमा
          अझै छैन, त्यसैले यस साइटमा त्यसका कुनै अंक प्रकाशित छैनन्।
        </p>
        <p>
          रङ लागेर जमेपछि यी दुई आँखाले छुट्याउन सकिँदैन — त्यसैले ग्राहकले isophthalic बाटो
          मागेको छ भने त्यो निरीक्षणले होइन, कागजात र traceability ले बोक्छ। Samrat FRP Traders ले
          दुवै नेपाली बजारका लागि व्यापारी, आपूर्तिकर्ता, आयातकर्ता र पुनर्विक्रेताको हैसियतले
          आपूर्ति र आयात गर्दछ।
        </p>
      </div>

      <div class="category-grid" data-reveal style="--reveal-delay: 80ms">
        {items.map((product) => (
          <CatalogCard
            name={product.name}
            eyebrow={group.name}
            href={`/products/${product.slug}/`}
            showMedia
            image={product.images?.[0]}
            imageAlt={productImageAlt(product, true)}
            ctaLabel="उत्पादन हेर्नुहोस्"
          />
        ))}
      </div>

      <CategoryHubDetail groupSlug="gelcoat" lang="ne" />

      <div class="section-actions" data-reveal style="--reveal-delay: 160ms">
        <a class="button" href="/resources/what-is-gelcoat/">Gelcoat के हो?</a>
        <a class="button" href="/products/">पूरा उत्पादन सूची</a>
        <a class="button" href="/contact/">सोधपुछ पठाउनुहोस्</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    min-height: clamp(14rem, 26vh, 19rem);
  }

  .page-hero-content {
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
  }

  .section:first-of-type {
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .category-intro {
    max-width: 46rem;
    margin-block: 1.25rem;
    color: var(--ink-dim);
  }

  .category-intro p {
    margin-bottom: 0;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
    margin-top: 1.75rem;
  }
</style>
