---
import { buildContactWhatsAppLink, site, whatsAppMessages } from '../data/site.js';
import Base from '../layouts/Base.astro';
---
<Base
  lang="ne"
  title="सम्पर्क — विराटनगर, नेपाल"
  description="Samrat FRP Traders लाई सम्पर्क गर्नुहोस् — विराटनगर, नेपाल। WhatsApp: +977 9805526904, इमेल: samratfrptraders@gmail.com।"
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">सम्पर्क</p>
      <h1>सोधपुछ <span class="metal-text">पठाउनुहोस्।</span></h1>
      <p class="page-lead">
        WhatsApp, फोन वा इमेलबाट सिधा सम्पर्क गर्नुहोस् — मूल्य: अनुरोधमा।
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-info" data-reveal>
        <p class="eyebrow">सम्पर्क विवरण</p>
        <h2>Samrat FRP Traders</h2>
        <p class="contact-lead">
          {site.business.addressLine1}, {site.business.city}, {site.business.country}
        </p>

        <div class="contact-methods">
          {site.business.contactNumbers.map((contact) => (
            <div class="contact-number-actions">
              <a class="contact-method" href={`tel:${contact.tel}`}>
                <svg class="contact-method-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                <span class="contact-method-text">
                  <span class="contact-method-label">फोन · {contact.countryNe}</span>
                  <span class="contact-method-value">{contact.phone}</span>
                </span>
              </a>
              <a class="contact-method contact-method-wa" href={buildContactWhatsAppLink(contact.whatsapp, whatsAppMessages.generic.ne)} target="_blank" rel="noopener">
                <svg class="contact-method-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2s-.8.9-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.5c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 1.9 3 4.7 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15l-1.3 4.7L7 20.4A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z" /></svg>
                <span class="contact-method-text">
                  <span class="contact-method-label">WhatsApp · {contact.countryNe}</span>
                  <span class="contact-method-value">{contact.phone}</span>
                </span>
              </a>
            </div>
          ))}
          <a class="contact-method" href={`mailto:${site.business.email}`}>
            <svg class="contact-method-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m2 6 10 7 10-7" /></svg>
            <span class="contact-method-text">
              <span class="contact-method-label">इमेल</span>
              <span class="contact-method-value">{site.business.email}</span>
            </span>
          </a>
        </div>

        <div class="contact-catalogue-note">
          <p class="contact-catalogue-heading">पूर्ण उत्पादन दायरा चाहिन्छ?</p>
          <p class="contact-catalogue-desc">नवीनतम Samrat FRP Traders उत्पादन क्याटलग डाउनलोड गर्नुहोस्।</p>
          <a
            class="contact-catalogue-link"
            href="/downloads/samrat-frp-traders-product-catalogue.pdf"
            target="_blank"
            rel="noopener"
            download
            aria-label="Samrat FRP Traders उत्पादन क्याटलग (PDF) डाउनलोड गर्नुहोस्"
          >
            उत्पादन क्याटलग डाउनलोड गर्नुहोस् →
          </a>
        </div>

        <div class="contact-lines" aria-label="व्यावसायिक विवरण">
          <div>
            <span>ठेगाना</span>
            <strong>{site.business.addressLine1}, {site.business.city}, {site.business.country}</strong>
          </div>
          {site.business.contactNumbers.map((contact) => (
            <div>
              <span>फोन · {contact.countryNe}</span>
              <strong>{contact.phone}</strong>
            </div>
          ))}
          <div>
            <span>इमेल</span>
            <strong>{site.business.email}</strong>
          </div>
          <div>
            <span>PAN</span>
            <strong>{site.business.pan}</strong>
          </div>
          <div>
            <span>VAT</span>
            <strong>{site.business.vat}</strong>
          </div>
          <div>
            <span>EXIM कोड</span>
            <strong>{site.business.exim}</strong>
          </div>
        </div>
      </div>

      <div class="form-panel" data-reveal style="--reveal-delay: 140ms">
        <p class="form-note">
          फारम पेस गर्दा +977 9805526904 मा छोटो WhatsApp सोधपुछ खुल्छ। यो फारमले कुनै पनि डेटा अन्यत्र पठाउँदैन।
        </p>

        <form class="form-shell" id="waForm" data-wa-message={whatsAppMessages.generic.ne}>
          <legend>सोधपुछ फारम</legend>
          <div class="form-grid">
            <label>
              <span>नाम</span>
              <input type="text" name="name" required autocomplete="name" placeholder="तपाईंको नाम" />
            </label>
            <label>
              <span>कम्पनी</span>
              <input type="text" name="company" autocomplete="organization" placeholder="कम्पनीको नाम (वैकल्पिक)" />
            </label>
          </div>
          <label>
            <span>उत्पादन / आवश्यकता</span>
            <input type="text" name="product" autocomplete="off" placeholder="जस्तै: GP Clear Resin, Glass Fiber Mat…" />
          </label>
          <label>
            <span>परिमाण</span>
            <input type="text" name="quantity" autocomplete="off" placeholder="जस्तै: अनुमानित परिमाण, ड्रम/प्याकेजिङ…" />
          </label>
          <label>
            <span>सन्देश</span>
            <textarea name="message" rows="5" autocomplete="off" placeholder="आफ्नो आवश्यकता लेख्नुहोस्"></textarea>
          </label>
          <button class="button button-primary" type="submit">WhatsApp मा खोल्नुहोस्</button>
        </form>
      </div>
    </div>
  </section>

  <script define:vars={{ waNumber: site.business.whatsapp }}>
    const form = document.getElementById('waForm');
    if (form && form.dataset.wired !== 'true') {
      form.dataset.wired = 'true';
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        window.open(
          'https://wa.me/' + waNumber + '?text=' + encodeURIComponent(form.dataset.waMessage || ''),
          '_blank',
          'noopener',
        );
      });
    }
  </script>
</Base>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }

  .contact-info h2 {
    max-width: 18ch;
    margin-top: 0.7rem;
  }

  .contact-lead {
    max-width: 42rem;
    color: var(--ink-dim);
  }

  .contact-methods {
    display: grid;
    gap: 0.7rem;
    margin: 1.6rem 0 2rem;
  }

  .contact-number-actions {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.7rem;
  }

  .contact-method {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.1rem;
    border: 1px solid var(--line);
    background: var(--bg-3);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 200ms var(--ease-premium), transform 200ms var(--ease-premium), background 200ms var(--ease-premium);
  }

  .contact-method:hover {
    transform: translateX(0.2rem);
    border-color: var(--line-2);
    background: color-mix(in srgb, var(--ink) 3%, var(--bg-3));
  }

  .contact-method-icon {
    flex-shrink: 0;
    color: var(--accent-gold);
  }

  .contact-method-wa {
    border-color: rgba(37, 211, 102, 0.35);
  }

  .contact-method-wa:hover {
    border-color: rgba(37, 211, 102, 0.7);
    background: rgba(37, 211, 102, 0.06);
  }

  .contact-method-wa .contact-method-icon {
    color: #25d366;
  }

  .contact-method-text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .contact-method-label {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-method-value {
    overflow: hidden;
    font-size: 0.94rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact-catalogue-note {
    margin-bottom: 2rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    background: var(--bg-3);
  }

  .contact-catalogue-heading {
    margin: 0;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .contact-catalogue-desc {
    margin: 0.4rem 0 0.6rem;
    color: var(--ink-dim);
    font-size: 0.85rem;
  }

  .contact-catalogue-link {
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  .contact-catalogue-link:hover {
    color: var(--accent-gold);
  }

  .contact-lines {
    border-block: 1px solid var(--line);
  }

  .contact-lines div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
  }

  .contact-lines div:last-child {
    border-bottom: 0;
  }

  .contact-lines span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-lines strong {
    color: var(--ink);
    font-size: 0.9rem;
  }

  .form-panel {
    display: grid;
    gap: 1.3rem;
    padding: clamp(1.2rem, 4vw, 2rem);
    border: 1px solid var(--line);
    background: var(--bg-3);
    box-shadow: var(--surface-shadow-rest);
  }

  .form-note {
    margin: 0;
    padding: 1rem 1.1rem;
    border-left: 0.25rem solid var(--accent-gold);
    background: rgba(var(--gold-rgb), 0.06);
    color: var(--ink-dim);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .form-shell {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .form-shell legend {
    width: 100%;
    margin-bottom: 0.2rem;
    padding: 0 0 0.8rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-shell label {
    display: grid;
    gap: 0.4rem;
  }

  .form-shell label span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .form-shell input,
  .form-shell textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: 0;
    background: var(--bg);
    color: var(--ink);
  }

  @media (max-width: 48rem) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32rem) {
    .contact-number-actions {
      grid-template-columns: 1fr;
    }

    .contact-lines div {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
