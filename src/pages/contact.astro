---
import { buildWhatsAppLink, site, whatsAppMessages } from '../data/site.js';
import Base from '../layouts/Base.astro';
---
<Base
  lang="ne"
  title="सम्पर्क"
  description="Samrat FRP Traders लाई सम्पर्क गर्नुहोस् — विराटनगर, नेपाल। WhatsApp: +977 9805526904, इमेल: samratfrptraders@gmail.com।"
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">सम्पर्क</p>
      <h1>सोधपुछ <span class="metal-text">पठाउनुहोस्।</span></h1>
      <p class="page-lead">
        WhatsApp, फोन वा इमेलबाट सिधा सम्पर्क गर्नुहोस् — मूल्य: अनुरोधमा।
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-info" data-reveal>
        <p class="eyebrow">सम्पर्क विवरण</p>
        <h2>Samrat FRP Traders</h2>
        <p class="contact-lead">
          {site.business.addressLine1}, {site.business.city}, {site.business.country}
        </p>

        <div class="contact-actions">
          <a
            class="button button-primary"
            href={buildWhatsAppLink(whatsAppMessages.ne)}
            target="_blank"
            rel="noopener"
          >
            WhatsApp
          </a>
          <a class="button" href={`tel:${site.business.tel}`}>{site.business.phone}</a>
          <a class="button" href={`mailto:${site.business.email}`}>इमेल</a>
        </div>

        <div class="contact-catalogue-note">
          <p class="contact-catalogue-heading">पूर्ण उत्पादन दायरा चाहिन्छ?</p>
          <p class="contact-catalogue-desc">नवीनतम Samrat FRP Traders उत्पादन क्याटलग डाउनलोड गर्नुहोस्।</p>
          <a
            class="contact-catalogue-link"
            href="/downloads/samrat-frp-traders-product-catalogue.pdf"
            target="_blank"
            rel="noopener"
            download
            aria-label="Samrat FRP Traders उत्पादन क्याटलग (PDF) डाउनलोड गर्नुहोस्"
          >
            📘 उत्पादन क्याटलग डाउनलोड गर्नुहोस्
          </a>
        </div>

        <div class="contact-lines" aria-label="व्यावसायिक विवरण">
          <div>
            <span>ठेगाना</span>
            <strong>{site.business.addressLine1}, {site.business.city}, {site.business.country}</strong>
          </div>
          <div>
            <span>फोन / WhatsApp</span>
            <strong>{site.business.phone}</strong>
          </div>
          <div>
            <span>इमेल</span>
            <strong>{site.business.email}</strong>
          </div>
          <div>
            <span>PAN</span>
            <strong>{site.business.pan}</strong>
          </div>
          <div>
            <span>VAT</span>
            <strong>{site.business.vat}</strong>
          </div>
          <div>
            <span>EXIM कोड</span>
            <strong>{site.business.exim}</strong>
          </div>
        </div>
      </div>

      <div class="form-panel" data-reveal style="--reveal-delay: 140ms">
        <p class="form-note">
          फारम भरेर पेस गर्दा तपाईंको जानकारीसहित WhatsApp खुल्छ — सोधपुछ सिधै
          +977 9805526904 मा पठाउन सकिन्छ। यो फारमले कुनै पनि डेटा अन्यत्र पठाउँदैन।
        </p>

        <form class="form-shell" id="waForm">
          <legend>सोधपुछ फारम</legend>
          <div class="form-grid">
            <label>
              <span>नाम</span>
              <input type="text" name="name" required placeholder="तपाईंको नाम" />
            </label>
            <label>
              <span>कम्पनी</span>
              <input type="text" name="company" placeholder="कम्पनीको नाम (वैकल्पिक)" />
            </label>
          </div>
          <label>
            <span>उत्पादन / आवश्यकता</span>
            <input type="text" name="product" placeholder="जस्तै: GP Clear Resin, Glass Fiber Mat…" />
          </label>
          <label>
            <span>परिमाण</span>
            <input type="text" name="quantity" placeholder="जस्तै: अनुमानित परिमाण, ड्रम/प्याकेजिङ" />
          </label>
          <label>
            <span>सन्देश</span>
            <textarea name="message" rows="5" placeholder="आफ्नो आवश्यकता लेख्नुहोस्"></textarea>
          </label>
          <button class="button button-primary" type="submit">WhatsApp मा खोल्नुहोस्</button>
        </form>
      </div>
    </div>
  </section>

  <script define:vars={{ waNumber: site.business.whatsapp }}>
    const form = document.getElementById('waForm');
    if (form && form.dataset.wired !== 'true') {
      form.dataset.wired = 'true';
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const fd = new FormData(form);
        const lines = [
          'नमस्ते, म Samrat FRP Traders लाई सम्पर्क गर्न चाहन्छु।',
          'नाम: ' + (fd.get('name') || ''),
          'कम्पनी: ' + (fd.get('company') || ''),
          'उत्पादन: ' + (fd.get('product') || ''),
          'परिमाण: ' + (fd.get('quantity') || ''),
          'सन्देश: ' + (fd.get('message') || ''),
        ].filter((line) => !line.endsWith(': '));
        window.open(
          'https://wa.me/' + waNumber + '?text=' + encodeURIComponent(lines.join('\n')),
          '_blank',
          'noopener',
        );
      });
    }
  </script>
</Base>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }

  .contact-info h2 {
    max-width: 18ch;
    margin-top: 0.7rem;
  }

  .contact-lead {
    max-width: 42rem;
    color: var(--ink-dim);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 1.4rem 0 2rem;
  }

  .contact-catalogue-note {
    margin-bottom: 2rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    background: var(--bg-3);
  }

  .contact-catalogue-heading {
    margin: 0;
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .contact-catalogue-desc {
    margin: 0.4rem 0 0.6rem;
    color: var(--ink-dim);
    font-size: 0.85rem;
  }

  .contact-catalogue-link {
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  .contact-catalogue-link:hover {
    color: var(--accent-gold);
  }

  .contact-lines {
    border-block: 1px solid var(--line);
  }

  .contact-lines div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
  }

  .contact-lines div:last-child {
    border-bottom: 0;
  }

  .contact-lines span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .contact-lines strong {
    color: var(--ink);
    font-size: 0.9rem;
  }

  .form-panel {
    display: grid;
    gap: 1.3rem;
    padding: clamp(1.2rem, 4vw, 2rem);
    border: 1px solid var(--line);
    background: var(--bg-3);
    box-shadow: var(--surface-shadow-rest);
  }

  .form-note {
    margin: 0;
    padding: 1rem 1.1rem;
    border-left: 0.25rem solid var(--accent-gold);
    background: rgba(var(--gold-rgb), 0.06);
    color: var(--ink-dim);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .form-shell {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .form-shell legend {
    width: 100%;
    margin-bottom: 0.2rem;
    padding: 0 0 0.8rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-shell label {
    display: grid;
    gap: 0.4rem;
  }

  .form-shell label span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .form-shell input,
  .form-shell textarea {
    width: 100%;
    padding: 0.8rem 0.9rem;
    border: 1px solid var(--line-2);
    border-radius: 0;
    background: var(--bg);
    color: var(--ink);
  }

  @media (max-width: 48rem) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32rem) {
    .contact-lines div {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
