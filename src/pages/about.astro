---
import BusinessDetails from '../components/home/BusinessDetails.astro';
import { buildWhatsAppLink, whatsAppMessages } from '../data/site.js';
import { catalogGroups, products } from '../data/products.js';
import { applications } from '../data/applications.js';
import { resources } from '../data/resources.js';
import Base from '../layouts/Base.astro';

const applicationCount = applications.filter((a) => !a.draft).length;
const resourceCount = resources.filter((r) => !r.draft).length;
const docCount = products.reduce((sum, p) => sum + (p.documents ? p.documents.length : 0), 0);
---
<Base
  lang="ne"
  title="हाम्रोबारे — विराटनगर, नेपाल"
  description="Samrat FRP Traders विराटनगर, नेपालबाट सञ्चालित व्यापारी, आपूर्तिकर्ता, आयातकर्ता र पुनर्विक्रेता हो — नेपालभर FRP सामग्री तथा औद्योगिक रेजिन आपूर्ति।"
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">हाम्रोबारे</p>
      <h1>विराटनगरबाट <span class="metal-text">नेपालभर।</span></h1>
      <p class="page-lead">
        Samrat FRP Traders नेपालका खरिदकर्ताहरूका लागि FRP सामग्री तथा औद्योगिक रेजिन आपूर्ति गर्ने
        व्यापारी, आपूर्तिकर्ता, आयातकर्ता र पुनर्विक्रेता हो।
      </p>
    </div>
  </section>

  <div class="container">
    <div class="about-stats" data-reveal>
      <div class="stat">
        <span class="stat-num">{products.length}</span>
        <span class="stat-label">उत्पादनहरू</span>
      </div>
      <div class="stat">
        <span class="stat-num">{catalogGroups.length}</span>
        <span class="stat-label">उत्पादन वर्ग</span>
      </div>
      <div class="stat">
        <span class="stat-num">{applicationCount}</span>
        <span class="stat-label">प्रयोग गाइड</span>
      </div>
      <div class="stat">
        <span class="stat-num">{resourceCount}</span>
        <span class="stat-label">प्राविधिक स्रोत</span>
      </div>
      <div class="stat">
        <span class="stat-num">{docCount}</span>
        <span class="stat-label">TDS / SDS कागजात</span>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container about-layout">
      <div class="copy-stack" data-reveal>
        <div class="section-heading">
          <p class="eyebrow">व्यावसायिक भूमिका</p>
          <h2>व्यापारी · आपूर्तिकर्ता · आयातकर्ता · पुनर्विक्रेता।</h2>
        </div>

        <p>
          Samrat FRP Traders (दर्ता नाम: M/s SAMRAT F.R.P TRADERS) विराटनगर, नेपालमा आधारित व्यवसाय हो।
          हामी नेपालभरका खरिदकर्ताहरूलाई polyester resin, gelcoat, glass fiber, hardener, epoxy प्रणाली
          र सम्बन्धित FRP सामग्री आपूर्ति तथा आयात गर्दछौँ — प्रत्येक उत्पादनसँग आपूर्तिकर्ताले जारी
          गरेका TDS र SDS कागजात।
        </p>
        <p>
          Samrat Poly Resins, India हाम्रा resin र सम्बन्धित FRP सामग्रीका लागि विश्वसनीय आपूर्तिकर्ता हो।
          आपूर्तिकर्ताको उत्पादन सन्दर्भ मिडिया (फोटो/भिडियो) Samrat Poly Resins को हो — यसले
          Samrat FRP Traders को भौतिक संरचना जनाउँदैन।
        </p>
        <p>
          हामी {products.length} उत्पादनको सूची, {applicationCount} प्रयोग गाइड र {resourceCount} प्राविधिक स्रोत/लेख
          नेपाली र English दुवै भाषामा प्रस्तुत गर्दछौँ — ताकि नेपालका खरिदकर्ताले सही सामग्री छान्न सकून्।
        </p>

        <div class="button-row">
          <a class="button button-primary" href="/products/">उत्पादन सूची हेर्नुहोस्</a>
          <a
            class="button"
            href="/downloads/samrat-frp-traders-product-catalogue.pdf"
            target="_blank"
            rel="noopener"
            download
          >
            उत्पादन क्याटलग (PDF)
          </a>
          <a
            class="button"
            href={buildWhatsAppLink(whatsAppMessages.ne)}
            target="_blank"
            rel="noopener"
          >
            WhatsApp मा सोध्नुहोस्
          </a>
        </div>
      </div>

      <aside class="info-rail" aria-label="व्यावसायिक विवरण" data-reveal style="--reveal-delay: 120ms">
        <div class="info-row">
          <span>व्यावसायिक नाम</span>
          <strong>Samrat FRP Traders</strong>
        </div>
        <div class="info-row">
          <span>आधार स्थान</span>
          <strong>विराटनगर, नेपाल</strong>
        </div>
        <div class="info-row">
          <span>बजार क्षेत्र</span>
          <strong>सम्पूर्ण नेपाल</strong>
        </div>
        <div class="info-row">
          <span>आपूर्ति सम्बन्ध</span>
          <strong>Samrat Poly Resins, India</strong>
        </div>
        <div class="info-row">
          <span>भाषा</span>
          <strong>नेपाली + English</strong>
        </div>
        <div class="info-row">
          <span>मूल्य नीति</span>
          <strong>मूल्य: अनुरोधमा</strong>
        </div>
      </aside>
    </div>
  </section>

  <BusinessDetails lang="ne" />

  <section class="section section-framed">
    <div class="container">
      <div class="section-heading section-heading-split" data-reveal>
        <div>
          <p class="eyebrow">हाम्रो दृष्टिकोण</p>
          <h2>प्राविधिक कागजातसँगै आपूर्ति।</h2>
        </div>
        <p class="section-lead">
          हरेक उत्पादनसँग आपूर्तिकर्ताले जारी गरेका प्राविधिक कागजात — ताकि खरिदकर्ताले के किन्दै छन् भन्ने स्पष्ट होस्।
        </p>
      </div>
      <div class="approach-grid">
        <article data-reveal>
          <span>01</span>
          <h3>पुष्टि भएका तथ्य मात्र</h3>
          <p>उत्पादन विवरण र प्राविधिक मानहरू आपूर्तिकर्ताको कागजातबाट लिइन्छन्; पुष्टि नभएका व्यावसायिक शर्तहरू प्रकाशित गरिँदैनन्।</p>
        </article>
        <article data-reveal style="--reveal-delay: 70ms">
          <span>02</span>
          <h3>TDS र SDS सहित</h3>
          <p>प्रत्येक उत्पादनसँग Technical Data Sheet र Safety Data Sheet को सिधा पहुँच।</p>
        </article>
        <article data-reveal style="--reveal-delay: 140ms">
          <span>03</span>
          <h3>सिधा सोधपुछ</h3>
          <p>WhatsApp, फोन र इमेलबाट सिधा सोधपुछ — मूल्य: अनुरोधमा।</p>
        </article>
        <article data-reveal style="--reveal-delay: 210ms">
          <span>04</span>
          <h3>द्विभाषी जानकारी</h3>
          <p>उत्पादन र प्राविधिक जानकारी नेपाली र English दुवैमा।</p>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Real, build-time-computed counts as a dense data band — the "prove it
     with numbers" opener DESIGN.md calls for, never hand-typed so it can't
     go stale the way the old hardcoded prose count did. */
  .about-stats {
    display: flex;
    flex-wrap: wrap;
    margin-block: clamp(-1rem, -2vw, -0.5rem) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .stat {
    flex: 1 1 8rem;
    padding: 1.6rem 1.5rem;
    border-left: 1px solid var(--line);
  }

  .stat:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .stat-num {
    display: block;
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: clamp(1.7rem, 3.6vw, 2.5rem);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .stat-label {
    display: block;
    margin-top: 0.5rem;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 40rem) {
    .stat {
      flex: 1 1 45%;
      border-left: 0;
      padding-left: 0;
      padding-block: 1.2rem;
    }

    .stat:nth-child(odd) {
      padding-right: 1rem;
    }

    .stat:nth-child(even) {
      padding-left: 1rem;
      border-left: 1px solid var(--line);
    }
  }

  .about-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.8fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }

  .copy-stack > p {
    max-width: 46rem;
    color: var(--ink-dim);
    font-size: 1rem;
    line-height: 1.75;
  }

  .info-rail {
    border: 1px solid var(--line);
    background: var(--bg-2);
    box-shadow: var(--surface-shadow-rest);
  }

  .info-row {
    display: grid;
    gap: 0.35rem;
    padding: 1.2rem 1.3rem;
    border-bottom: 1px solid var(--line);
    transition: background 200ms var(--ease-premium);
  }

  .info-row:hover {
    background: rgba(var(--gold-rgb), 0.04);
  }

  .info-row:last-child {
    border-bottom: 0;
  }

  .info-row span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .info-row strong {
    color: var(--ink);
    font-size: 0.94rem;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .approach-grid article {
    min-height: 13rem;
    padding: 1.4rem;
    background: var(--bg-3);
  }

  .approach-grid span {
    color: var(--accent-gold);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .approach-grid h3 {
    margin-block: 2.4rem 0.65rem;
  }

  .approach-grid p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 0.86rem;
  }

  @media (max-width: 53.75rem) {
    .approach-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 48rem) {
    .about-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32rem) {
    .approach-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
