---
import StatusNotice from '../components/StatusNotice.astro';
import Base from '../layouts/Base.astro';
---
<Base
  title="About"
  description="Samrat FRP Traders is a trader, supplier, importer and reseller serving Nepal. Business facts are stated only where confirmed."
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">About</p>
      <h1>Business facts follow <span class="metal-text">verification.</span></h1>
      <p class="page-lead">
        Samrat FRP Traders is a trader, supplier, importer and reseller serving Nepal.
        Company information remains limited until verified.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container about-layout">
      <div class="copy-stack" data-reveal>
        <div class="section-heading">
          <p class="eyebrow">Current boundary</p>
          <h2>Clear about what is known—and what is not.</h2>
        </div>

        <p>
          Samrat FRP Traders sources its resin and FRP product portfolio from Samrat Poly Resins, India — a trusted supplier.
          Business location, registration, contact details and other commercial facts remain pending verification.
        </p>

        <StatusNotice
          title="Confirmed facts only"
          message="This page states only confirmed business facts. Remaining details are pending verification."
        />

        <a class="button" href="/products/">Browse product catalogue</a>
      </div>

      <aside class="info-rail" aria-label="Current website boundaries" data-reveal style="--reveal-delay: 120ms">
        <div class="info-row">
          <span>Website identity</span>
          <strong>Samrat FRP Traders</strong>
        </div>
        <div class="info-row">
          <span>Current representation</span>
          <strong>Trader / supplier / importer / reseller</strong>
        </div>
        <div class="info-row">
          <span>Supplier relationship</span>
          <strong>Samrat Poly Resins, India</strong>
        </div>
        <div class="info-row">
          <span>Business details</span>
          <strong>Pending verification</strong>
        </div>
        <div class="info-row">
          <span>Publication state</span>
          <strong>Local development</strong>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-framed">
    <div class="container">
      <div class="section-heading section-heading-split" data-reveal>
        <div>
          <p class="eyebrow">Publication requirements</p>
          <h2>Information required before publication</h2>
        </div>
        <p class="section-lead">Each information group needs a confirmed source and approval before it enters customer-facing copy.</p>
      </div>

      <div class="requirement-grid">
        <article data-reveal>
          <span>01</span>
          <h3>Identity</h3>
          <p>Verified legal and trading identity.</p>
        </article>
        <article data-reveal style="--reveal-delay: 70ms">
          <span>02</span>
          <h3>Contact</h3>
          <p>Verified business location and contact channels.</p>
        </article>
        <article data-reveal style="--reveal-delay: 140ms">
          <span>03</span>
          <h3>Supply scope</h3>
          <p>Verified supplier relationships and product scope.</p>
        </article>
        <article data-reveal style="--reveal-delay: 210ms">
          <span>04</span>
          <h3>Policies</h3>
          <p>Approved service, policy, and market information.</p>
        </article>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.8fr);
    gap: clamp(2.5rem, 7vw, 6rem);
    align-items: start;
  }

  .copy-stack > p {
    max-width: 42rem;
    color: var(--ink-dim);
    font-size: 1.02rem;
  }

  .copy-stack .button {
    margin-top: 2rem;
  }

  .info-rail {
    border: 1px solid var(--line);
    background: var(--bg-2);
    box-shadow: var(--surface-shadow-rest);
  }

  .info-row {
    display: grid;
    gap: 0.35rem;
    padding: 1.2rem 1.3rem;
    border-bottom: 1px solid var(--line);
    transition: background 200ms var(--ease-premium);
  }

  .info-row:hover {
    background: rgba(var(--gold-rgb), 0.04);
  }

  .info-row:last-child {
    border-bottom: 0;
  }

  .info-row span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .info-row strong {
    color: var(--ink);
    font-size: 0.94rem;
  }

  .requirement-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .requirement-grid article {
    min-height: 14rem;
    padding: 1.4rem;
    background: var(--bg-3);
  }

  .requirement-grid span {
    color: var(--accent-gold);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .requirement-grid h3 {
    margin-block: 2.6rem 0.65rem;
  }

  .requirement-grid p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 0.86rem;
  }

  @media (max-width: 53.75rem) {
    .requirement-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 48rem) {
    .about-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 32rem) {
    .requirement-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
