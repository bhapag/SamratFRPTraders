---
import ResourceIcon from '../../components/ResourceIcon.astro';
import { resources } from '../../data/resources.js';
import Base from '../../layouts/Base.astro';
import { localizeResource, readingTimeNe } from '../../utils/resource-i18n.js';
import { clusterByProduct, foundationResources } from '../../utils/resource-hub.js';

const published = resources.filter((r) => !r.draft).map((r) => localizeResource(r));
const featured = foundationResources(published);
const featuredSlugs = new Set(featured.map((r) => r.slug));

const { clusters, ungrouped } = clusterByProduct(published);
const nonFeaturedClusters = clusters
  .map((cluster) => ({ ...cluster, resources: cluster.resources.filter((r) => !featuredSlugs.has(r.slug)) }))
  .filter((cluster) => cluster.resources.length > 0);
const nonFeaturedUngrouped = ungrouped.filter((r) => !featuredSlugs.has(r.slug));
---
<Base
  lang="ne"
  title="स्रोतहरू र जानकारी केन्द्र"
  description="नेपालमा FRP सामग्री खरिदकर्ताका लागि स्रोतहरू — छनोट गाइड, तुलना, खरिद चेकलिस्ट र प्राविधिक व्याख्या।"
>
  <section class="page-hero hero-shell">
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="container page-hero-content">
      <p class="eyebrow">जानकारी केन्द्र</p>
      <h1>नेपाली खरिदकर्ताका लागि <span class="metal-text">स्रोतहरू।</span></h1>
      <p class="page-lead">
        FRP सामग्री सूचीका लागि छनोट गाइड, तुलना, खरिद चेकलिस्ट र प्राविधिक व्याख्याहरू — {published.length} गाइड, उत्पादन अनुसार व्यवस्थित।
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="kc-downloads" data-reveal>
        <div>
          <h2 class="kc-downloads-title">Samrat FRP Traders उत्पादन क्याटलग</h2>
          <p class="kc-downloads-desc">हाम्रो पूर्ण FRP सामग्री तथा रेजिन दायरा हेर्नुहोस्।</p>
          <p class="kc-downloads-meta">PDF</p>
        </div>
        <a
          class="button button-primary"
          href="/downloads/samrat-frp-traders-product-catalogue.pdf"
          target="_blank"
          rel="noopener"
          download
          aria-label="Samrat FRP Traders उत्पादन क्याटलग (PDF) डाउनलोड गर्नुहोस्"
        >
          उत्पादन क्याटलग डाउनलोड गर्नुहोस्
        </a>
      </div>

      <nav class="jump-nav" aria-label="उत्पादन अनुसार जानकारी" data-reveal>
        <a href="#featured">फिचर्ड गाइड</a>
        {nonFeaturedClusters.map((cluster) => (
          <a href={`#cluster-${cluster.productSlug}`}>{cluster.productName}</a>
        ))}
        {nonFeaturedUngrouped.length > 0 && <a href="#general">सामान्य गाइड</a>}
      </nav>

      <div class="doc-group" id="featured" data-reveal>
        <header class="doc-group-head">
          <span class="doc-group-index" aria-hidden="true">01</span>
          <div class="doc-group-head-text">
            <h2>फिचर्ड गाइड</h2>
            <p class="doc-group-lead">प्रत्येक उत्पादनको आधारभूत जानकारी — यहीँबाट सुरु गर्नुहोस्।</p>
          </div>
          <span class="doc-group-count">{featured.length} गाइड</span>
        </header>
        <div class="doc-list">
          {featured.map((resource) => (
            <a class="doc-row" href={`/resources/${resource.slug}/`}>
              <span class="doc-row-icon" aria-hidden="true"><ResourceIcon name={resource.icon} /></span>
              <span class="doc-row-main">
                <span class="doc-row-title">{resource.title}</span>
                <span class="doc-row-desc">{resource.description}</span>
              </span>
              <span class="doc-row-time">{readingTimeNe(resource.readingTime)}</span>
              <span class="doc-row-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>

      {nonFeaturedClusters.map((cluster, gi) => (
        <div class="doc-group" id={`cluster-${cluster.productSlug}`} data-reveal>
          <header class="doc-group-head">
            <span class="doc-group-index" aria-hidden="true">{String(gi + 2).padStart(2, '0')}</span>
            <div class="doc-group-head-text">
              <h2>{cluster.productName}</h2>
            </div>
            <span class="doc-group-count">{cluster.resources.length} गाइड</span>
            {cluster.productSlug && (
              <a class="doc-group-link" href={`/products/${cluster.productSlug}/`}>उत्पादन पृष्ठ हेर्नुहोस् →</a>
            )}
          </header>
          <div class="doc-list">
            {cluster.resources.map((resource) => (
              <a class="doc-row" href={`/resources/${resource.slug}/`}>
                <span class="doc-row-icon" aria-hidden="true"><ResourceIcon name={resource.icon} /></span>
                <span class="doc-row-main">
                  <span class="doc-row-title">{resource.title}</span>
                  <span class="doc-row-desc">{resource.description}</span>
                </span>
                <span class="doc-row-time">{readingTimeNe(resource.readingTime)}</span>
                <span class="doc-row-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      ))}

      {nonFeaturedUngrouped.length > 0 && (
        <div class="doc-group" id="general" data-reveal>
          <header class="doc-group-head">
            <span class="doc-group-index" aria-hidden="true">{String(nonFeaturedClusters.length + 2).padStart(2, '0')}</span>
            <div class="doc-group-head-text">
              <h2>सामान्य गाइड</h2>
            </div>
            <span class="doc-group-count">{nonFeaturedUngrouped.length} गाइड</span>
          </header>
          <div class="doc-list">
            {nonFeaturedUngrouped.map((resource) => (
              <a class="doc-row" href={`/resources/${resource.slug}/`}>
                <span class="doc-row-icon" aria-hidden="true"><ResourceIcon name={resource.icon} /></span>
                <span class="doc-row-main">
                  <span class="doc-row-title">{resource.title}</span>
                  <span class="doc-row-desc">{resource.description}</span>
                </span>
                <span class="doc-row-time">{readingTimeNe(resource.readingTime)}</span>
                <span class="doc-row-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .kc-downloads {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
    padding: 1.3rem 1.5rem;
    border: 1px solid rgba(var(--gold-rgb), 0.4);
    border-left-width: 0.26rem;
    background: rgba(var(--gold-rgb), 0.05);
  }

  .kc-downloads-title {
    margin: 0;
    font-size: 1.15rem;
  }

  .kc-downloads-desc {
    margin: 0.3rem 0 0.25rem;
    color: var(--ink-dim);
    font-size: 0.88rem;
  }

  .kc-downloads-meta {
    margin: 0;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .jump-nav {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.75rem;
    row-gap: 0.6rem;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--line);
  }

  .jump-nav a {
    padding-block: 0.3rem;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms var(--ease-premium);
  }

  .jump-nav a:hover {
    color: var(--accent-gold-light);
  }

  /* ---------- Document index: a reading list, not a card wall ----------
     Deliberately typographic — dense hairline-separated rows rather than
     boxed cards, so this reads as a technical library/archive rather than
     a third pass at the same card treatment used on Products/Applications. */
  .doc-group {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
    scroll-margin-top: 5.5rem;
  }

  .doc-group:last-child {
    margin-bottom: 0;
  }

  .doc-group-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem 1.1rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(var(--gold-rgb), 0.22);
  }

  .doc-group-index {
    color: var(--accent-gold);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }

  .doc-group-head-text h2 {
    margin: 0;
    font-size: clamp(1.4rem, 3.4vw, 1.85rem);
  }

  .doc-group-lead {
    max-width: 46ch;
    margin: 0.3rem 0 0;
    color: var(--ink-dim);
    font-size: 0.86rem;
  }

  .doc-group-count {
    margin-left: auto;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .doc-group-link {
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms var(--ease-premium);
  }

  .doc-group-link:hover {
    color: var(--accent-gold);
  }

  .doc-list {
    display: flex;
    flex-direction: column;
  }

  .doc-row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.1rem;
    padding: 1.1rem 0.9rem;
    padding-left: 1.15rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: background 200ms var(--ease-premium);
  }

  .doc-row::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0.2rem;
    background: transparent;
    transition: background 200ms var(--ease-premium);
  }

  .doc-row:hover,
  .doc-row:focus-visible {
    background: rgba(var(--gold-rgb), 0.045);
  }

  .doc-row:hover::before,
  .doc-row:focus-visible::before {
    background: var(--accent-gold);
  }

  .doc-row:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: -2px;
  }

  .doc-row-icon {
    display: flex;
    color: var(--accent-gold);
    opacity: 0.85;
  }

  .doc-row-icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .doc-row-main {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .doc-row-title {
    font-size: 0.98rem;
    font-weight: 600;
  }

  .doc-row-desc {
    overflow: hidden;
    max-width: 60ch;
    color: var(--ink-faint);
    font-size: 0.82rem;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .doc-row-time {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .doc-row-arrow {
    color: var(--accent-gold);
    font-size: 1rem;
    transition: transform 200ms var(--ease-premium);
  }

  .doc-row:hover .doc-row-arrow,
  .doc-row:focus-visible .doc-row-arrow {
    transform: translateX(0.25rem);
  }

  @media (max-width: 40rem) {
    .doc-row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      row-gap: 0.3rem;
    }

    .doc-row-time {
      grid-column: 2;
      grid-row: 2;
    }

    .doc-row-desc {
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
  }
</style>
