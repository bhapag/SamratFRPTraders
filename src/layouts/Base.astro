---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { buildCanonicalUrl, site } from '../data/site.js';
import '../styles/global.css';
import '../styles/foundation.css';

const {
  title,
  description = site.description,
  noindex = true,
  canonical = true,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.descriptor}`;
const canonicalUrl = canonical ? buildCanonicalUrl(Astro.url.pathname) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d0f12" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <script is:inline>
      // Opt-in hook for the scroll-reveal system. Only added when the user
      // has not requested reduced motion, so content is never hidden for
      // users who prefer less motion (and never hidden without JavaScript).
      (function () {
        var motion = window.matchMedia
          ? window.matchMedia('(prefers-reduced-motion: reduce)')
          : null;
        if (motion && !motion.matches) {
          document.documentElement.classList.add('js-reveal');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { initReveal } from '../scripts/reveal.js';
      initReveal();
    </script>
  </body>
</html>
