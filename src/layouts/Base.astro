---
import { buildCanonicalUrl, buildWhatsAppLink, site, whatsAppMessages } from '../data/site.js';
import { catalogGroups, products, productsInGroup } from '../data/products.js';
import AmbientBackground from '../components/AmbientBackground.astro';
import '../styles/global.css';
import '../styles/foundation.css';

const {
  title,
  description = site.description,
  noindex = false,
  canonical = true,
  lang = 'en',
  ogImage,
  ogImageWidth,
  ogImageHeight,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.descriptor}`;
const canonicalUrl = canonical ? buildCanonicalUrl(Astro.url.pathname) : undefined;
const socialImageUrl = buildCanonicalUrl(ogImage ?? '/brand/og-default.png');
const socialImageWidth = ogImageWidth ?? 1200;
const socialImageHeight = ogImageHeight ?? 630;
const path = Astro.url.pathname;
const isNe = lang === 'ne';
const isHome = path === '/' || path === '/en/';
const is404 = /\/404\/?$/.test(path);
const altPath = is404
  ? (isNe ? '/en/' : '/')
  : isNe
    ? (path === '/' ? '/en/' : `/en${path}`)
    : path.replace(/^\/en/, '') || '/';
// Site-relative paths — used for the actual clickable language-switcher
// links, so navigation always stays on the current origin (localhost in
// dev, the real domain in production) instead of hard-jumping to the
// production host regardless of where the page is being served from.
const enPath = is404 ? '/en/' : isNe ? altPath : path;
const nePath = is404 ? '/' : isNe ? path : altPath;
// Absolute production URLs — required for hreflang/canonical/og:url, which
// must always resolve against the real domain regardless of dev host.
const enUrl = buildCanonicalUrl(enPath);
const neUrl = buildCanonicalUrl(nePath);
const waLink = buildWhatsAppLink(isNe ? whatsAppMessages.ne : whatsAppMessages.en);
const prefix = isNe ? '' : '/en';

const nav = isNe
  ? [
      { href: '/', label: 'गृहपृष्ठ' },
      { href: '/products/', label: 'उत्पादनहरू', key: 'products' },
      { href: '/applications/', label: 'प्रयोगहरू' },
      { href: '/resources/', label: 'जानकारी केन्द्र' },
      { href: '/about/', label: 'हाम्रोबारे' },
      { href: '/contact/', label: 'सम्पर्क' },
    ]
  : [
      { href: '/en/', label: 'Home' },
      { href: '/en/products/', label: 'Products', key: 'products' },
      { href: '/en/applications/', label: 'Applications' },
      { href: '/en/resources/', label: 'Resources' },
      { href: '/en/about/', label: 'About' },
      { href: '/en/contact/', label: 'Contact' },
    ];

// Mega-menu product families: the 2 groups with a dedicated category page
// link there directly; the other 6 (navigation-only, no category URL) link
// to their anchor block on the product index instead. Counts are computed
// from the live catalogue, never hand-typed.
const featuredGroups = catalogGroups.filter((g) => g.indexable);
const otherGroups = catalogGroups.filter((g) => !g.indexable);
const productsIndexHref = `${prefix}/products/`;
const totalDocs = products.reduce((sum, p) => sum + (p.documents ? p.documents.length : 0), 0);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d0f12" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {!is404 && <link rel="alternate" hreflang="en-NP" href={enUrl} />}
    {!is404 && <link rel="alternate" hreflang="ne-NP" href={neUrl} />}
    {!is404 && <link rel="alternate" hreflang="x-default" href={neUrl} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={isNe ? 'ne_NP' : 'en_NP'} />
    {!is404 && <meta property="og:locale:alternate" content={isNe ? 'en_NP' : 'ne_NP'} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={socialImageWidth} />
    <meta property="og:image:height" content={socialImageHeight} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': ['Organization', 'LocalBusiness'],
      name: site.name,
      legalName: site.legalName,
      url: site.url,
      logo: `${site.url}brand/samrat-frp-traders-logo.png`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.business.addressLine1,
        addressLocality: site.business.city,
        addressCountry: site.business.country,
      },
      telephone: site.business.tel,
      contactPoint: site.business.contactNumbers.map((contact) => ({
        '@type': 'ContactPoint',
        contactType: 'sales',
        telephone: contact.tel,
        email: site.business.email,
        availableLanguage: ['en', 'ne'],
      })),
    })} />
    <script is:inline>
      // Opt-in hook for the scroll-reveal system. Only added when the user
      // has not requested reduced motion, so content is never hidden for
      // users who prefer less motion (and never hidden without JavaScript).
      (function () {
        var motion = window.matchMedia
          ? window.matchMedia('(prefers-reduced-motion: reduce)')
          : null;
        if (motion && !motion.matches) {
          document.documentElement.classList.add('js-reveal');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class:list={['site-header', { 'site-header-hero': isHome }]} id="siteHeader">
      <div class="container header-inner">
        <a class="brand" href={isNe ? '/' : '/en/'}>
          <span class="brand-badge">
            <img
              class="brand-logo-full"
              src="/brand/samrat-frp-traders-logo.png"
              alt="Samrat FRP Traders logo"
              width="900"
              height="741"
            />
            <img
              class="brand-logo-mark"
              src="/brand/samrat-frp-traders-mark.png"
              alt=""
              width="320"
              height="320"
            />
          </span>
          <span class="brand-text">
            <span class="brand-name">Samrat FRP Traders</span>
            <span class="brand-descriptor">FRP materials · Nepal</span>
          </span>
        </a>
        <nav class="site-nav" aria-label={isNe ? 'मुख्य नेभिगेसन' : 'Primary navigation'}>
          {nav.map((item) =>
            item.key === 'products' ? (
              <div class="nav-mega">
                <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                  {item.label}
                  <svg class="nav-mega-caret" viewBox="0 0 10 6" width="10" height="6" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
                <div class="mega-panel">
                  <div class="mega-panel-inner">
                    <div class="mega-col mega-col-featured">
                      <p class="mega-col-label">{isNe ? 'मुख्य श्रेणी' : 'Category pages'}</p>
                      {featuredGroups.map((group) => (
                        <a class="mega-featured-link" href={`${prefix}/products/${group.slug}/`}>
                          <span class="mega-featured-name">{group.name}</span>
                          <span class="mega-featured-summary">{group.summary}</span>
                          <span class="mega-featured-count">
                            {productsInGroup(group.slug).length} {isNe ? 'उत्पादन' : 'products'}
                          </span>
                        </a>
                      ))}
                    </div>
                    <div class="mega-col mega-col-other">
                      <p class="mega-col-label">{isNe ? 'हाम्रो दायरामा पनि' : 'Also in our range'}</p>
                      <ul class="mega-other-list">
                        {otherGroups.map((group) => (
                          <li>
                            <a href={`${productsIndexHref}#${group.slug}`}>
                              <span>{group.name}</span>
                              <span class="mega-other-count">{productsInGroup(group.slug).length}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                  <div class="mega-panel-foot">
                    <span class="mega-panel-stat">
                      {products.length} {isNe ? 'उत्पादन' : 'products'} · {totalDocs} TDS/SDS
                    </span>
                    <a class="mega-panel-all" href={productsIndexHref}>
                      {isNe ? 'सम्पूर्ण उत्पादन सूची हेर्नुहोस्' : 'View the full catalogue'} →
                    </a>
                  </div>
                </div>
              </div>
            ) : (
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            )
          )}
        </nav>
        <div class="header-actions">
          <div class="lang-toggle" role="group" aria-label={isNe ? 'भाषा' : 'Language'}>
            <a href={nePath} lang="ne" aria-current={isNe ? 'true' : undefined}>NE</a>
            <a href={enPath} lang="en" aria-current={!isNe ? 'true' : undefined}>EN</a>
          </div>
          <a href={waLink} class="nav-enquire" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2s-.8.9-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.5c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 1.9 3 4.7 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15l-1.3 4.7L7 20.4A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z" /></svg>
            {isNe ? 'सोधपुछ' : 'Enquire'}
          </a>
        </div>
        <div class="lang-toggle mobile-top-lang-toggle" role="group" aria-label={isNe ? 'भाषा' : 'Language'}>
          <a href={nePath} lang="ne" aria-current={isNe ? 'true' : undefined}>NE</a>
          <a href={enPath} lang="en" aria-current={!isNe ? 'true' : undefined}>EN</a>
        </div>
        <button type="button" class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="mobileNav" aria-label={isNe ? 'मेनु खोल्नुहोस्' : 'Open menu'}>
          <span class="nav-toggle-bar" aria-hidden="true"></span>
          <span class="nav-toggle-bar" aria-hidden="true"></span>
          <span class="nav-toggle-bar" aria-hidden="true"></span>
        </button>
      </div>
    </header>

    <!-- Deliberately a sibling of <header>, not nested inside it: the header
         has `backdrop-filter`, which (like `transform`) creates a containing
         block for `position: fixed` descendants — a fixed child would then
         be sized/positioned against the ~4.5rem header box instead of the
         viewport. Living outside it, this overlay's `inset: 0` is viewport-relative. -->
    <div class="mobile-nav" id="mobileNav">
      <nav class="mobile-nav-links" aria-label={isNe ? 'मोबाइल नेभिगेसन' : 'Mobile navigation'}>
        {nav.map((item, index) => (
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined} style={`--i: ${index}`}>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="mobile-nav-foot">
        <a href={waLink} class="mobile-nav-wa button button-primary" target="_blank" rel="noopener">
          {isNe ? 'WhatsApp मा सोधपुछ' : 'Enquire on WhatsApp'}
        </a>
      </div>
    </div>

    <main id="main-content" class:list={['site-main', { 'site-main-home': isHome }]}>
      {!is404 && <AmbientBackground deferUntilHero={isHome} />}
      <div class="site-main-content">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-col footer-brand-col">
          <span class="footer-badge">
            <img
              src="/brand/samrat-frp-traders-logo.png"
              alt="Samrat FRP Traders logo"
              width="900"
              height="741"
              loading="lazy"
            />
          </span>
          <p class="footer-brand">Samrat FRP Traders</p>
          <p class="footer-descriptor">
            {isNe
              ? 'नेपालभर FRP सामग्री आपूर्तिकर्ता, आयातकर्ता र पुनर्विक्रेता'
              : 'FRP materials trader, supplier, importer and reseller across Nepal'}
          </p>
          <p class="footer-copy">
            {isNe
              ? 'Samrat Poly Resins, India हाम्रो विश्वसनीय आपूर्तिकर्ता हो — resin र सम्बन्धित FRP सामग्रीका लागि।'
              : 'Samrat Poly Resins, India is a trusted supplier to Samrat FRP Traders for resins and related FRP materials.'}
          </p>
          <div class="footer-contact">
            {site.business.contactNumbers.map((contact) => (
              <a href={`tel:${contact.tel}`}>{contact.phone}</a>
            ))}
            <a href="mailto:samratfrptraders@gmail.com">samratfrptraders@gmail.com</a>
            <span>Ward No. 2, Tinpani Chowk, Main Road, Biratnagar, Nepal</span>
          </div>
          <a href={waLink} class="footer-cta" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2s-.8.9-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.5c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 1.9 3 4.7 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15l-1.3 4.7L7 20.4A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z" /></svg>
            {isNe ? 'WhatsApp मा सोधपुछ' : 'Enquire on WhatsApp'}
          </a>
        </div>
        <div class="footer-col">
          <h2 class="footer-heading">{isNe ? 'उत्पादनहरू' : 'Products'}</h2>
          <nav class="footer-nav" aria-label="Footer products">
            <a href={isNe ? '/products/' : '/en/products/'}>{isNe ? 'सबै उत्पादनहरू' : 'All products'}</a>
            <a href={isNe ? '/products/polyester-resins/' : '/en/products/polyester-resins/'}>{isNe ? 'Polyester रेजिनहरू' : 'Polyester Resins'}</a>
            <a href={isNe ? '/products/epoxy-casting-resins/' : '/en/products/epoxy-casting-resins/'}>{isNe ? 'Epoxy र Casting' : 'Epoxy & Casting Resins'}</a>
            <a href={isNe ? '/products/mekp-hardener/' : '/en/products/mekp-hardener/'}>MEKP Hardener</a>
            <a href={isNe ? '/custom-resin-specification-request/' : '/en/custom-resin-specification-request/'}>
              {isNe ? 'अनुकूल रेजिन स्पेसिफिकेसन अनुरोध' : 'Request Custom Resin Specification'}
            </a>
            <a
              href="/downloads/samrat-frp-traders-product-catalogue.pdf"
              target="_blank"
              rel="noopener"
            >
              {isNe ? 'उत्पादन क्याटलग (PDF)' : 'Product catalogue (PDF)'}
            </a>
          </nav>
        </div>
        <div class="footer-col">
          <h2 class="footer-heading">{isNe ? 'अन्वेषण' : 'Explore'}</h2>
          <nav class="footer-nav" aria-label="Footer explore">
            <a href={isNe ? '/applications/' : '/en/applications/'}>{isNe ? 'प्रयोगहरू' : 'Applications'}</a>
            <a href={isNe ? '/resources/' : '/en/resources/'}>{isNe ? 'जानकारी केन्द्र' : 'Resources'}</a>
            <a href={isNe ? '/about/' : '/en/about/'}>{isNe ? 'हाम्रोबारे' : 'About'}</a>
            <a href={isNe ? '/contact/' : '/en/contact/'}>{isNe ? 'सम्पर्क' : 'Contact'}</a>
          </nav>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Samrat FRP Traders · Pre-publication foundation</span>
        <span class="footer-legal">
          <span class="legal-item" data-copy-value={site.business.pan}>PAN {site.business.pan}</span> ·
          <span class="legal-item" data-copy-value={site.business.vat}>VAT {site.business.vat}</span> ·
          <span class="legal-item" data-copy-value={site.business.exim}>EXIM {site.business.exim}</span>
        </span>
        <span class="footer-lang" role="group" aria-label={isNe ? 'भाषा' : 'Language'}>
          <a href={nePath} lang="ne" aria-current={isNe ? 'true' : undefined}>NE</a>
          <a href={enPath} lang="en" aria-current={!isNe ? 'true' : undefined}>EN</a>
        </span>
        <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
      </div>
    </footer>

    <a
      class="wa-float"
      href={buildWhatsAppLink(isNe ? whatsAppMessages.ne : whatsAppMessages.en)}
      target="_blank"
      rel="noopener"
      aria-label={isNe ? 'WhatsApp मा कुरा गर्नुहोस्' : 'Chat on WhatsApp'}
    >
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2s-.8.9-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.5c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 1.9 3 4.7 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15l-1.3 4.7L7 20.4A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z" /></svg>
    </a>

    <script>
      const toggle = document.getElementById('navToggle');
      const panel = document.getElementById('mobileNav');
      if (toggle && panel && toggle.dataset.wired !== 'true') {
        toggle.dataset.wired = 'true';
        const closeMenu = () => {
          toggle.setAttribute('aria-expanded', 'false');
          panel.classList.remove('is-open');
        };
        toggle.addEventListener('click', () => {
          const isOpen = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!isOpen));
          panel.classList.toggle('is-open', !isOpen);
        });
        panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeMenu();
        });
        const desktopQuery = window.matchMedia('(min-width: 761px)');
        desktopQuery.addEventListener('change', (event) => {
          if (event.matches) closeMenu();
        });
      }

      const header = document.getElementById('siteHeader');
      if (header && header.dataset.scrollWired !== 'true') {
        header.dataset.scrollWired = 'true';
        const syncScroll = () => header.classList.toggle('scrolled', window.scrollY > 6);
        syncScroll();
        window.addEventListener('scroll', syncScroll, { passive: true });
      }
    </script>
    <script>
      import { initReveal } from '../scripts/reveal.js';
      initReveal();
    </script>
    <script>
      import { wireFaqAccordions } from '../scripts/faq-accordion.js';
      wireFaqAccordions();
    </script>
    <script>
      import { wireFooterCopy } from '../scripts/footer-copy.js';
      wireFooterCopy();
    </script>
    <script>
      import { wireProductGalleries } from '../scripts/product-gallery.js';
      wireProductGalleries();
    </script>
    <script>
      import { wireCustomResinRequestForm } from '../scripts/custom-resin-request.js';
      wireCustomResinRequestForm();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(var(--gold-rgb), 0.16);
    background: rgba(10, 13, 18, 0.92);
    box-shadow: 0 0.7rem 2rem rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(0.8rem);
    transition: background 260ms var(--ease-premium), border-color 260ms var(--ease-premium), box-shadow 260ms var(--ease-premium);
  }

  .site-header.scrolled {
    border-bottom-color: rgba(var(--gold-rgb), 0.28);
    background: rgba(9, 11, 15, 0.97);
    box-shadow: 0 0.9rem 2.4rem rgba(0, 0, 0, 0.34);
  }

  /* Homepage only: the header dissolves into the cinematic hero while at
     the top of the page, then solidifies on scroll like the source site. */
  .site-header-hero:not(.scrolled) {
    border-bottom-color: transparent;
    background: linear-gradient(180deg, rgba(9, 11, 15, 0.72), rgba(9, 11, 15, 0));
    box-shadow: none;
  }

  .header-inner {
    min-height: 4.5rem;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    transition: min-height 260ms var(--ease-premium);
  }

  /* A quiet, functional compaction on scroll — the header claims less
     vertical space once the visitor is reading, not a decorative effect. */
  .site-header.scrolled .header-inner {
    min-height: 3.75rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-left: auto;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-badge {
    width: 3.1rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    overflow: hidden;
    padding: 0.32rem;
    border: 1px solid rgba(var(--gold-rgb), 0.6);
    border-radius: 50%;
    background: #fdfdfd;
    box-shadow:
      0 0 0 0.22rem rgba(var(--gold-rgb), 0.08),
      var(--surface-shadow-rest);
  }

  .brand-logo-full,
  .brand-logo-mark {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .brand-logo-mark {
    display: none;
  }

  .brand-text {
    display: grid;
    gap: 0.06rem;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .brand-descriptor {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 1.4vw, 1.1rem);
  }

  /* Scoped to direct top-level links only (including the mega-menu trigger
     one level in) so these rules never leak into the mega panel's own,
     differently-styled links. */
  .site-nav > a,
  .site-nav > .nav-mega > a {
    position: relative;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding-inline: 0.4rem;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms var(--ease-premium);
  }

  .site-nav > a:hover,
  .site-nav > a[aria-current='page'],
  .site-nav > .nav-mega > a:hover,
  .site-nav > .nav-mega > a[aria-current='page'] {
    color: var(--accent-gold-light);
  }

  .site-nav > a::after,
  .site-nav > .nav-mega > a::after {
    content: '';
    position: absolute;
    right: 0.4rem;
    bottom: 0.35rem;
    left: 0.4rem;
    height: 1px;
    transform: scaleX(0);
    background: var(--accent-gold);
    transition: transform 180ms var(--ease-premium);
  }

  .site-nav > a:hover::after,
  .site-nav > a[aria-current='page']::after,
  .site-nav > .nav-mega > a:hover::after,
  .site-nav > .nav-mega > a[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* ---------- Products mega-menu ----------
     Desktop-only (1024px+). Pure CSS hover/focus-within: the trigger stays
     a real link to /products/, so it degrades correctly with no JS and on
     touch devices that skip :hover entirely. */
  .nav-mega {
    position: static;
  }

  .nav-mega-caret {
    margin-left: 0.32rem;
    color: var(--ink-faint);
    transition: transform 220ms var(--ease-premium), color 180ms var(--ease-premium);
  }

  .nav-mega:hover .nav-mega-caret,
  .nav-mega:focus-within .nav-mega-caret {
    color: var(--accent-gold-light);
    transform: translateY(1px) rotate(180deg);
  }

  .mega-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 40;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.4rem);
    transition: opacity 200ms var(--ease-premium), transform 200ms var(--ease-premium), visibility 200ms;
    border-bottom: 1px solid rgba(var(--gold-rgb), 0.22);
    background: #0a0c10;
    box-shadow: 0 1.8rem 3.5rem rgba(0, 0, 0, 0.5);
  }

  .nav-mega:hover .mega-panel,
  .nav-mega:focus-within .mega-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mega-panel-inner {
    width: min(100% - 2 * var(--page-padding), var(--max-width));
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: 2.25rem;
  }

  .mega-col-label {
    margin-bottom: 1rem;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mega-col-featured {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .mega-col-featured .mega-col-label {
    padding: 0 0.2rem 0.8rem;
    background: transparent;
  }

  .mega-featured-link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.2rem 1rem;
    padding: 1.1rem 1.2rem;
    background: var(--bg-2);
    color: var(--ink);
    text-decoration: none;
    transition: background 200ms var(--ease-premium);
  }

  .mega-featured-link:hover {
    background: color-mix(in srgb, var(--accent-gold) 7%, var(--bg-2));
  }

  .mega-featured-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .mega-featured-summary {
    grid-column: 1 / -1;
    max-width: 46ch;
    color: var(--ink-dim);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .mega-featured-count {
    align-self: start;
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .mega-other-list {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .mega-other-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.72rem 1rem;
    background: var(--bg-2);
    color: var(--ink-dim);
    font-size: 0.86rem;
    text-decoration: none;
    transition: background 200ms var(--ease-premium), color 200ms var(--ease-premium);
  }

  .mega-other-list a:hover {
    background: color-mix(in srgb, var(--ink) 5%, var(--bg-2));
    color: var(--ink);
  }

  .mega-other-count {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  .mega-panel-foot {
    width: min(100% - 2 * var(--page-padding), var(--max-width));
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem 1.5rem;
    border-top: 1px solid var(--line);
  }

  .mega-panel-stat {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .mega-panel-all {
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms var(--ease-premium);
  }

  .mega-panel-all:hover {
    color: var(--accent-gold);
  }

  /* ---------- Language toggle & enquire CTA ---------- */
  .lang-toggle {
    display: flex;
    border: 1px solid var(--line-2);
  }

  .lang-toggle a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding-inline: 0.75rem;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 180ms var(--ease-premium), color 180ms var(--ease-premium);
  }

  .lang-toggle a + a {
    border-left: 1px solid var(--line-2);
  }

  .lang-toggle a:hover {
    color: var(--ink);
  }

  .lang-toggle a[aria-current='true'] {
    background: rgba(var(--gold-rgb), 0.14);
    color: var(--accent-gold-light);
  }

  .nav-enquire {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid rgba(37, 211, 102, 0.4);
    color: #63dd93;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: border-color 200ms var(--ease-premium), background 200ms var(--ease-premium), transform 200ms var(--ease-premium);
  }

  .nav-enquire:hover {
    border-color: rgba(37, 211, 102, 0.75);
    background: rgba(37, 211, 102, 0.09);
    transform: translateY(-1px);
  }

  .nav-toggle {
    display: none;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    margin-left: auto;
    border: 1px solid var(--line-2);
    background: transparent;
    cursor: pointer;
    transition: border-color 180ms var(--ease-premium);
  }

  .nav-toggle:hover,
  .nav-toggle[aria-expanded='true'] {
    border-color: var(--accent-gold);
  }

  .nav-toggle-bar {
    width: 1.15rem;
    height: 1px;
    display: block;
    background: var(--ink);
    transition: transform 220ms var(--ease-premium), opacity 220ms var(--ease-premium);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ---------- Mobile menu: full-viewport overlay ---------- */
  .mobile-nav {
    position: fixed;
    inset: 0;
    z-index: 45;
    display: none;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(5.5rem, 18vw, 7rem) var(--page-padding) 2rem;
    background: var(--bg);
    background-image: radial-gradient(90% 60% at 100% 0%, rgba(var(--gold-rgb), 0.08), transparent 60%);
    overflow-y: auto;
  }

  .mobile-nav.is-open {
    display: flex;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
  }

  .mobile-nav-links a {
    padding: 1.05rem 0.1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mobile-nav-links a[aria-current='page'] {
    color: var(--accent-gold-light);
  }

  .mobile-nav.is-open .mobile-nav-links a {
    animation: enter-up 420ms var(--ease-premium) both;
    animation-delay: calc(var(--i, 0) * 55ms + 60ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav.is-open .mobile-nav-links a {
      animation: none;
    }
  }

  .mobile-nav-foot {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .mobile-nav-wa {
    width: 100%;
  }

  /* Mobile top-header language switcher: hidden on desktop, where the
     .lang-toggle inside .header-actions already covers this job. */
  .mobile-top-lang-toggle {
    display: none;
  }

  @media (max-width: 1023px) {
    .mega-panel {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .site-nav,
    .header-actions {
      display: none;
    }

    /* A tighter gap than the desktop clamp reclaims just enough width for
       the language toggle to sit beside the hamburger without squeezing
       either control's touch target below 44px on narrow phones. */
    .header-inner {
      min-height: 4.25rem;
      gap: 0.6rem;
    }

    .brand {
      min-width: 0;
      flex-shrink: 1;
    }

    .brand-text {
      min-width: 0;
    }

    .brand-name {
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .mobile-top-lang-toggle {
      display: flex;
      flex-shrink: 0;
      margin-left: auto;
      box-shadow: 0 0 0 1px rgba(var(--gold-rgb), 0.05);
    }

    .nav-toggle {
      display: flex;
      margin-left: 0;
      background: rgba(var(--gold-rgb), 0.035);
    }

    .brand-badge {
      width: 2.6rem;
      padding: 0.28rem;
    }

    .brand-descriptor {
      display: none;
    }

    .mobile-nav {
      padding: clamp(5.25rem, 17vw, 6.5rem) var(--page-padding) max(1.5rem, env(safe-area-inset-bottom));
      background-image:
        linear-gradient(180deg, rgba(9, 13, 22, 0.94), var(--bg) 34%),
        radial-gradient(90% 60% at 100% 0%, rgba(var(--gold-rgb), 0.1), transparent 60%);
    }

    .mobile-nav-links a {
      padding-block: 0.9rem;
      font-size: clamp(1.45rem, 7vw, 1.7rem);
    }
  }

  /* Narrow phones (390px and below): the brand wordmark, language toggle
     and hamburger are all fighting for the same row, so shave a little off
     each non-essential dimension rather than let text-overflow: ellipsis
     chew through several characters of the brand name for a few px of
     overflow. The .brand-name ellipsis above still stands as a last-resort
     guard below this range. */
  @media (max-width: 400px) {
    .header-inner {
      gap: 0.4rem;
    }

    .brand {
      gap: 0.5rem;
    }

    .brand-badge {
      width: 2.3rem;
      padding: 0.22rem;
    }

    .brand-name {
      font-size: 0.82rem;
    }

    .mobile-top-lang-toggle a {
      padding-inline: 0.55rem;
    }
  }

  @media (max-width: 22rem) {
    .header-inner {
      gap: 0.3rem;
    }

    .brand {
      gap: 0.4rem;
    }

    .brand-badge {
      width: 2.15rem;
    }

    .brand-name {
      font-size: 0.7rem;
    }

    .mobile-top-lang-toggle a {
      padding-inline: 0.45rem;
    }
  }

  .site-footer {
    position: relative;
    margin-top: 2rem;
    background: linear-gradient(180deg, transparent, var(--bg-2) 4rem);
  }

  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-2) 20%, var(--line-2) 80%, transparent);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.85fr 0.85fr;
    gap: 2.25rem;
    padding-block: 3.5rem 2.25rem;
  }

  .footer-badge {
    width: 6.6rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    margin-bottom: 1rem;
    padding: 0.85rem;
    border: 1px solid rgba(var(--gold-rgb), 0.55);
    border-radius: 50%;
    background: #fdfdfd;
    box-shadow: 0 0 0 0.25rem rgba(var(--gold-rgb), 0.07);
  }

  .footer-badge img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .footer-brand {
    margin-bottom: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-descriptor {
    margin-bottom: 0.9rem;
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-copy {
    max-width: 30rem;
    margin-bottom: 0;
    color: var(--ink-dim);
    font-size: 0.88rem;
  }

  .footer-contact {
    display: grid;
    gap: 0.3rem;
    margin-top: 1.1rem;
  }

  .footer-contact a {
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .footer-contact a:hover {
    color: #f2d488;
  }

  .footer-contact span {
    color: var(--ink-faint);
    font-size: 0.78rem;
  }

  .footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.5rem;
    padding: 0.75rem 1.1rem;
    border: 1px solid rgba(37, 211, 102, 0.35);
    color: #63dd93;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
    transition: border-color 200ms var(--ease-premium), background 200ms var(--ease-premium), transform 200ms var(--ease-premium);
  }

  .footer-cta:hover {
    border-color: rgba(37, 211, 102, 0.7);
    background: rgba(37, 211, 102, 0.08);
    transform: translateY(-1px);
  }

  .wa-float {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 60;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #25d366;
    color: #062b14;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    transition: transform 0.3s var(--ease-premium), box-shadow 0.3s var(--ease-premium);
  }

  .wa-float:hover {
    transform: scale(1.08);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.5);
  }

  .footer-heading {
    margin-bottom: 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(var(--gold-rgb), 0.22);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-nav {
    display: grid;
    gap: 0.6rem;
  }

  .footer-nav a {
    color: var(--ink-dim);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 180ms var(--ease-premium);
  }

  .footer-nav a:hover {
    color: var(--accent-gold-light);
  }

  .footer-bottom {
    min-height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer-legal .legal-item.is-copyable {
    cursor: pointer;
    border-bottom: 1px dotted currentColor;
    transition: color 180ms var(--ease-premium);
  }

  .footer-legal .legal-item.is-copyable:hover,
  .footer-legal .legal-item.is-copyable:focus-visible {
    color: var(--accent-gold-light);
  }

  .footer-legal .legal-item.is-copyable:focus-visible {
    outline: 2px solid var(--accent-gold);
    outline-offset: 2px;
  }

  .footer-legal .legal-item.is-copied {
    color: var(--accent-gold-light);
  }

  .footer-lang {
    display: flex;
    border: 1px solid var(--line);
  }

  .footer-lang a {
    padding: 0.4rem 0.65rem;
    color: var(--ink-faint);
    text-decoration: none;
    transition: background 180ms var(--ease-premium), color 180ms var(--ease-premium);
  }

  .footer-lang a + a {
    border-left: 1px solid var(--line);
  }

  .footer-lang a:hover {
    color: var(--ink);
  }

  .footer-lang a[aria-current='true'] {
    background: rgba(var(--gold-rgb), 0.12);
    color: var(--accent-gold-light);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand-col {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 1.8rem;
      padding-block: 2.75rem 1.75rem;
    }

    .footer-brand-col {
      grid-column: auto;
    }

    .footer-badge {
      width: 4.8rem;
    }

    .footer-contact {
      gap: 0.5rem;
    }

    .footer-contact a,
    .footer-nav a {
      min-height: 2.5rem;
      display: flex;
      align-items: center;
    }

    .footer-cta {
      width: 100%;
      min-height: 3rem;
      justify-content: center;
      margin-top: 1.15rem;
    }

    .footer-bottom {
      min-height: 0;
      align-items: flex-start;
      flex-direction: column;
      gap: 0.9rem;
      padding-block: 1.15rem max(1.15rem, env(safe-area-inset-bottom));
    }

