---
import { buildCanonicalUrl, buildWhatsAppLink, site, whatsAppMessages } from '../data/site.js';
import '../styles/global.css';
import '../styles/foundation.css';

const {
  title,
  description = site.description,
  noindex = true,
  canonical = true,
  lang = 'en',
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.descriptor}`;
const canonicalUrl = canonical ? buildCanonicalUrl(Astro.url.pathname) : undefined;
const path = Astro.url.pathname;
const isNe = lang === 'ne';
const isHome = path === '/' || path === '/en/';
const is404 = /\/404\/?$/.test(path);
const altPath = is404
  ? (isNe ? '/en/' : '/')
  : isNe
    ? (path === '/' ? '/en/' : `/en${path}`)
    : path.replace(/^\/en/, '') || '/';
const enUrl = buildCanonicalUrl(is404 ? '/en/' : isNe ? altPath : path);
const neUrl = buildCanonicalUrl(is404 ? '/' : isNe ? path : altPath);
const waLink = buildWhatsAppLink(isNe ? whatsAppMessages.ne : whatsAppMessages.en);

const nav = isNe
  ? [
      { href: '/', label: 'गृहपृष्ठ' },
      { href: '/products/', label: 'उत्पादनहरू' },
      { href: '/applications/', label: 'प्रयोगहरू' },
      { href: '/resources/', label: 'जानकारी केन्द्र' },
      { href: '/about/', label: 'हाम्रोबारे' },
      { href: '/contact/', label: 'सम्पर्क' },
    ]
  : [
      { href: '/en/', label: 'Home' },
      { href: '/en/products/', label: 'Products' },
      { href: '/en/applications/', label: 'Applications' },
      { href: '/en/resources/', label: 'Resources' },
      { href: '/en/about/', label: 'About' },
      { href: '/en/contact/', label: 'Contact' },
    ];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0d0f12" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {!is404 && <link rel="alternate" hreflang="en-NP" href={enUrl} />}
    {!is404 && <link rel="alternate" hreflang="ne-NP" href={neUrl} />}
    {!is404 && <link rel="alternate" hreflang="x-default" href={neUrl} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={isNe ? 'ne_NP' : 'en_NP'} />
    <meta property="og:image" content={buildCanonicalUrl('/brand/og-default.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': ['Organization', 'LocalBusiness'],
      name: site.name,
      legalName: site.legalName,
      url: site.url,
      logo: `${site.url}brand/samrat-frp-traders-logo.png`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.business.addressLine1,
        addressLocality: site.business.city,
        addressCountry: site.business.country,
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        telephone: site.business.tel,
        email: site.business.email,
        availableLanguage: ['en', 'ne'],
      },
    })} />
    <script is:inline>
      // Opt-in hook for the scroll-reveal system. Only added when the user
      // has not requested reduced motion, so content is never hidden for
      // users who prefer less motion (and never hidden without JavaScript).
      (function () {
        var motion = window.matchMedia
          ? window.matchMedia('(prefers-reduced-motion: reduce)')
          : null;
        if (motion && !motion.matches) {
          document.documentElement.classList.add('js-reveal');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class:list={['site-header', { 'site-header-hero': isHome }]} id="siteHeader">
      <div class="container header-inner">
        <a class="brand" href={isNe ? '/' : '/en/'}>
          <span class="brand-badge">
            <img
              class="brand-logo-full"
              src="/brand/samrat-frp-traders-logo.png"
              alt="Samrat FRP Traders logo"
              width="900"
              height="741"
            />
            <img
              class="brand-logo-mark"
              src="/brand/samrat-frp-traders-mark.png"
              alt=""
              width="320"
              height="320"
            />
          </span>
          <span class="brand-text">
            <span class="brand-name">Samrat FRP Traders</span>
            <span class="brand-descriptor">FRP materials · Nepal</span>
          </span>
        </a>
        <nav class="site-nav" aria-label={isNe ? 'मुख्य नेभिगेसन' : 'Primary navigation'}>
          {nav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
          <a href={waLink} class="nav-wa" target="_blank" rel="noopener">WhatsApp</a>
          <a class="lang-switch" href={altPath} lang={isNe ? 'en' : 'ne'}>
            {isNe ? 'English' : 'नेपाली'}
          </a>
        </nav>
        <button type="button" class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="mobileNav" aria-label="Open menu">
          <span class="nav-toggle-bar" aria-hidden="true"></span>
          <span class="nav-toggle-bar" aria-hidden="true"></span>
          <span class="nav-toggle-bar" aria-hidden="true"></span>
        </button>
      </div>
      <nav class="mobile-nav" id="mobileNav" aria-label="Mobile navigation">
        {nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
        <a href={waLink} class="mobile-nav-wa" target="_blank" rel="noopener">WhatsApp</a>
        <a class="lang-switch" href={altPath} lang={isNe ? 'en' : 'ne'}>
          {isNe ? 'English' : 'नेपाली'}
        </a>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-col footer-brand-col">
          <span class="footer-badge">
            <img
              src="/brand/samrat-frp-traders-logo.png"
              alt="Samrat FRP Traders logo"
              width="900"
              height="741"
              loading="lazy"
            />
          </span>
          <p class="footer-brand">Samrat FRP Traders</p>
          <p class="footer-descriptor">
            {isNe
              ? 'नेपालभर FRP सामग्री आपूर्तिकर्ता, आयातकर्ता र पुनर्विक्रेता'
              : 'FRP materials trader, supplier, importer and reseller across Nepal'}
          </p>
          <p class="footer-copy">
            {isNe
              ? 'Samrat Poly Resins, India हाम्रो विश्वसनीय आपूर्तिकर्ता हो — resin र सम्बन्धित FRP सामग्रीका लागि।'
              : 'Samrat Poly Resins, India is a trusted supplier to Samrat FRP Traders for resins and related FRP materials.'}
          </p>
          <div class="footer-contact">
            <a href="tel:+9779805526904">+977 9805526904</a>
            <a href="mailto:samratfrptraders@gmail.com">samratfrptraders@gmail.com</a>
            <span>Ward No. 2, Tinpani Chowk, Main Road, Biratnagar, Nepal</span>
          </div>
        </div>
        <div class="footer-col">
          <h2 class="footer-heading">{isNe ? 'उत्पादनहरू' : 'Products'}</h2>
          <nav class="footer-nav" aria-label="Footer products">
            <a href={isNe ? '/products/' : '/en/products/'}>{isNe ? 'सबै उत्पादनहरू' : 'All products'}</a>
            <a href={isNe ? '/products/polyester-resins/' : '/en/products/polyester-resins/'}>{isNe ? 'Polyester रेजिनहरू' : 'Polyester Resins'}</a>
            <a href={isNe ? '/products/epoxy-casting-resins/' : '/en/products/epoxy-casting-resins/'}>{isNe ? 'Epoxy र Casting' : 'Epoxy & Casting Resins'}</a>
            <a href={isNe ? '/products/mekp-hardener/' : '/en/products/mekp-hardener/'}>MEKP Hardener</a>
          </nav>
        </div>
        <div class="footer-col">
          <h2 class="footer-heading">{isNe ? 'अन्वेषण' : 'Explore'}</h2>
          <nav class="footer-nav" aria-label="Footer explore">
            <a href={isNe ? '/applications/' : '/en/applications/'}>{isNe ? 'प्रयोगहरू' : 'Applications'}</a>
            <a href={isNe ? '/resources/' : '/en/resources/'}>{isNe ? 'जानकारी केन्द्र' : 'Resources'}</a>
            <a href={isNe ? '/about/' : '/en/about/'}>{isNe ? 'हाम्रोबारे' : 'About'}</a>
            <a href={isNe ? '/contact/' : '/en/contact/'}>{isNe ? 'सम्पर्क' : 'Contact'}</a>
          </nav>
        </div>
        <div class="footer-col">
          <h2 class="footer-heading">{isNe ? 'भाषा' : 'Language'}</h2>
          <nav class="footer-nav" aria-label="Language">
            <a href={enUrl} lang="en">English</a>
            <a href={neUrl} lang="ne">नेपाली</a>
          </nav>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Samrat FRP Traders · Pre-publication foundation</span>
        <span>PAN {site.business.pan} · VAT {site.business.vat} · EXIM {site.business.exim}</span>
      </div>
    </footer>

    <a
      class="wa-float"
      href={buildWhatsAppLink(isNe ? whatsAppMessages.ne : whatsAppMessages.en)}
      target="_blank"
      rel="noopener"
      aria-label={isNe ? 'WhatsApp मा कुरा गर्नुहोस्' : 'Chat on WhatsApp'}
    >
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2s-.8.9-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.5c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 1.9 3 4.7 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15l-1.3 4.7L7 20.4A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z" /></svg>
    </a>

    <script>
      const toggle = document.getElementById('navToggle');
      const panel = document.getElementById('mobileNav');
      if (toggle && panel && toggle.dataset.wired !== 'true') {
        toggle.dataset.wired = 'true';
        const closeMenu = () => {
          toggle.setAttribute('aria-expanded', 'false');
          panel.classList.remove('is-open');
        };
        toggle.addEventListener('click', () => {
          const isOpen = toggle.getAttribute('aria-expanded') === 'true';
          toggle.setAttribute('aria-expanded', String(!isOpen));
          panel.classList.toggle('is-open', !isOpen);
        });
        panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeMenu();
        });
        const desktopQuery = window.matchMedia('(min-width: 761px)');
        desktopQuery.addEventListener('change', (event) => {
          if (event.matches) closeMenu();
        });
      }

      const header = document.getElementById('siteHeader');
      if (header && header.dataset.scrollWired !== 'true') {
        header.dataset.scrollWired = 'true';
        const syncScroll = () => header.classList.toggle('scrolled', window.scrollY > 6);
        syncScroll();
        window.addEventListener('scroll', syncScroll, { passive: true });
      }
    </script>
    <script>
      import { initReveal } from '../scripts/reveal.js';
      initReveal();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(var(--gold-rgb), 0.16);
    background: rgba(10, 13, 18, 0.92);
    box-shadow: 0 0.7rem 2rem rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(0.8rem);
    transition: background 260ms var(--ease-premium), border-color 260ms var(--ease-premium), box-shadow 260ms var(--ease-premium);
  }

  .site-header.scrolled {
    border-bottom-color: rgba(var(--gold-rgb), 0.28);
    background: rgba(9, 11, 15, 0.97);
    box-shadow: 0 0.9rem 2.4rem rgba(0, 0, 0, 0.34);
  }

  /* Homepage only: the header dissolves into the cinematic hero while at
     the top of the page, then solidifies on scroll like the source site. */
  .site-header-hero:not(.scrolled) {
    border-bottom-color: transparent;
    background: linear-gradient(180deg, rgba(9, 11, 15, 0.72), rgba(9, 11, 15, 0));
    box-shadow: none;
  }

  .header-inner {
    min-height: 4.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-badge {
    width: 3.1rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    overflow: hidden;
    padding: 0.32rem;
    border: 1px solid rgba(var(--gold-rgb), 0.6);
    border-radius: 50%;
    background: #fdfdfd;
    box-shadow:
      0 0 0 0.22rem rgba(var(--gold-rgb), 0.08),
      var(--surface-shadow-rest);
  }

  .brand-logo-full,
  .brand-logo-mark {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .brand-logo-mark {
    display: none;
  }

  .brand-text {
    display: grid;
    gap: 0.06rem;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .brand-descriptor {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 1.4vw, 1.1rem);
  }

  .site-nav a {
    position: relative;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding-inline: 0.4rem;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms var(--ease-premium);
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--accent-gold-light);
  }

  .site-nav a::after {
    content: '';
    position: absolute;
    right: 0.4rem;
    bottom: 0.35rem;
    left: 0.4rem;
    height: 1px;
    transform: scaleX(0);
    background: var(--accent-gold);
    transition: transform 180ms var(--ease-premium);
  }

  .site-nav a:hover::after,
  .site-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .lang-switch {
    border: 1px solid rgba(var(--gold-rgb), 0.35) !important;
    color: var(--accent-gold-light) !important;
  }

  .nav-wa,
  .mobile-nav-wa {
    color: #25d366 !important;
  }

  .nav-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid var(--line-2);
    background: transparent;
    cursor: pointer;
    transition: border-color 180ms var(--ease-premium);
  }

  .nav-toggle:hover,
  .nav-toggle[aria-expanded='true'] {
    border-color: var(--accent-gold);
  }

  .nav-toggle-bar {
    width: 1.15rem;
    height: 1px;
    display: block;
    background: var(--ink);
    transition: transform 220ms var(--ease-premium), opacity 220ms var(--ease-premium);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 0.4rem var(--page-padding) 1rem;
    border-top: 1px solid var(--line);
    background: var(--bg);
  }

  .mobile-nav.is-open {
    display: flex;
  }

  .mobile-nav a {
    padding: 0.85rem 0.15rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mobile-nav a:last-child {
    border-bottom: 0;
  }

  .mobile-nav a:hover {
    color: var(--accent-gold-light);
  }

  @media (max-width: 820px) {
    .site-nav {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    .brand-badge {
      width: 2.6rem;
      padding: 0.28rem;
    }

    .brand-logo-full {
      display: none;
    }

    .brand-logo-mark {
      display: block;
    }

    .brand-descriptor {
      display: none;
    }
  }

  .site-footer {
    position: relative;
    margin-top: 2rem;
    background: linear-gradient(180deg, transparent, var(--bg-2) 4rem);
  }

  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--line-2) 20%, var(--line-2) 80%, transparent);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 0.8fr 0.6fr;
    gap: 2.25rem;
    padding-block: 3.5rem 2.25rem;
  }

  .footer-badge {
    width: 6.6rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    margin-bottom: 1rem;
    padding: 0.85rem;
    border: 1px solid rgba(var(--gold-rgb), 0.55);
    border-radius: 50%;
    background: #fdfdfd;
    box-shadow: 0 0 0 0.25rem rgba(var(--gold-rgb), 0.07);
  }

  .footer-badge img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .footer-brand {
    margin-bottom: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .footer-descriptor {
    margin-bottom: 0.9rem;
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-copy {
    max-width: 30rem;
    margin-bottom: 0;
    color: var(--ink-dim);
    font-size: 0.88rem;
  }

  .footer-contact {
    display: grid;
    gap: 0.3rem;
    margin-top: 1.1rem;
  }

  .footer-contact a {
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .footer-contact a:hover {
    color: #f2d488;
  }

  .footer-contact span {
    color: var(--ink-faint);
    font-size: 0.78rem;
  }

  .wa-float {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 60;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #25d366;
    color: #062b14;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    transition: transform 0.3s var(--ease-premium), box-shadow 0.3s var(--ease-premium);
  }

  .wa-float:hover {
    transform: scale(1.08);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.5);
  }

  .footer-heading {
    margin-bottom: 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(var(--gold-rgb), 0.22);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-nav {
    display: grid;
    gap: 0.6rem;
  }

  .footer-nav a {
    color: var(--ink-dim);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 180ms var(--ease-premium);
  }

  .footer-nav a:hover {
    color: var(--accent-gold-light);
  }

  .footer-bottom {
    min-height: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand-col {
