---
// WebSite entity node — the documented signal Google reads for the site
// name shown in search results.
//
// Deliberately minimal. The detailed Organization / LocalBusiness node is
// emitted site-wide by src/layouts/Base.astro and is already correct; this
// does NOT restate it, because two competing Organization descriptions on
// one page is worse than one good one. `publisher` here is an identity
// reference only — name and URL, nothing else.
//
// Every value is read from src/data/site.js, so the entity can never drift
// away from the footer, the contact block or the Organization schema.
//
// NOT included, because none of it is verified in this repository:
// sameAs profiles, ratings, reviews, prices, availability, certifications,
// founding date, opening hours, geo coordinates, or an alternate business
// name. "Samrat FRP Trading" appears on some third-party listings but the
// repository holds no evidence that it is the same legal entity, so it is
// not asserted here as an alternateName.
//
// When src/layouts/Base.astro is no longer held by in-flight work, this
// node belongs on the homepage too, and the Organization node there should
// gain a stable @id that `publisher` can point at. See
// docs/seo/BRAND_ENTITY_DECISIONS.md.
import { site } from '../data/site.js';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  inLanguage: ['ne-NP', 'en-NP'],
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} is:inline />
