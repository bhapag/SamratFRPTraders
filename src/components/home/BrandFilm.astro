---
import { buildWhatsAppLink, whatsAppMessages } from '../../data/site.js';

const { lang = 'ne', homeExperiment = false } = Astro.props;
const isNe = lang === 'ne';
const prefix = isNe ? '' : '/en';
const waLink = buildWhatsAppLink(whatsAppMessages.generic[isNe ? 'ne' : 'en']);

// Real, verified facts only. The source file is referenced at a stable public
// URL.
//
// uploadDate was previously omitted on the grounds that no date was known,
// which left Google reporting "1 invalid item" for the homepage video —
// uploadDate is required, so the whole VideoObject was being discarded.
// schema.org defines it as the date the media object was uploaded *to this
// site*, and that is recorded precisely: public/videos/brand-showcase.mp4
// entered the repository in commit a04168a on 2026-09-02. This is that date,
// not a guess at when the footage was produced.
const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  uploadDate: '2026-09-02',
  name: isNe ? 'Samrat FRP Traders — ब्रान्ड परिचय' : 'Samrat FRP Traders — Brand Showcase',
  description: isNe
    ? 'Samrat FRP Traders का उत्पादन, प्रयोग र नेपालभरको आपूर्ति कार्यको संक्षिप्त झलक।'
    : 'A short showcase of Samrat FRP Traders’ products, applications and supply work across Nepal.',
  thumbnailUrl: 'https://samratfrptraders.com/videos/brand-showcase-still.jpeg',
  contentUrl: 'https://samratfrptraders.com/videos/brand-showcase.mp4',
  duration: 'PT12.042S',
};
---
<section class="section section-framed showcase-section">
  <div class="container">
    <div class="section-heading section-heading-split" data-reveal>
      <div>
        <p class="eyebrow">{isNe ? 'Samrat FRP Traders' : 'Samrat FRP Traders'}</p>
        <h2>
          {isNe ? 'उत्पादन। प्रयोग। नेपाल।' : 'Products. Applications. Nepal.'}
        </h2>
      </div>
    </div>

    <div class="showcase-grid" data-reveal>
      <div class="showcase-frame" data-showcase-frame>
        <video
          class="showcase-video"
          data-showcase-video
          data-src="/videos/brand-showcase.mp4"
          poster={homeExperiment ? '/videos/brand-showcase-still-900.webp' : undefined}
          autoplay
          muted
          playsinline
          preload="metadata"
          aria-label={isNe
            ? 'Samrat FRP Traders को उत्पादन, प्रयोग र नेपालभरको आपूर्ति देखाउने ब्रान्ड भिडियो'
            : 'Brand video showing Samrat FRP Traders’ products, applications and supply across Nepal'}
        >
          {isNe
            ? 'तपाईंको ब्राउजरले भिडियो प्ले गर्न सक्दैन। '
            : 'Your browser cannot play this video. '}
          <a href="/videos/brand-showcase.mp4">{isNe ? 'भिडियो डाउनलोड गर्नुहोस्' : 'Download the video'}</a>
        </video>
        <img
          class="showcase-photo"
          data-showcase-photo
          src="/videos/brand-showcase-still-900.webp"
          width="900"
          height="1600"
          loading="eager"
          decoding="async"
          alt={isNe
            ? 'Samrat FRP Traders को उत्पादन र आपूर्ति कार्यको झलक'
            : 'Samrat FRP Traders product and supply work'}
          hidden
        />
        <button type="button" class="showcase-play" data-showcase-play hidden>
          <span class="showcase-play-icon" aria-hidden="true">▶</span>
          <span class="showcase-play-label">
            {isNe ? 'भिडियो चलाउनुहोस्' : 'Play the video'}
            <small>{isNe ? 'लगभग १२ MB' : 'about 12 MB'}</small>
          </span>
        </button>
      </div>

      <div class="showcase-copy">
        <p>
          {isNe
            ? 'Samrat FRP Traders ले नेपालभर FRP सामग्री, polyester resin, gelcoat, glass fiber र सम्बन्धित composite सामग्री आपूर्ति तथा आयात गर्दछ — Biratnagar, Nepal बाट सञ्चालित।'
            : 'Samrat FRP Traders supplies and imports FRP materials, polyester resins, gelcoat, glass fiber and related composite materials across Nepal — operating from Biratnagar, Nepal.'}
        </p>
        <ul class="showcase-points">
          {isNe
            ? [
                <li><span class="point-check" aria-hidden="true">✓</span>नेपालभर आपूर्ति समन्वय</li>,
                <li><span class="point-check" aria-hidden="true">✓</span>व्यापारी · आपूर्तिकर्ता · आयातकर्ता · पुनर्विक्रेता</li>,
                <li><span class="point-check" aria-hidden="true">✓</span>उपलब्ध आपूर्तिकर्ता TDS/SDS कागजात</li>,
              ]
            : [
                <li><span class="point-check" aria-hidden="true">✓</span>Supply coordination across Nepal</li>,
                <li><span class="point-check" aria-hidden="true">✓</span>Trader · Supplier · Importer · Reseller</li>,
                <li><span class="point-check" aria-hidden="true">✓</span>Supplier TDS/SDS where available</li>,
              ]}
        </ul>
        <div class="showcase-cta">
          <a class="button button-primary" href={`${prefix}/products/`}>
            {isNe ? 'उत्पादनहरू हेर्नुहोस्' : 'Explore Products'}
          </a>
          <a class="button" href={`${prefix}/applications/`}>
            {isNe ? 'प्रयोगहरू हेर्नुहोस्' : 'View Applications'}
          </a>
          <a class="button wa-button" href={waLink} target="_blank" rel="noopener">
            {isNe ? 'WhatsApp' : 'WhatsApp'}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />

<script>
  import { canAffordVideo } from '../../scripts/video-budget.js';

  const PHOTO_DURATION_MS = 5000;

  const initBrandFilmCycles = () => {
    document.querySelectorAll('[data-showcase-frame]').forEach((frame) => {
      if (frame.dataset.brandFilmCycleWired === 'true') return;
      frame.dataset.brandFilmCycleWired = 'true';

      const video = frame.querySelector('[data-showcase-video]');
      const photo = frame.querySelector('[data-showcase-photo]');
      if (!(video instanceof HTMLVideoElement) || !(photo instanceof HTMLImageElement)) return;

      const playButton = frame.querySelector('[data-showcase-play]');
      // The brand film is 12 MB. It is content rather than decoration, so on a
      // phone it is not removed — it is offered. The still frame stands in its
      // place and the visitor decides whether to spend the data.
      let allowed = canAffordVideo();

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let inView = false;
      let sourceLoaded = false;
      let state = 'video';
      let photoTimer = null;
      let photoRemaining = PHOTO_DURATION_MS;
      let photoStartedAt = 0;
      let disposed = false;

      const clearPhotoTimer = () => {
        if (photoTimer === null) return;
        window.clearTimeout(photoTimer);
        photoTimer = null;
      };

      const showVideo = () => {
        photo.hidden = true;
        video.hidden = false;
      };

      const showPhoto = () => {
        video.hidden = true;
        photo.hidden = false;
      };

      const loadVideoSource = () => {
        if (sourceLoaded) return;
        const source = video.dataset.src;
        if (!source) return;
        sourceLoaded = true;
        video.src = source;
        video.load();
      };

      const playVideo = () => {
        if (!allowed) return;
        if (disposed || reducedMotion.matches || !inView || state !== 'video') return;
        loadVideoSource();
        showVideo();
        const attempt = video.play();
        if (attempt) {
          attempt.catch((error) => {
            console.warn('[BrandFilm] Muted video playback could not start.', error);
          });
        }
      };

      const startPhotoTimer = () => {
        clearPhotoTimer();
        if (disposed || reducedMotion.matches || !inView || state !== 'photo') return;

        if (photoRemaining <= 0) {
          restartVideo();
          return;
        }

        photoStartedAt = performance.now();
        photoTimer = window.setTimeout(() => {
          photoTimer = null;
          photoRemaining = 0;
          restartVideo();
        }, photoRemaining);
      };

      const pausePhotoTimer = () => {
        if (photoTimer === null) return;
        photoRemaining = Math.max(0, photoRemaining - (performance.now() - photoStartedAt));
        clearPhotoTimer();
      };

      const restartVideo = () => {
        clearPhotoTimer();
        if (disposed || reducedMotion.matches) return;

        state = 'video';
        photoRemaining = PHOTO_DURATION_MS;
        showVideo();
        if (sourceLoaded) video.currentTime = 0;
        playVideo();
      };

      const showIntermissionPhoto = () => {
        if (disposed || reducedMotion.matches) return;

        video.pause();
        state = 'photo';
        photoRemaining = PHOTO_DURATION_MS;
        showPhoto();
        startPhotoTimer();
      };

      const applyReducedMotion = () => {
        clearPhotoTimer();
        video.pause();
        if (reducedMotion.matches) {
          state = 'reduced';
          showPhoto();
          return;
        }

        state = 'video';
        photoRemaining = PHOTO_DURATION_MS;
        if (sourceLoaded) video.currentTime = 0;
        showVideo();
        playVideo();
      };

      const observer = new IntersectionObserver((entries) => {
        const entry = entries[0];
        inView = entry.isIntersecting && entry.intersectionRatio >= 0.15;

        if (!inView) {
          if (state === 'photo') pausePhotoTimer();
          else video.pause();
          return;
        }

        if (reducedMotion.matches) {
          applyReducedMotion();
        } else if (state === 'photo') {
          startPhotoTimer();
        } else {
          playVideo();
        }
      }, { threshold: [0, 0.15] });

      const cleanup = () => {
        if (disposed) return;
        disposed = true;
        clearPhotoTimer();
        observer.disconnect();
        video.pause();
        video.removeEventListener('ended', showIntermissionPhoto);
        reducedMotion.removeEventListener('change', applyReducedMotion);
      };

      video.addEventListener('ended', showIntermissionPhoto);
      reducedMotion.addEventListener('change', applyReducedMotion);
      document.addEventListener('astro:before-swap', cleanup, { once: true });

      if (playButton instanceof HTMLButtonElement) {
        playButton.hidden = allowed;
        playButton.addEventListener('click', () => {
          allowed = true;
          playButton.hidden = true;
          state = 'video';
          photoRemaining = PHOTO_DURATION_MS;
          inView = true;
          showVideo();
          playVideo();
        });
      }

      if (reducedMotion.matches) applyReducedMotion();
      else if (!allowed) showPhoto();
      else showVideo();
      observer.observe(frame);
    });
  };

  initBrandFilmCycles();
  document.addEventListener('astro:page-load', initBrandFilmCycles);
</script>

<style>
  .showcase-section {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .showcase-frame {
    position: relative;
    display: flex;
    justify-content: center;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 9 / 16;
    margin-inline: auto;
    border: 1px solid var(--line);
    background: #030609;
    overflow: hidden;
    isolation: isolate;
    box-shadow: var(--surface-shadow-rest);
    transition: border-color 220ms var(--ease-premium), box-shadow 220ms var(--ease-premium);
  }

  .showcase-frame:focus-within {
    border-color: rgba(var(--gold-rgb), 0.55);
    box-shadow: var(--surface-shadow-hover);
  }

  .showcase-video,
  .showcase-photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    background: #030609;
  }

  .showcase-photo {
    position: absolute;
    inset: 0;
  }

  .showcase-photo[hidden] {
    display: none;
  }

  /* Shown only where the data budget declines to autoplay a 12 MB film, so the
     still frame stays and the visitor is offered the video rather than served
     it. Sits above the still, sized for a comfortable thumb target. */
  .showcase-play {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    min-height: 3.25rem;
    padding: 0.85rem 1rem;
    border: 0;
    border-top: 1px solid rgba(var(--gold-rgb), 0.35);
    background: rgba(3, 6, 9, 0.9);
    backdrop-filter: blur(6px);
    color: #f6f2e8;
    font: inherit;
    font-size: 0.85rem;
    line-height: 1.25;
    text-align: left;
    cursor: pointer;
  }

  .showcase-play[hidden] {
    display: none;
  }

  .showcase-play-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    border: 1px solid rgba(var(--gold-rgb), 0.6);
    border-radius: 50%;
    font-size: 0.7rem;
    line-height: 1;
  }

  .showcase-play-label {
    display: grid;
    gap: 0.1rem;
  }

  .showcase-play-label small {
    color: rgba(246, 242, 232, 0.72);
    font-size: 0.75rem;
  }

  .showcase-play:focus-visible {
    outline: 2px solid rgba(var(--gold-rgb), 0.9);
    outline-offset: -2px;
  }

  .showcase-copy > p {
    max-width: 46ch;
    color: var(--ink-dim);
    line-height: 1.75;
  }

  .showcase-points {
    display: grid;
    gap: 0.9rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .showcase-points li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .point-check {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: linear-gradient(180deg, var(--accent-gold-light), var(--accent-gold-dark));
    color: #17120c;
    font-size: 0.7rem;
    font-weight: 700;
  }

  .showcase-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .wa-button {
    background: #25d366;
    border-color: #25d366;
    color: #062b14;
    font-weight: 700;
  }

  .wa-button:hover {
    background: #2ee87a;
    border-color: #2ee87a;
    color: #062b14;
  }

  @media (max-width: 860px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }

    .showcase-frame {
      max-width: 24rem;
    }
  }
</style>
