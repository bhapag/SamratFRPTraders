---
// Homepage — "specimen sheet" edition.
//
// The page is built from record-keeping objects rather than marketing cards:
// a frontispiece, an index of families, specimen plates, a film, an
// application spread, a documentation ledger, a business record and a
// colophon-style enquiry sheet. Every number is read from the data files at
// build time; nothing is hand-typed. The supplier is credited as the issuer
// of documents and nothing more. Samrat FRP Traders is a trader, supplier,
// importer and reseller — the page says so, and never implies otherwise.
import HeroBackground from './HeroBackground.astro';
import BrandFilm from './BrandFilm.astro';
import { products, catalogGroups, getGroup, getProduct, productsInGroup } from '../../data/products.js';
import { applications } from '../../data/applications.js';
import { resources } from '../../data/resources.js';
import {
  DOCUMENT_ISSUER,
  productsWithoutDocuments,
} from '../../data/documents.js';
import { site, buildWhatsAppIntentLink } from '../../data/site.js';
import { productImageAlt } from '../../utils/product-page.js';
import '../../styles/home-experiment.css';

const { lang = 'ne' } = Astro.props;
const ne = lang === 'ne';
const prefix = ne ? '' : '/en';
const t = (en, np) => (ne ? np : en);
const pad = (n) => String(n).padStart(2, '0');

// ---- Verified facts, all computed ---------------------------------------
const liveApplications = applications.filter((a) => !a.draft);
const liveResources = resources.filter((r) => !r.draft);
const featured = products.filter((p) => p.tier === 'A');
const missing = productsWithoutDocuments();
const quoteWa = buildWhatsAppIntentLink('quote', lang);
const productWa = (name) => buildWhatsAppIntentLink('quote', lang, name);
const familyHref = (group) =>
  group.indexable ? `${prefix}/products/${group.slug}/` : `${prefix}/products/#${group.slug}`;

// Short, factual notes per family for the index. Keyed by slug and derived
// from each group's own summary; anything without a note falls back to the
// summary itself, so a new family can never render blank.
const FAMILY_NOTES = {
  'polyester-resins': ['Including unsaturated polyester resin (UPR)', 'Unsaturated polyester resin (UPR) सहित'],
  'sheet-grade-resins': ['Including roof light resin', 'Roof light resin सहित'],
  // Was "one product, GP Gelcoat Resin" when written; ISO Gelcoat has since
  // been placed here as its primary family, so the note read against its own
  // count of 2.
  gelcoat: ['GP Gelcoat Resin and ISO Gelcoat', 'GP Gelcoat Resin र ISO Gelcoat'],
  // This family did not exist when the notes above were written, so the Nepali
  // index was falling back to the English summary for it.
  'iso-resins': [
    'ISO here is isophthalic chemistry, not an ISO certification',
    'यहाँ ISO भनेको isophthalic रसायन हो, कुनै ISO प्रमाणीकरण होइन',
  ],
  'fire-retardant-resins': ['Fire performance figures are supplier-issued; confirm from the current TDS', 'अग्नि-प्रतिरोध तथ्याङ्क आपूर्तिकर्ताद्वारा जारी; हालको TDS बाट पुष्टि गर्नुहोस्'],
  'frp-allied-products': ['Reinforcement, pigment, thinner, fillers, release wax and application tools', 'Reinforcement, pigment, thinner, filler, release wax र प्रयोगका औजार'],
  'epoxy-casting-resins': ['Epoxy and casting resin products', 'Epoxy र casting resin उत्पादनहरू'],
  'industrial-specialty-resins': ['Including vinyl ester, bisphenol and marble resin', 'Vinyl ester, bisphenol र marble resin सहित'],
  'hardeners-catalysts': ['Used alongside polyester and epoxy systems', 'Polyester र epoxy प्रणालीसँगै प्रयोग हुने'],
};
const familyNote = (group) => {
  const pair = FAMILY_NOTES[group.slug];
  return pair ? t(pair[0], pair[1]) : group.summary || '';
};
const families = catalogGroups.map((group, i) => ({
  group,
  index: pad(i + 1),
  href: familyHref(group),
  note: familyNote(group),
  count: productsInGroup(group.slug).length,
}));

// Short display labels for the application index rows, keyed by slug with
// the real title as fallback so a row can never be mislabelled.
const APPLICATION_LABELS = {
  'resin-for-water-tank-manufacturing': ['Water tanks', 'पानी ट्यांकी'],
  'resin-for-cooling-tower-manufacturing': ['Cooling towers', 'कूलिङ टावर'],
  'resin-for-roofing-sheet-manufacturing': ['Roofing sheets', 'छाना पाता'],
  'resin-for-frp-door-manufacturing': ['FRP doors', 'FRP ढोका'],
  'resin-for-door-skin-manufacturing': ['Door skins', 'डोर स्किन'],
  'resin-for-frp-panel-manufacturing': ['FRP panels', 'FRP प्यानल'],
};
// The page this replaces links three named guides from the homepage. Keeping
// the same three preserves those internal links rather than collapsing the
// whole library behind a single count. Nepali titles come from the same map
// the previous homepage used.
const FEATURED_GUIDE_SLUGS = [
  'what-is-gp-polyester-resin',
  'applications-of-gp-polyester-resin',
  'how-to-select-polyester-resin-for-frp-manufacturing',
];
const GUIDE_LABELS_NE = {
  'what-is-gp-polyester-resin': 'GP Polyester Resin के हो?',
  'applications-of-gp-polyester-resin': 'GP Polyester Resin का प्रयोगहरू',
  'how-to-select-polyester-resin-for-frp-manufacturing': 'FRP का लागि Polyester Resin कसरी छान्ने?',
};
const featuredGuides = FEATURED_GUIDE_SLUGS
  .map((slug) => liveResources.find((r) => r.slug === slug))
  .filter(Boolean);
const guideTitle = (resource) => (ne && GUIDE_LABELS_NE[resource.slug]) || resource.title;

const applicationLabel = (app) => {
  const pair = APPLICATION_LABELS[app.slug];
  return pair ? t(pair[0], pair[1]) : app.title;
};
// Real pixel dimensions of the card images, measured from the files. They
// are small, so the spread never renders one above its native size.
const APPLICATION_IMAGE_SIZES = {
  'frp-water-tanks.jpg': [627, 627],
  'cooling-towers.jpg': [627, 627],
  'frp-roofing-sheets.jpg': [627, 627],
  'frp-door.jpg': [432, 462],
  'frp-door-skin.jpg': [316, 632],
  'frp-panel-sheets.jpg': [291, 357],
};
const imageSize = (file) => APPLICATION_IMAGE_SIZES[file] ?? [627, 627];
const featuredApplications = liveApplications.slice(0, 6);
const [leadApplication, ...indexApplications] = featuredApplications;
const relatedProducts = (app) =>
  (app.relatedProductSlugs ?? []).map((slug) => getProduct(slug)).filter(Boolean);
const [leadW, leadH] = imageSize(leadApplication.cardImage);

// Coverage strip: one mark per product, in catalogue order.
const coverage = products.map((p) => ({ product: p, documented: (p.documents ?? []).length > 0 }));

const contents = [
  { id: 'families', label: t('The range', 'हाम्रो दायरा'), count: catalogGroups.length },
  { id: 'specimens', label: t('Featured materials', 'प्रमुख सामग्री'), count: featured.length },
  { id: 'film', label: t('Film', 'भिडियो'), count: null },
  { id: 'applications', label: t('In application', 'प्रयोगमा'), count: liveApplications.length },
  { id: 'documents', label: t('Documentation', 'कागजात'), count: null },
  { id: 'record', label: t('Business record', 'व्यावसायिक विवरण'), count: null },
  { id: 'enquiry', label: t('Enquiry', 'सोधपुछ'), count: null },
];
---
<div class="home-design">
  <!-- 00 · Frontispiece ------------------------------------------------ -->
  <section class="hero home-hero" aria-labelledby="home-title">
    <HeroBackground />
    <div class="home-hero-shade" aria-hidden="true"></div>
    <div class="home-shell home-hero-content">
      <div class="home-hero-main">
        <p class="home-kicker"><span></span>{t('BIRATNAGAR, NEPAL · FRP MATERIALS TRADER, SUPPLIER & IMPORTER', 'विराटनगर, नेपाल · FRP सामग्रीका व्यापारी, आपूर्तिकर्ता र आयातकर्ता')}</p>
        <h1 id="home-title">Samrat FRP Traders.<br/><em>{t('FRP materials, across Nepal.', 'नेपालभर FRP सामग्री।')}</em></h1>
        <p class="home-hero-dek">
          {t(
            `Polyester, epoxy, gelcoat, glass fiber and allied FRP materials — imported and supplied across Nepal, with the supplier's data sheets for the grades we carry hosted here.`,
            `Polyester, epoxy, gelcoat, glass fiber र सम्बन्धित FRP सामग्री — आयात गरी नेपालभर आपूर्ति; हामीले राख्ने grade हरूका आपूर्तिकर्ता डाटा शीट यहीँ उपलब्ध छन्।`,
          )}
        </p>
        <div class="home-actions">
          <a class="home-button home-button-gold" href={quoteWa} target="_blank" rel="noopener">
            <svg class="home-wa-glyph" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2s-.8.9-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.5c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 1.9 3 4.7 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15l-1.3 4.7L7 20.4A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z"/></svg>
            {t('Request a quotation', 'कोटेशन माग्नुहोस्')}
          </a>
          <a class="home-button home-button-ghost" href={`${prefix}/products/`}>{t('Open the catalogue', 'उत्पादन सूची खोल्नुहोस्')}<span aria-hidden="true">↗</span></a>
          <a class="home-tel" href={`tel:${site.business.tel}`}>{site.business.phone}</a>
        </div>
      </div>

      <aside class="home-hero-rail" aria-label={t('What we supply', 'हामी के आपूर्ति गर्छौं')}>
        <dl class="home-spec-ledger">
          <div><dt>{t('ROLE', 'भूमिका')}</dt><dd>{t('Trader · Supplier · Importer · Reseller', 'व्यापारी · आपूर्तिकर्ता · आयातकर्ता · पुनर्विक्रेता')}</dd></div>
          <div><dt>{t('BASE', 'आधार')}</dt><dd>{site.business.city}, {site.business.country}</dd></div>
          <div><dt>{t('RANGE', 'दायरा')}</dt><dd>{products.length} {t('products', 'उत्पादन')} · {catalogGroups.length} {t('families', 'परिवार')}</dd></div>
          <div><dt>{t('DOCUMENTS', 'कागजात')}</dt><dd>{t('Supplier data sheets, product by product', 'आपूर्तिकर्ता डाटा शीट, उत्पादनअनुसार')}</dd></div>
        </dl>
      </aside>

      <nav class="home-contents" aria-label={t('Page contents', 'पृष्ठ सूची')}>
        {contents.map((item, i) => (
          <a href={`#${item.id}`}>
            <span class="home-contents-index">{pad(i + 1)}</span>
            <span class="home-contents-label">{item.label}</span>
            {item.count !== null && <span class="home-contents-count">{item.count}</span>}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- 01 · Index of families -------------------------------------------- -->
  <section class="home-sheet home-navy home-families" id="families" aria-labelledby="families-title">
    <div class="home-shell">
      <header class="home-sheet-head" data-reveal>
        <div>
          <p class="home-kicker"><span class="home-kicker-index">01</span><span></span>{t('THE RANGE', 'हाम्रो दायरा')}</p>
          <h2 id="families-title">{catalogGroups.length} {t('families.', 'परिवार।')} {products.length} {t('products.', 'उत्पादन।')}</h2>
        </div>
        <p class="home-sheet-lead">{t('Every product belongs to one family. Open a family to see its products and the supplier documents linked to them.', 'हरेक उत्पादन कुनै एक परिवारमा पर्छ। परिवार खोलेर त्यसका उत्पादन र तिनसँग जोडिएका आपूर्तिकर्ता कागजात हेर्नुहोस्।')}</p>
      </header>

      <table class="home-ledger home-family-ledger" role="table" data-reveal>
        <caption class="visually-hidden">{t('Product families with product counts', 'उत्पादन परिवार र उत्पादन संख्या')}</caption>
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col" class="home-col-index">{t('NO.', 'क्र.सं.')}</th>
            <th role="columnheader" scope="col" class="home-col-name">{t('FAMILY', 'परिवार')}</th>
            <th role="columnheader" scope="col" class="home-col-note">{t('NOTE', 'टिप्पणी')}</th>
            <th role="columnheader" scope="col" class="home-col-num">{t('PRODUCTS', 'उत्पादन')}</th>
            <th role="columnheader" scope="col" class="home-col-arrow"><span class="visually-hidden">{t('Open', 'खोल्नुहोस्')}</span></th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {families.map((f) => (
            <tr role="row">
              <td role="cell" class="home-col-index"><span class="home-ledger-index">{f.index}</span></td>
              <th role="rowheader" scope="row" class="home-col-name"><a href={f.href}>{f.group.name}</a></th>
              <td role="cell" class="home-col-note">{f.note}</td>
              <td role="cell" class="home-col-num"><span class="home-ledger-num">{f.count}</span><span class="home-ledger-unit">{t(f.count === 1 ? 'product' : 'products', 'उत्पादन')}</span></td>
              <td role="cell" class="home-col-arrow"><a href={f.href} tabindex="-1" aria-hidden="true">↗</a></td>
            </tr>
          ))}
        </tbody>
      </table>

    </div>
  </section>

  <!-- 02 · Specimen plates ----------------------------------------------- -->
  <section class="home-sheet home-navy home-specimens" id="specimens" aria-labelledby="specimens-title">
    <div class="home-shell">
      <header class="home-sheet-head" data-reveal>
        <div>
          <p class="home-kicker"><span class="home-kicker-index">02</span><span></span>{t('FEATURED MATERIALS', 'प्रमुख सामग्री')}</p>
          <h2 id="specimens-title">{t('Five featured materials from the catalogue.', 'उत्पादन सूचीका पाँच प्रमुख सामग्री।')}</h2>
        </div>
        <p class="home-sheet-lead">{t('Five grades from across the range, each shown with its family and the supplier documents linked to it.', 'दायराभरका पाँच grade — प्रत्येक आफ्नो परिवार र सँगै जोडिएका आपूर्तिकर्ता कागजातसहित।')}</p>
      </header>

      <div class="home-plates">
        {featured.map((product, i) => {
          const image = product.images?.[0];
          const docTypes = (product.documents ?? []).map((d) => (/product data/i.test(d.type) ? 'PDS' : /safety/i.test(d.type) ? 'SDS' : 'TDS'));
          const docLabel = ['TDS', 'PDS', 'SDS'].filter((k) => docTypes.includes(k)).join(' · ');
          return (
            <a class="home-plate" href={`${prefix}/products/${product.slug}/`} data-reveal style={`--reveal-delay: ${i * 60}ms`}>
              <span class="home-plate-well">
                {image && <img src={`/images/products/${image.src}`} width={image.width} height={image.height} alt={productImageAlt(product, ne)} loading="lazy" decoding="async" />}
              </span>
              <span class="home-plate-caption">
                <span class="home-plate-meta"><span class="home-plate-index">02.{pad(i + 1)}</span><span class="home-plate-family">{getGroup(product.group)?.name}</span></span>
                <span class="home-plate-name">{product.name}</span>
                <span class="home-plate-foot">
                  <span class="home-plate-cta">{t('PRODUCT DETAILS', 'उत्पादन विवरण')} <span aria-hidden="true">↗</span></span>
                  <span class="home-plate-docs">{docLabel || t('NO DOCUMENTS ON FILE', 'कागजात फाइलमा छैन')}</span>
                </span>
              </span>
            </a>
          );
        })}
      </div>
    </div>

    <div class="home-catalogue-bar" data-reveal>
      <div class="home-shell home-catalogue-bar-inner">
        <p class="home-catalogue-figure">{t('The full range we supply and import for the Nepal market. Tell us the grade and quantity and we will confirm availability and price.', 'नेपाल बजारका लागि हामीले आपूर्ति र आयात गर्ने पूरा दायरा। grade र परिमाण बताउनुहोस्, उपलब्धता र मूल्य हामी पुष्टि गर्नेछौं।')}</p>
        <div class="home-catalogue-actions">
          <a class="home-button home-button-gold" href={`${prefix}/products/`}>{t('Browse the catalogue', 'उत्पादन सूची हेर्नुहोस्')}<span aria-hidden="true">↗</span></a>
          <a class="home-text-link" href="/downloads/samrat-frp-traders-product-catalogue.pdf" target="_blank" rel="noopener" download>{t('Catalogue PDF', 'क्याटलग PDF')}<span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 · Film ------------------------------------------------------------ -->
  <div class="home-film" id="film">
    <BrandFilm lang={lang} homeExperiment eyebrow={t('03 / FILM — 12 s · muted · loops', '03 / भिडियो — 12 से. · ध्वनिरहित · दोहोरिन्छ')} />
  </div>

  <!-- 04 · In application --------------------------------------------------- -->
  <section class="home-sheet home-navy home-applications" id="applications" aria-labelledby="applications-title">
    <div class="home-shell">
      <header class="home-sheet-head" data-reveal>
        <div>
          <p class="home-kicker"><span class="home-kicker-index">04</span><span></span>{t('IN APPLICATION', 'प्रयोगमा')}</p>
          <h2 id="applications-title">{t('From material to finished part.', 'सामग्रीदेखि तयारी भागसम्म।')}</h2>
        </div>
        <p class="home-sheet-lead">{t(`These are the parts our materials go into. Each guide covers the material’s role in the process, the grades commonly used for it, and what to confirm before you order — ${liveApplications.length} of them, written for the work rather than the catalogue.`, `हाम्रा सामग्री यिनै भागहरूमा प्रयोग हुन्छन्। हरेक गाइडले प्रक्रियामा सामग्रीको भूमिका, सामान्यतया प्रयोग हुने grade र अर्डरअघि पुष्टि गर्नुपर्ने कुरा समेट्छ — कुल ${liveApplications.length}, सूचीका लागि होइन कामका लागि लेखिएका।`)}</p>
      </header>

      <div class="home-mosaic">
        {featuredApplications.map((app, i) => {
          const [w, h] = imageSize(app.cardImage);
          return (
            <a class="home-tile" href={`${prefix}/applications/${app.slug}/`} data-reveal style={`--reveal-delay: ${i * 55}ms`}>
              <span class="home-tile-frame">
                <img src={`/images/applications/${app.cardImage}`} width={w} height={h} alt={app.cardImageAlt} loading="lazy" decoding="async" />
              </span>
              <span class="home-tile-body">
                <span class="home-mono-label">04.{pad(i + 1)}</span>
                <span class="home-tile-name">{applicationLabel(app)}</span>
                <span class="home-tile-cta">{t('Read the guide', 'गाइड पढ्नुहोस्')} <span aria-hidden="true">↗</span></span>
              </span>
            </a>
          );
        })}
      </div>

      <p class="home-sheet-foot" data-reveal>
        <a class="home-text-link" href={`${prefix}/applications/`}>{t(`All ${liveApplications.length} application guides`, `सबै ${liveApplications.length} प्रयोग गाइड`)}<span aria-hidden="true">↗</span></a>
      </p>
    </div>
  </section>

  <!-- 05 · Documentation ------------------------------------------------------ -->
  <section class="home-sheet home-paper home-documents" id="documents" aria-labelledby="documents-title">
    <div class="home-shell home-documents-grid">
      <div class="home-documents-copy" data-reveal>
        <p class="home-kicker"><span class="home-kicker-index">05</span><span></span>{t('DOCUMENTATION', 'कागजात')}</p>
        <h2 id="documents-title">{t('Supplier data sheets, before you order.', 'अर्डरअघि नै आपूर्तिकर्ताका डाटा शीट।')}</h2>
        <p class="home-sheet-lead">
          {t(
            `We host the supplier's data sheets for the products we carry — Technical Data Sheets, a Product Data Sheet for application tools, and Safety Data Sheets where the supplier has issued them. Each product page links only the documents that exist for it. They are issued by ${DOCUMENT_ISSUER}, so ask us to confirm the current revision for your order.`,
            `हामीले राख्ने उत्पादनहरूका आपूर्तिकर्ता डाटा शीट यहीँ उपलब्ध छन् — Technical Data Sheet, औजारका लागि Product Data Sheet, र आपूर्तिकर्ताले जारी गरेको ठाउँमा Safety Data Sheet। प्रत्येक उत्पादन पृष्ठमा त्यसका लागि भएका कागजात मात्र लिंक गरिएका छन्। यी ${DOCUMENT_ISSUER} द्वारा जारी हुन्, त्यसैले आफ्नो अर्डरका लागि हालको संस्करण पुष्टि गर्न हामीलाई सोध्नुहोस्।`,
          )}
        </p>

      </div>

      <div class="home-documents-table" data-reveal style="--reveal-delay: 100ms">
        <ul class="home-shelf">
