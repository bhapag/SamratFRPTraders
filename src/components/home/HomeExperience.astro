---
import HeroBackground from './HeroBackground.astro';
import BrandFilm from './BrandFilm.astro';
import { products, catalogGroups, getGroup } from '../../data/products.js';
import { applications } from '../../data/applications.js';
import { resources } from '../../data/resources.js';
import { site, buildWhatsAppLink, whatsAppMessages } from '../../data/site.js';
import { productImageAlt } from '../../utils/product-page.js';
import '../../styles/home-experiment.css';

const { lang = 'ne' } = Astro.props;
const ne = lang === 'ne';
const prefix = ne ? '' : '/en';
const t = (en, np) => ne ? np : en;
const wa = buildWhatsAppLink(whatsAppMessages.generic[lang]);
const featured = products.filter(p => p.tier === 'A');

// Draft entries never reach the site, so the homepage counts and cards must
// exclude them the same way every other page does.
const liveApplications = applications.filter((a) => !a.draft);
const liveResources = resources.filter((r) => !r.draft);
const featuredApplications = liveApplications.slice(0, 6);
const featuredResources = liveResources.slice(0, 3);

// Short display labels for the featured cards, keyed by slug rather than by
// position. These were previously index-keyed arrays, which meant reordering
// applications.js or resources.js would silently label a card with another
// entry's name while still linking to the original. Anything without a short
// label falls back to its real title, so a card can never be mislabelled.
const APPLICATION_LABELS = {
  'resin-for-water-tank-manufacturing': ['Water tanks', 'पानी ट्यांकी'],
  'resin-for-cooling-tower-manufacturing': ['Cooling towers', 'कूलिङ टावर'],
  'resin-for-roofing-sheet-manufacturing': ['Roofing sheets', 'छाना पाता'],
  'resin-for-frp-door-manufacturing': ['FRP doors', 'FRP ढोका'],
  'resin-for-door-skin-manufacturing': ['Door skins', 'डोर स्किन'],
  'resin-for-frp-panel-manufacturing': ['FRP panels', 'FRP प्यानल'],
};
const GUIDE_LABELS_NE = {
  'what-is-gp-polyester-resin': 'GP Polyester Resin के हो?',
  'applications-of-gp-polyester-resin': 'GP Polyester Resin का प्रयोगहरू',
  'how-to-select-polyester-resin-for-frp-manufacturing': 'FRP का लागि Polyester Resin कसरी छान्ने?',
};
const applicationLabel = (app) => {
  const pair = APPLICATION_LABELS[app.slug];
  return pair ? t(pair[0], pair[1]) : app.title;
};
const guideTitle = (resource) => (ne && GUIDE_LABELS_NE[resource.slug]) || resource.title;
---
<div class="home-design">
  <section class="hero home-hero" aria-labelledby="home-title">
    <HeroBackground />
    <div class="home-hero-shade" aria-hidden="true"></div>
    <div class="home-shell home-hero-content">
      <p class="home-kicker"><span></span>{t('BIRATNAGAR, NEPAL · SUPPLIER & IMPORTER', 'विराटनगर, नेपाल · आपूर्तिकर्ता र आयातकर्ता')}</p>
      <h1 id="home-title">Samrat FRP Traders.<br/><em>{t('FRP materials, across Nepal.', 'नेपालभर FRP सामग्री।')}</em></h1>
      <p class="home-hero-classes">Polyester · Epoxy · Gelcoat · Glass Fiber</p>
      <p class="home-hero-intro">{t('Materials for composite work. Product knowledge for informed choices. A direct conversation with your supplier.', 'Composite कामका लागि सामग्री। छनोटका लागि प्राविधिक जानकारी। आफ्नो आपूर्तिकर्तासँग सिधा संवाद।')}</p>
      <div class="home-actions">
        <a class="home-button home-button-gold" href={`${prefix}/products/`}>{t('Explore the catalogue', 'उत्पादन सूची हेर्नुहोस्')}<span aria-hidden="true">↗</span></a>
        <a class="home-text-link" href={`${prefix}/contact/`}>{t('Discuss a requirement', 'आफ्नो आवश्यकता बताउनुहोस्')}<span aria-hidden="true">→</span></a>
      </div>
      <div class="home-hero-foot">
        <a href="#materials"><strong>{products.length}</strong><span>{t('Products', 'उत्पादनहरू')}</span></a>
        <a href="#materials"><strong>{catalogGroups.length}</strong><span>{t('Material families', 'उत्पादन परिवार')}</span></a>
        <a href="#applications"><strong>{liveApplications.length}</strong><span>{t('Application guides', 'प्रयोग गाइड')}</span></a>
        <p>{t('TRADER / SUPPLIER / IMPORTER / RESELLER', 'व्यापारी / आपूर्तिकर्ता / आयातकर्ता / पुनर्विक्रेता')}</p>
      </div>
    </div>
  </section>

  <section class="home-materials home-paper" id="materials" aria-labelledby="materials-title">
    <div class="home-shell">
      <div class="home-section-head">
        <div><p class="home-kicker">01 / {t('THE MATERIALS INDEX', 'सामग्री सूची')}</p><h2 id="materials-title">{t('Start with the material.', 'सुरुवात सामग्रीबाट।')}</h2></div>
        <p>{t(`Explore ${products.length} products across ${catalogGroups.length} families. Product details and supplier documentation, where available, help you ask the right questions.`, `${catalogGroups.length} परिवारका ${products.length} उत्पादनहरू हेर्नुहोस्। उत्पादन विवरण र उपलब्ध आपूर्तिकर्ता कागजातले सही प्रश्न सोध्न मद्दत गर्छन्।`)}</p>
      </div>
      <nav class="home-family-index" aria-label={t('Product families', 'उत्पादन परिवारहरू')}>
        {catalogGroups.map((group, i) => <a href={group.indexable ? `${prefix}/products/${group.slug}/` : `${prefix}/products/#${group.slug}`}><span class="home-index-number">{String(i + 1).padStart(2, '0')}</span><span>{group.name}</span><span aria-hidden="true">↗</span></a>)}
      </nav>
      <div class="home-subhead"><h3>{t('Inside the catalogue', 'उत्पादन सूचीबाट')}</h3><a href={`${prefix}/products/`}>{t('Full product range', 'पूरा उत्पादन दायरा')} →</a></div>
      <div class="home-product-grid">
        {featured.map((product) => <a class="home-product" href={`${prefix}/products/${product.slug}/`}>
          <div class="home-product-media"><img src={`/images/products/${product.images[0].src}`} width={product.images[0].width} height={product.images[0].height} alt={productImageAlt(product, ne)} loading="lazy" decoding="async" /></div>
          <div class="home-product-body"><p>{getGroup(product.group)?.name}</p><h3>{product.name}</h3><span class="home-product-cta">{t('Product details', 'उत्पादन विवरण')}<span aria-hidden="true">↗</span></span></div>
        </a>)}
        <a class="home-product home-product-all" href={`${prefix}/products/`}><span class="home-kicker">{t('THE COMPLETE RANGE', 'पूरा उत्पादन सूची')}</span><strong>{products.length}<span>{t('products', 'उत्पादनहरू')}</span></strong><p>{t('Resins, reinforcement, surface finishes and allied materials.', 'Resin, reinforcement, surface finish र सम्बन्धित सामग्री।')}</p><span class="home-product-cta">{t('Browse all products', 'सबै उत्पादनहरू हेर्नुहोस्')}<span aria-hidden="true">↗</span></span></a>
      </div>
    </div>
  </section>

  <div class="home-film"><BrandFilm lang={lang} homeExperiment /></div>

  <section class="home-applications" id="applications" aria-labelledby="applications-title">
    <div class="home-shell">
      <div class="home-section-head"><div><p class="home-kicker">02 / {t('MATERIALS IN CONTEXT', 'सामग्रीको प्रयोग')}</p><h2 id="applications-title">{t('From material to application.', 'सामग्रीदेखि प्रयोगसम्म।')}</h2></div><a class="home-text-link" href={`${prefix}/applications/`}>{t(`All ${liveApplications.length} application guides`, `सबै ${liveApplications.length} प्रयोग गाइड`)}<span aria-hidden="true">↗</span></a></div>
      <div class="home-app-grid">
        {featuredApplications.map((app, i) => <a class:list={['home-app', {'home-app-lead':i === 0}]} href={`${prefix}/applications/${app.slug}/`}>
          <img src={`/images/applications/${app.cardImage}`} alt={app.cardImageAlt} width="700" height="466" loading="lazy" decoding="async"/>
          <div><span class="home-kicker">{String(i+1).padStart(2, '0')} / {t('APPLICATION GUIDE', 'प्रयोग गाइड')}</span><h3>{applicationLabel(app)}</h3>{i===0 && <p>{t('Understand the material role, process and selection considerations.', 'सामग्रीको भूमिका, प्रक्रिया र छनोटका पक्षहरू बुझ्नुहोस्।')}</p>}<span class="home-app-arrow" aria-hidden="true">↗</span></div>
        </a>)}
      </div>
    </div>
  </section>

  <section class="home-knowledge home-paper" aria-labelledby="knowledge-title">
    <div class="home-shell home-knowledge-grid">
      <div><p class="home-kicker">03 / {t('THE KNOWLEDGE LIBRARY', 'जानकारी केन्द्र')}</p><h2 id="knowledge-title">{t('Better questions. Informed choices.', 'सही प्रश्न। सूचित छनोट।')}</h2><p>{t('Selection guides, material comparisons and practical explanations. Technical context before a commercial conversation.', 'छनोट गाइड, सामग्री तुलना र व्यावहारिक व्याख्या। खरिदको संवादअघि आवश्यक प्राविधिक सन्दर्भ।')}</p><a class="home-text-link" href={`${prefix}/resources/`}>{t('Explore the Knowledge Hub', 'जानकारी केन्द्र खोल्नुहोस्')}<span aria-hidden="true">↗</span></a></div>
      <div class="home-reading-list">{featuredResources.map((resource, i) => <a href={`${prefix}/resources/${resource.slug}/`}><span class="home-index-number">0{i+1}</span><div><p>{t('MATERIAL KNOWLEDGE', 'सामग्रीसम्बन्धी जानकारी')}</p><h3>{guideTitle(resource)}</h3><span>{resource.readingTime}</span></div><span aria-hidden="true">↗</span></a>)}</div>
    </div>
  </section>

  <section class="home-company" aria-labelledby="company-title">
    <div class="home-shell">
      <div class="home-section-head"><div><p class="home-kicker">04 / {t('YOUR SUPPLIER IN NEPAL', 'नेपालमा तपाईंको आपूर्तिकर्ता')}</p><h2 id="company-title">{t('A direct connection.', 'सिधा सम्पर्क। स्पष्ट परिचय।')}</h2></div><p>{t('Samrat FRP Traders is a trader, supplier, importer and reseller operating from Biratnagar. We coordinate FRP material supply across Nepal.', 'विराटनगरबाट सञ्चालित Samrat FRP Traders व्यापारी, आपूर्तिकर्ता, आयातकर्ता र पुनर्विक्रेता हो। हामी नेपालभर FRP सामग्री आपूर्तिको समन्वय गर्छौं।')}</p></div>
      <div class="home-company-grid">
        <div class="home-business-record"><p class="home-kicker">{t('BUSINESS RECORD', 'व्यावसायिक विवरण')}</p><h3>{site.legalName}</h3><address>{site.business.addressLine1}<br/>{site.business.city}, {site.business.country}</address><dl><div><dt>PAN / VAT</dt><dd>{site.business.pan}</dd></div><div><dt>EXIM</dt><dd>{site.business.exim}</dd></div></dl><a class="home-text-link" href={`${prefix}/about/`}>{t('About Samrat FRP Traders', 'Samrat FRP Traders बारे')}<span aria-hidden="true">↗</span></a></div>
        <div class="home-source"><figure><img src="/images/supplier/supplier-production.jpg" alt={t('Supplier reference: Samrat Poly Resins, India production infrastructure', 'आपूर्तिकर्ता सन्दर्भ: Samrat Poly Resins, India को उत्पादन पूर्वाधार')} width="700" height="466" loading="lazy" decoding="async"/><figcaption>Samrat Poly Resins, India · {t('SUPPLIER REFERENCE', 'आपूर्तिकर्ता सन्दर्भ')}</figcaption></figure><p>{t('Samrat Poly Resins, India is a supplier of resin and related FRP materials to Samrat FRP Traders. This reference media shows the supplier’s infrastructure, not a Samrat FRP Traders manufacturing facility.', 'Samrat Poly Resins, India, Samrat FRP Traders का resin र सम्बन्धित FRP सामग्रीको आपूर्तिकर्ता हो। यो सन्दर्भ मिडियाले आपूर्तिकर्ताको पूर्वाधार देखाउँछ, Samrat FRP Traders को उत्पादनस्थल होइन।')}</p><details class="home-supplier-film"><summary>{t('Watch the supplier reference film', 'आपूर्तिकर्ताको सन्दर्भ भिडियो हेर्नुहोस्')}<span aria-hidden="true">＋</span></summary><video controls playsinline preload="none" poster="/videos/applications-video-poster.jpg" aria-label={t('Samrat Poly Resins supplier reference video', 'Samrat Poly Resins आपूर्तिकर्ताको सन्दर्भ भिडियो')}><source src="/videos/applications-video.mp4" type="video/mp4"/><a href="/videos/applications-video.mp4">{t('Download video', 'भिडियो डाउनलोड')}</a></video></details></div>
      </div>
    </div>
  </section>

  <section class="home-contact" aria-labelledby="contact-title"><div class="home-shell"><div><p class="home-kicker">{t('LET’S TALK MATERIALS', 'सामग्रीबारे कुरा गरौं')}</p><h2 id="contact-title">{t('Your next requirement.', 'तपाईंको आगामी आवश्यकता।')}<br/><em>{t('Start a conversation.', 'संवाद सुरु गरौं।')}</em></h2></div><div class="home-contact-actions"><a class="home-button home-button-gold" href={wa} target="_blank" rel="noopener">{t('Enquire on WhatsApp', 'WhatsApp मा सोध्नुहोस्')}<span aria-hidden="true">↗</span></a><a href={`tel:${site.business.tel}`}>{site.business.phone}</a><a class="home-text-link" href={`${prefix}/contact/`}>{t('All contact options', 'सम्पर्कका सबै विकल्प')}<span aria-hidden="true">→</span></a></div></div></section>
</div>

<script>
  // Homepage only: pause the background outside its viewport. Foreground films
  // keep their existing cycle, while the optional supplier film is user-initiated.
  const hero = document.querySelector('.home-hero .hero-video');
  if (hero instanceof HTMLVideoElement) {
    const motion = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = true;
    const sync = () => {
      if (!visible || document.hidden || motion.matches) hero.pause();
      else if (hero.src) hero.play().catch(() => {});
    };
    const observer = new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); });
    observer.observe(hero);
    document.addEventListener('visibilitychange', sync);
    motion.addEventListener('change', sync);
    document.addEventListener('astro:before-swap', () => { observer.disconnect(); document.removeEventListener('visibilitychange', sync); motion.removeEventListener('change', sync); }, {once:true});
  }
  document.querySelectorAll('.home-supplier-film').forEach((details) => {
    const video = details.querySelector('video');
    if (!(video instanceof HTMLVideoElement)) return;
    details.addEventListener('toggle', () => { if (!details.hasAttribute('open')) video.pause(); });
    const observer = new IntersectionObserver(([entry]) => { if (!entry.isIntersecting) video.pause(); });
    observer.observe(video);
    document.addEventListener('astro:before-swap', () => observer.disconnect(), {once:true});
  });
</script>
