<div class="hero-media" aria-hidden="true">
  <video
    class="hero-video"
    data-src="/videos/hero-background.mp4"
    poster="/videos/hero-background-poster.webp"
    autoplay
    muted
    loop
    playsinline
    preload="none"
    disablepictureinpicture
    disableremoteplayback
    tabindex="-1"
  ></video>
</div>

<script>
  import { canAffordVideo } from '../../scripts/video-budget.js';

  function initHeroBackgrounds() {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    document.querySelectorAll('.hero-video').forEach((video) => {
      if (!(video instanceof HTMLVideoElement) || video.dataset.wired === 'true') return;
      video.dataset.wired = 'true';

      const unload = () => {
        video.autoplay = false;
        video.pause();
        if (video.hasAttribute('src')) {
          video.removeAttribute('src');
          video.load();
        }
      };

      const syncMotion = () => {
        // A 4 MB decorative loop sitting behind the hero text is the most
        // expensive thing on the homepage and the least visible one on a
        // phone. The poster carries the same image at 59 KB, so where the
        // budget check says no, the page simply keeps the poster.
        if (!canAffordVideo()) {
          unload();
          return;
        }

        const source = video.dataset.src;
        if (!source) return;
        // The property must also be muted for mobile autoplay policies.
        video.muted = true;
        video.autoplay = true;
        if (!video.hasAttribute('src')) video.src = source;
        // A browser may still decline autoplay; the poster remains a fallback.
        video.play().catch(() => {});
      };

      reducedMotion.addEventListener('change', syncMotion);
      syncMotion();
    });
  }

  initHeroBackgrounds();
  document.addEventListener('astro:page-load', initHeroBackgrounds);
</script>
