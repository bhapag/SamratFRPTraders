---

<section class="page-hero hero-shell">
  <div class="hero-grid-lines" aria-hidden="true"></div>
  <div class="container page-hero-content">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{t.heroHeading1} <span class="metal-text">{t.heroHeading2}</span></h1>
    <p class="page-lead">{t.heroLead}</p>
  </div>
</section>

<section class="section ledger crsr-surface">
  <div class="container narrow">
    <Breadcrumbs items={breadcrumbItems} />

    <div class="crsr-intro" data-reveal>
      <p class="eyebrow">{t.introHeading}</p>
      <p class="crsr-intro-lead">{t.introLead}</p>
      <p class="crsr-positioning">{t.positioningNote}</p>
    </div>

    <form
      id="crsrForm"
      class="crsr-form form-shell"
      novalidate
      data-wa-number={site.business.whatsapp}
      data-email={site.business.email}
      data-wa-message={whatsAppMessage}
      data-email-subject-prefix={t.emailSubjectPrefix}
      data-print-title={t.printTitle}
      data-print-generated-on={t.printGeneratedOn}
      data-group-your-details={t.groupYourDetails}
      data-group-what-you-need={t.groupWhatYouNeed}
      data-group-preferred={t.groupPreferred}
      data-group-notes={t.groupNotes}
      data-error-name={t.errorName}
      data-error-product={t.errorProduct}
      data-error-contact={t.errorContact}
      data-error-summary-heading={t.errorSummaryHeading}
    >
      <div id="formErrors" class="form-errors" role="alert" hidden></div>

      <fieldset class="crsr-section">
        <legend><span class="crsr-step-num">01</span> {t.section1Title}</legend>
        <div class="form-grid two-col">
          <label>
            <span>{t.name} *</span>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              placeholder={t.namePlaceholder}
              data-summary-group="yourDetails"
              data-summary-label={t.name}
              aria-describedby="name-error"
            />
            <p class="field-error" id="name-error" hidden></p>
          </label>
          <label>
            <span>{t.company}</span>
            <input
              type="text"
              id="company"
              name="company"
              autocomplete="organization"
              placeholder={t.companyPlaceholder}
              data-summary-group="yourDetails"
              data-summary-label={t.company}
            />
          </label>
        </div>
        <div class="form-grid two-col">
          <label>
            <span>{t.location}</span>
            <input
              type="text"
              id="location"
              name="location"
              autocomplete="address-level2"
              placeholder={t.locationPlaceholder}
              data-summary-group="yourDetails"
              data-summary-label={t.location}
            />
          </label>
          <label>
            <span>{t.phone}</span>
            <input
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              placeholder={t.phonePlaceholder}
              data-summary-group="yourDetails"
              data-summary-label={t.phone}
              aria-describedby="contact-error"
            />
          </label>
        </div>
        <label>
          <span>{t.email}</span>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            placeholder={t.emailPlaceholder}
            data-summary-group="yourDetails"
            data-summary-label={t.email}
            aria-describedby="contact-error"
          />
        </label>
        <p class="field-error" id="contact-error" hidden></p>
        <p class="field-hint">{t.contactHint}</p>
      </fieldset>

      <fieldset class="crsr-section">
        <legend><span class="crsr-step-num">02</span> {t.section2Title}</legend>
        <label>
          <span>{t.product} *</span>
          <select
            id="product"
            name="product"
            required
            data-summary-group="whatYouNeed"
            data-summary-label={t.product}
            aria-describedby="product-error"
          >
            <option value="" disabled selected>{t.productPlaceholder}</option>
            {productOptions.map((option) => (
              <option value={option.value}>{isNe ? option.ne : option.en}</option>
            ))}
          </select>
          <p class="field-error" id="product-error" hidden></p>
        </label>
        <div class="form-grid two-col">
          <label>
            <span>{t.application}</span>
            <input
              type="text"
              id="application"
              name="application"
              autocomplete="off"
              placeholder={t.applicationPlaceholder}
              data-summary-group="whatYouNeed"
              data-summary-label={t.application}
            />
          </label>
          <label>
            <span>{t.quantity}</span>
            <input
              type="text"
              id="quantity"
              name="quantity"
              autocomplete="off"
              placeholder={t.quantityPlaceholder}
              data-summary-group="whatYouNeed"
              data-summary-label={t.quantity}
            />
          </label>
        </div>
      </fieldset>

      <fieldset class="crsr-section">
        <legend><span class="crsr-step-num">03</span> {t.section3Title}</legend>
        <p class="field-hint">{t.section3Hint}</p>
        <div class="form-grid two-col">
          {preferredFields.map((field) => (
            <label>
              <span>{field.label}</span>
              <input
                type="text"
                id={field.id}
                name={field.id}
                autocomplete="off"
                placeholder={field.placeholder}
                data-summary-group="preferred"
                data-summary-label={field.label}
              />
            </label>
          ))}
        </div>
        <label class="checkbox-field">
          <input
            type="checkbox"
            id="supplierRecommend"
            name="supplierRecommend"
            data-summary-group="preferred"
            data-summary-label={t.supplierRecommend}
            data-summary-value={t.supplierRecommendValue}
          />
          <span>{t.supplierRecommend}</span>
        </label>

        <div class="custom-requirements-block">
          <div id="customRequirements" class="custom-requirements"></div>
          <button type="button" id="addRequirementBtn" class="button crsr-add-btn">+ {t.addRequirement}</button>
          <template id="requirementRowTemplate">
            <div class="requirement-row" data-requirement-row>
              <label class="visually-hidden">{t.requirementLabelPlaceholder}</label>
              <input type="text" data-role="req-label" placeholder={t.requirementLabelPlaceholder} />
              <label class="visually-hidden">{t.requirementValuePlaceholder}</label>
              <input type="text" data-role="req-value" placeholder={t.requirementValuePlaceholder} />
              <button type="button" class="requirement-remove" data-role="req-remove" aria-label={t.removeRequirement}>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
              </button>
            </div>
          </template>
        </div>

        <details class="crsr-advanced">
          <summary>{t.advancedSummary}</summary>
          <div class="form-grid two-col crsr-advanced-grid">
            {advancedFields.map((field) => (
              <label>
                <span>{field.label}</span>
                <input
                  type="text"
                  id={field.id}
                  name={field.id}
                  autocomplete="off"
                  placeholder={field.placeholder}
                  data-summary-group="preferred"
                  data-summary-label={field.label}
                />
              </label>
            ))}
          </div>
          <p class="field-hint">{t.fireRetardantNote}</p>
        </details>
      </fieldset>

      <fieldset class="crsr-section">
        <legend><span class="crsr-step-num">04</span> {t.section4Title}</legend>
        <label>
          <span>{t.notes}</span>
          <textarea
            id="notes"
            name="notes"
            rows="4"
            autocomplete="off"
            placeholder={t.notesPlaceholder}
            data-summary-group="notes"
            data-summary-label={t.notes}
          ></textarea>
        </label>
        <p class="field-hint">{t.attachmentNote}</p>
      </fieldset>

      <fieldset class="crsr-section crsr-send-section">
        <legend><span class="crsr-step-num">05</span> {t.section5Title}</legend>
        <label class="crsr-ref-field">
          <span>{t.requestReference}</span>
          <input type="text" id="requestReference" name="requestReference" readonly data-summary-label={t.requestReference} />
        </label>
        <div class="crsr-send-actions">
          <button type="button" class="button button-primary" data-action="whatsapp">{t.sendWhatsApp}</button>
          <button type="button" class="button" data-action="email">{t.sendEmail}</button>
          <button type="button" class="button" data-action="print">{t.printSave}</button>
        </div>
        <p class="crsr-disclaimer">{t.disclaimer}</p>
      </fieldset>
    </form>
  </div>
</section>

<div id="printSummary" class="print-summary" aria-hidden="true"></div>

