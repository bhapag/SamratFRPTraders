---
const { record } = Astro.props;
---
<article class="product-preview-card">
  <div class="product-preview-media" aria-hidden="true">
    <span>{record.id}</span>
    <i></i>
  </div>
  <div class="product-preview-body">
    <p class="product-preview-category">{record.category}</p>
    <h3>{record.name}</h3>
    <p class="product-preview-summary">{record.summary}</p>
    <p class="product-preview-status">{record.status}</p>
  </div>
</article>

<style>
  .product-preview-card {
    min-width: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg-3);
    box-shadow: var(--surface-shadow-rest);
    transition: border-color 220ms var(--ease-premium), transform 220ms var(--ease-premium), box-shadow 220ms var(--ease-premium);
  }

  .product-preview-card:hover {
    transform: translateY(-0.25rem);
    border-color: rgba(var(--gold-rgb), 0.65);
    box-shadow: var(--surface-shadow-hover);
  }

  .product-preview-media {
    position: relative;
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      radial-gradient(circle at 72% 22%, rgba(var(--gold-rgb), 0.16), transparent 42%),
      linear-gradient(145deg, #171b22, #222a35);
    background-size: 2rem 2rem, 2rem 2rem, auto, auto;
  }

  .product-preview-media::after {
    content: 'Preview shell';
    position: absolute;
    right: 0.8rem;
    bottom: 0.7rem;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .product-preview-media span {
    position: relative;
    z-index: 1;
    color: var(--accent-gold-light);
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .product-preview-media i {
    position: absolute;
    width: 8rem;
    height: 8rem;
    border: 1px solid rgba(var(--gold-rgb), 0.24);
    transform: rotate(45deg);
  }

  .product-preview-body {
    min-height: 15rem;
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.3rem 1.35rem 1.4rem;
  }

  .product-preview-category,
  .product-preview-status {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  .product-preview-category {
    margin-bottom: 0.55rem;
    color: var(--ink-faint);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
  }

  h3 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    text-transform: none;
  }

  .product-preview-summary {
    flex: 1;
    color: var(--ink-dim);
    font-size: 0.88rem;
  }

  .product-preview-status {
    margin: 1.1rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    color: var(--accent-gold-light);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    line-height: 1.6;
  }
</style>
