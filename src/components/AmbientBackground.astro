---
const { deferUntilHero = false } = Astro.props;
---

<!-- One decorative media instance per page. It belongs to the page shell rather
     than to individual sections so the atmosphere carries naturally between
     sections without adding competing video decoders. -->
<div class="ambient-page-media" aria-hidden="true">
  <video
    class="ambient-page-video"
    data-src="/videos/hero-background.mp4"
    data-defer-until-hero={deferUntilHero ? 'true' : undefined}
    poster="/videos/hero-background-poster.webp"
    autoplay
    muted
    loop
    playsinline
    preload="none"
    disablepictureinpicture
    disableremoteplayback
    tabindex="-1"
  ></video>
</div>

<script>
  function initAmbientBackgrounds() {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    document.querySelectorAll('.ambient-page-video').forEach((video) => {
      if (!(video instanceof HTMLVideoElement) || video.dataset.wired === 'true') return;
      video.dataset.wired = 'true';

      let heroObserver;
      const deferUntilHero = video.dataset.deferUntilHero === 'true';

      const unload = () => {
        video.pause();
        if (video.hasAttribute('src')) {
          video.removeAttribute('src');
          video.load();
        }
      };

      // A 4 MB decorative loop was being fetched on every page view, including
      // on phones over mobile data, where it saturated the connection before
      // the page's own content had finished arriving. Measured on the live site
      // at 4,220 KB per navigation against a 3 KB category page. The poster
      // still carries the look; the video is an enhancement for connections and
      // screens that can afford it, not a prerequisite for reading the site.
      const canAffordVideo = () => {
        if (reducedMotion.matches) return false;
        // Decorative background behind content: on a phone it is barely seen
        // and costs the most, so it does not load there at all.
        if (window.matchMedia('(max-width: 820px)').matches) return false;
        const conn =
          navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        if (conn) {
          if (conn.saveData) return false;
          if (/(^|-)2g$/.test(conn.effectiveType || '')) return false;
          if (conn.effectiveType === '3g') return false;
        }
        if (typeof navigator.deviceMemory === 'number' && navigator.deviceMemory <= 4) return false;
        return true;
      };

      const load = () => {
        if (!canAffordVideo()) {
          unload();
          return;
        }

        const source = video.dataset.src;
        if (!source) return;
        video.muted = true;
        video.autoplay = true;
        if (!video.hasAttribute('src')) video.src = source;
        video.play().catch(() => {});
      };

      const syncMotion = () => {
        if (!deferUntilHero) {
          load();
          return;
        }

        const hero = document.querySelector('.hero');
        if (!hero) {
          load();
          return;
        }

        heroObserver?.disconnect();
        heroObserver = new IntersectionObserver(([entry]) => {
          // The approved hero remains the only moving background while it is
          // onscreen. The ambient layer starts only once the visitor reaches
          // the content below it, avoiding two concurrent copies on load.
          if (entry.isIntersecting) unload();
          else load();
        }, { threshold: 0.01 });
        heroObserver.observe(hero);
      };

      reducedMotion.addEventListener('change', syncMotion);
      syncMotion();
    });
  }

  initAmbientBackgrounds();
  document.addEventListener('astro:page-load', initAmbientBackgrounds);
</script>
