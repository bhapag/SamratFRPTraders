---
import { navigation, site } from '../data/site.js';

const currentPath = Astro.url.pathname;
const isCurrent = (href) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand-name">{site.name}</span>
      <span class="brand-descriptor">{site.descriptor}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <details class="mobile-menu" id="siteMenu">
      <summary aria-label="Open navigation menu">
        <span class="menu-label">Menu</span>
        <span class="menu-bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>
      <nav aria-label="Mobile navigation">
        {navigation.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const menu = document.getElementById('siteMenu');

  if (header instanceof HTMLElement && header.dataset.scrollWired !== 'true') {
    header.dataset.scrollWired = 'true';
    const syncScrollState = () => {
      header.classList.toggle('scrolled', window.scrollY > 6);
    };
    syncScrollState();
    window.addEventListener('scroll', syncScrollState, { passive: true });
  }

  if (menu instanceof HTMLDetailsElement && menu.dataset.wired !== 'true') {
    menu.dataset.wired = 'true';
    const summary = menu.querySelector('summary');
    const label = menu.querySelector('.menu-label');
    const desktopQuery = window.matchMedia('(min-width: 48.001rem)');

    const syncMenu = () => {
      summary?.setAttribute('aria-label', menu.open ? 'Close navigation menu' : 'Open navigation menu');
      if (label) label.textContent = menu.open ? 'Close' : 'Menu';
    };

    const closeMenu = (restoreFocus = false) => {
      if (!menu.open) return;
      menu.open = false;
      if (restoreFocus && summary instanceof HTMLElement) summary.focus();
    };

    menu.addEventListener('toggle', syncMenu);
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu()));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu(true);
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) closeMenu();
    });
    desktopQuery.addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });
    syncMenu();
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(var(--gold-rgb), 0.16);
    background: rgba(10, 13, 18, 0.9);
    box-shadow: 0 0.7rem 2rem rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(0.8rem);
    transition:
      background 260ms var(--ease-premium),
      border-color 260ms var(--ease-premium),
      box-shadow 260ms var(--ease-premium);
  }

  .site-header.scrolled {
    border-bottom-color: rgba(var(--gold-rgb), 0.28);
    background: rgba(9, 11, 15, 0.97);
    box-shadow: 0 0.9rem 2.4rem rgba(0, 0, 0, 0.34);
  }

  .header-inner {
    min-height: 4.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    min-width: 0;
    display: grid;
    gap: 0.08rem;
    color: var(--ink);
    text-decoration: none;
  }

  .brand-name {
    overflow: hidden;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.1;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .brand-descriptor {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.35rem, 1.6vw, 1.3rem);
  }

  .desktop-nav a,
  .mobile-menu a {
    position: relative;
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms var(--ease-premium);
  }

  .desktop-nav a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding-inline: 0.45rem;
  }

  .desktop-nav a::after {
    content: '';
    position: absolute;
    right: 0.45rem;
    bottom: 0.35rem;
    left: 0.45rem;
    height: 1px;
    transform: scaleX(0);
    background: var(--accent-gold);
    transition: transform 180ms var(--ease-premium);
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'],
  .mobile-menu a:hover,
  .mobile-menu a[aria-current='page'] {
    color: var(--accent-gold-light);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    width: 4.7rem;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border: 1px solid var(--line-2);
    color: var(--ink);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    list-style: none;
    text-transform: uppercase;
    transition: border-color 180ms var(--ease-premium), color 180ms var(--ease-premium);
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary:hover,
  .mobile-menu[open] summary {
    border-color: var(--accent-gold);
    color: var(--accent-gold-light);
  }

  .menu-bars {
    width: 1rem;
    display: grid;
    gap: 0.2rem;
  }

  .menu-bars span {
    height: 1px;
    display: block;
    background: currentColor;
    transition: transform 180ms var(--ease-premium), opacity 180ms var(--ease-premium);
  }

  .mobile-menu[open] .menu-bars span:nth-child(1) {
    transform: translateY(0.25rem) rotate(45deg);
  }

  .mobile-menu[open] .menu-bars span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu[open] .menu-bars span:nth-child(3) {
    transform: translateY(-0.25rem) rotate(-45deg);
  }

  .mobile-menu nav {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    width: min(19rem, calc(100vw - 2rem));
    display: grid;
    border: 1px solid var(--line-2);
    background: var(--bg-2);
    box-shadow: var(--surface-shadow-hover);
  }

  .mobile-menu a {
    min-height: 3.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .mobile-menu a::after {
    content: '→';
    color: var(--accent-gold);
  }

  .mobile-menu a:last-child {
    border-bottom: 0;
  }

  @media (max-width: 48rem) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 25rem) {
    .brand-descriptor {
      display: none;
    }

    .brand-name {
      font-size: 0.9rem;
    }
  }
</style>
