---
// Single shared card used everywhere multiple products/categories are
// listed (catalogue index, family pages, homepage). `showMedia` opts a
// call site into the image-first product-photo treatment; category-level
// cards (no per-product photo concept) omit it and render exactly as
// before. Product records currently supply approved detail/gallery artwork
// here, which is a text-rich promotional layout for every product (no
// plain packshots exist in the asset library). The media viewport below
// is a fixed-height, `overflow: hidden` box with the image absolutely
// positioned (`inset: 0` + `object-fit: contain`) so the asset is always
// letterboxed to fit — it can never inflate the box or bleed into the
// card body below it, regardless of the image's own intrinsic size.
import { cardDerivatives } from '../data/card-derivatives.js';

const {
  name,
  eyebrow,
  href,
  description,
  search,
  category,
  image,
  imageAlt,
  showMedia = false,
  ctaLabel,
} = Astro.props;
const searchValue = search ?? `${name} ${eyebrow ?? ''}`.toLowerCase();

// The card paints the image at roughly 100-160px. Serving a full product asset
// into that box cost 3.5MB across the catalogue index on a phone. Where
// derivatives exist they are offered first and the browser picks one; the
// product page still shows the full asset. The three owner-supplied originals
// have no derivative by design, so their cards load the file as supplied.
const cardBase =
  image && cardDerivatives.has(image.src)
    ? `/images/products/cards/${image.src.replace(/\.(jpe?g|png|webp)$/i, '')}`
    : null;
// The stage paints at 126 CSS px on a 390px phone and at most 168px on desktop,
// so the rungs are 256w (2x phone), 384w (3x phone) and 512w (3x desktop). The
// full asset stays in the list as the last candidate for anything wider.
const cardSrcset = cardBase
  ? `${cardBase}-256.webp 256w, ${cardBase}-384.webp 384w, ${cardBase}-512.webp 512w, /images/products/${image.src} ${image.width}w`
  : null;
---
<a
  class:list={['catalog-card', { 'has-media': showMedia }]}
  href={href}
  data-catalog-card
  data-search={searchValue}
  data-category={category}
>
  {showMedia && (
    image ? (
      <span class="catalog-card-stage">
        <img
          src={cardBase ? `${cardBase}-256.webp` : `/images/products/${image.src}`}
          srcset={cardSrcset ?? undefined}
          sizes="(max-width: 30rem) 8rem, 10.5rem"
          alt={imageAlt ?? ''}
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
          fetchpriority="low"
        />
      </span>
    ) : (
      <span class="catalog-card-stage catalog-card-stage-empty" aria-hidden="true">
        <img class="catalog-card-mark" src="/brand/samrat-frp-traders-mark.png" alt="" width="160" height="160" loading="lazy" />
      </span>
    )
  )}
  <span class="catalog-card-body">
    <span class="catalog-card-eyebrow">{eyebrow}</span>
    <span class="catalog-card-name">{name}</span>
    {description && <span class="catalog-card-desc">{description}</span>}
    {showMedia ? (
      <span class="catalog-card-cta">
        {ctaLabel && <span class="catalog-card-cta-label">{ctaLabel}</span>}
        <span class="catalog-card-cta-arrow" aria-hidden="true">→</span>
      </span>
    ) : (
      <span class="catalog-card-arrow" aria-hidden="true">→</span>
    )}
  </span>
</a>

<style>
  .catalog-card {
    position: relative;
    min-height: 8.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    padding: 1.3rem 1.35rem;
    padding-right: 2.6rem;
    border: 1px solid var(--line);
    background: var(--bg-3);
    box-shadow: var(--surface-shadow-rest);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 220ms var(--ease-premium),
      transform 220ms var(--ease-premium),
      box-shadow 220ms var(--ease-premium);
  }

  .catalog-card:hover {
    transform: translateY(-0.2rem);
    border-color: var(--line-2);
    background: color-mix(in srgb, var(--ink) 3%, var(--bg-3));
    box-shadow: var(--surface-shadow-hover);
  }

  .catalog-card:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .catalog-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    min-width: 0;
  }

  .catalog-card-eyebrow {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .catalog-card-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .catalog-card-desc {
    color: var(--ink-dim);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .catalog-card-arrow {
    position: absolute;
    top: 1.15rem;
    right: 1.2rem;
    color: var(--accent-gold);
    font-size: 1.05rem;
    line-height: 1;
    transition: transform 220ms var(--ease-premium);
  }

  .catalog-card:hover .catalog-card-arrow {
    transform: translateX(0.2rem);
  }

  /* ---------- Image-first variant (product cards) ---------- */
  /* The card is its own container, so the media layout is chosen from the
     width the card actually got rather than from the viewport. The same card
     is used full-bleed on a phone (328–478px) and as a grid column on tablet
     and desktop (250–345px) — widths a viewport breakpoint cannot tell apart.

     Row is the base and stacking is the enhancement, so a browser without
     container query support falls back to the layout that is safe at every
     width rather than to a full-bleed square. */
  .catalog-card.has-media {
    min-height: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    padding: 0;
    padding-right: 0;
    overflow: hidden;
    container-type: inline-size;
  }

  /* Ratio-driven media viewport.

     The frame's height comes from `aspect-ratio`, never from the asset, so a
     poster can neither inflate the card nor reach the title below it — the
     failure this component was written to prevent. `overflow: hidden` here and
     on `.has-media` above remain the backstop.

     The ratio is 1:1 because that is what the catalogue artwork actually is:
     the 31 card images measure 0.842–1.031 wide/tall, and 22 of them are
     square. A square frame therefore lets most assets fill their full width
     and leaves ~8% either side on the tallest one. The previous frame was a
     fixed height against a full-bleed width — about 2:1 on a phone — so square
     artwork could only ever paint half the width it was given, and the other
     half was empty background.

     `max-block-size` bounds the one regime a ratio cannot: a card wide enough
     that a true square becomes an oversized frame — two-column tablet layouts,
     and the single-column category hub between 545px and 599px. The artwork is
     ~700px on its long edge and is already being downscaled at 343px, so there
     is nothing to gain from a frame taller than 18rem; past that the square
     only costs scroll depth. Where the cap bites, the widest asset still fills
     84% of the frame width — against 47% before this change. */
  .catalog-card-stage {
    position: relative;
    flex: 0 0 clamp(6.5rem, 30vw, 10.5rem);
    flex-basis: clamp(6.5rem, 36cqi, 10.5rem);
    align-self: center;
    aspect-ratio: 1 / 1;
    margin: 0.8rem 0 0.8rem 0.8rem;
    overflow: hidden;
    border: 1px solid var(--line);
    background:
      radial-gradient(circle at 50% -40%, rgba(var(--gold-rgb), 0.14), transparent 68%),
      linear-gradient(160deg, var(--bg-3), var(--bg));
    transition: background 220ms var(--ease-premium);
  }

  /* `inset: 0` + `width/height: 100%` resolve against the stage's padding box,
     which is always a definite size — the reliable way to letterbox. The inner
     breathing room is padding on the image itself: with `box-sizing:
     border-box` (set globally) `object-fit` works against the content box, so
     the artwork is inset without the stage losing its definite size. */
  .catalog-card-stage img:not(.catalog-card-mark) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0.45rem;
    object-fit: contain;
    object-position: center center;
    transition: transform 320ms var(--ease-premium);
  }

  .catalog-card.has-media:hover .catalog-card-stage img {
    transform: scale(1.03);
  }

  .catalog-card-stage-empty {
    display: grid;
    place-items: center;
    padding: 1.6rem;
  }

  .catalog-card-mark {
    width: 40%;
    height: auto;
    opacity: 0.28;
  }

  .catalog-card.has-media .catalog-card-body {
    flex: 1 1 0;
    min-width: 0;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.85rem 0.95rem 0.8rem;
  }

  .catalog-card.has-media .catalog-card-cta {
    min-height: 2.5rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
  }

  /* A card wide enough that a row would leave the body stranded — the
     single-column category hub between 545px and 599px — stacks instead, with
     `max-block-size` bounding the square. */
  @container (min-width: 30rem) {
    .catalog-card-stage {
      flex-basis: 100%;
      align-self: stretch;
      margin: 0;
      max-block-size: 18rem;
      border: 0;
      border-bottom: 1px solid var(--line);
    }

    .catalog-card-stage img:not(.catalog-card-mark) {
      padding: 0.85rem;
    }

    .catalog-card.has-media .catalog-card-body {
      flex: 0 0 100%;
      justify-content: flex-start;
      gap: 0.5rem;
      padding: 1.1rem 1.2rem 1.25rem;
    }
  }

  .catalog-card.has-media .catalog-card-name {
    font-size: 1.02rem;
    line-height: 1.12;
  }

  @container (min-width: 30rem) {
    .catalog-card.has-media .catalog-card-name {
      font-size: 1.05rem;
      line-height: 1.08;
    }
  }

  .catalog-card-cta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.2rem;
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .catalog-card-cta-arrow {
    transition: transform 220ms var(--ease-premium);
  }

  .catalog-card.has-media:hover .catalog-card-cta-arrow {
    transform: translateX(0.2rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog-card,
    .catalog-card-stage img:not(.catalog-card-mark),
    .catalog-card-arrow,
    .catalog-card-cta-arrow {
      transition: none;
    }
  }

  @media (max-width: 40rem) {
    .catalog-card:not(.has-media) {
      min-height: 0;
      gap: 0.7rem;
      padding: 1.1rem 1.15rem;
      padding-right: 2.55rem;
    }

    .catalog-card-name {
      font-size: 1.18rem;
      line-height: 1.04;
    }

    .catalog-card-desc {
      font-size: 0.82rem;
      line-height: 1.48;
    }

    .catalog-card.has-media .catalog-card-body {
      gap: 0.4rem;
      padding: 0.95rem 1.05rem 1.05rem;
    }

    .catalog-card.has-media .catalog-card-name {
      font-size: 1.14rem;
    }

    .catalog-card-cta {
      min-height: 2.5rem;
      align-items: center;
      justify-content: space-between;
      margin-top: 0.35rem;
      padding-top: 0.45rem;
      border-top: 1px solid var(--line);
    }
  }
</style>
