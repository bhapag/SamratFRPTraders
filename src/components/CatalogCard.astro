---
// Single shared card used everywhere multiple products/categories are
// listed (catalogue index, family pages, homepage). `showMedia` opts a
// call site into the image-first product-photo treatment; category-level
// cards (no per-product photo concept) omit it and render exactly as
// before. The image itself always comes from `product.images[0]` at the
// call site — this component never maintains its own image mapping.
const {
  name,
  eyebrow,
  href,
  description,
  search,
  category,
  image,
  imageAlt,
  showMedia = false,
  ctaLabel,
} = Astro.props;
const searchValue = search ?? `${name} ${eyebrow ?? ''}`.toLowerCase();
---
<a
  class:list={['catalog-card', { 'has-media': showMedia }]}
  href={href}
  data-catalog-card
  data-search={searchValue}
  data-category={category}
>
  {showMedia && (
    image ? (
      <span class="catalog-card-stage">
        <img
          src={`/images/products/${image.src}`}
          alt={imageAlt ?? ''}
          width={image.width}
          height={image.height}
          loading="lazy"
          decoding="async"
        />
      </span>
    ) : (
      <span class="catalog-card-stage catalog-card-stage-empty" aria-hidden="true">
        <img class="catalog-card-mark" src="/brand/samrat-frp-traders-mark.png" alt="" width="160" height="160" loading="lazy" />
      </span>
    )
  )}
  <span class="catalog-card-body">
    <span class="catalog-card-eyebrow">{eyebrow}</span>
    <span class="catalog-card-name">{name}</span>
    {description && <span class="catalog-card-desc">{description}</span>}
    {showMedia ? (
      <span class="catalog-card-cta">
        {ctaLabel && <span class="catalog-card-cta-label">{ctaLabel}</span>}
        <span class="catalog-card-cta-arrow" aria-hidden="true">→</span>
      </span>
    ) : (
      <span class="catalog-card-arrow" aria-hidden="true">→</span>
    )}
  </span>
</a>

<style>
  .catalog-card {
    position: relative;
    min-height: 8.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    padding: 1.3rem 1.35rem;
    padding-right: 2.6rem;
    border: 1px solid var(--line);
    background: var(--bg-3);
    box-shadow: var(--surface-shadow-rest);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 220ms var(--ease-premium),
      transform 220ms var(--ease-premium),
      box-shadow 220ms var(--ease-premium);
  }

  .catalog-card:hover {
    transform: translateY(-0.2rem);
    border-color: var(--line-2);
    background: color-mix(in srgb, var(--ink) 3%, var(--bg-3));
    box-shadow: var(--surface-shadow-hover);
  }

  .catalog-card:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .catalog-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    min-width: 0;
  }

  .catalog-card-eyebrow {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .catalog-card-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .catalog-card-desc {
    color: var(--ink-dim);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .catalog-card-arrow {
    position: absolute;
    top: 1.15rem;
    right: 1.2rem;
    color: var(--accent-gold);
    font-size: 1.05rem;
    line-height: 1;
    transition: transform 220ms var(--ease-premium);
  }

  .catalog-card:hover .catalog-card-arrow {
    transform: translateX(0.2rem);
  }

  /* ---------- Image-first variant (product cards) ---------- */
  .catalog-card.has-media {
    min-height: 0;
    gap: 0;
    padding: 0;
    padding-right: 0;
    overflow: hidden;
  }

  /* Aspect ratio chosen against the actual approved product photography
     (near-square marketing panels, ~0.84–1.02 width/height) rather than a
     blind 1:1 — this keeps contain-fit letterboxing under ~6% per side
     across every current image instead of leaving visible empty bands. */
  .catalog-card-stage {
    display: block;
    aspect-ratio: 1 / 1.05;
    padding: 0.9rem;
    border-bottom: 1px solid var(--line);
    background: linear-gradient(160deg, var(--bg-3), var(--bg));
    transition: background 220ms var(--ease-premium);
  }

  .catalog-card-stage img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform 320ms var(--ease-premium);
  }

  .catalog-card.has-media:hover .catalog-card-stage img {
    transform: scale(1.03);
  }

  .catalog-card-stage-empty {
    display: grid;
    place-items: center;
    padding: 1.6rem;
  }

  .catalog-card-mark {
    width: 40%;
    height: auto;
    opacity: 0.28;
  }

  .catalog-card.has-media .catalog-card-body {
    flex: initial;
    justify-content: flex-start;
    gap: 0.5rem;
    padding: 1.1rem 1.2rem 1.25rem;
  }

  .catalog-card.has-media .catalog-card-name {
    font-size: 1.05rem;
  }

  .catalog-card-cta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.2rem;
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .catalog-card-cta-arrow {
    transition: transform 220ms var(--ease-premium);
  }

  .catalog-card.has-media:hover .catalog-card-cta-arrow {
    transform: translateX(0.2rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog-card,
    .catalog-card-stage img,
    .catalog-card-arrow,
    .catalog-card-cta-arrow {
      transition: none;
    }
  }
</style>
