---
import Breadcrumbs from '../Breadcrumbs.astro';
import CatalogCard from '../CatalogCard.astro';
import { getProductContent } from '../../data/product-content.js';
import { getGroup } from '../../data/products.js';
import { buildCanonicalUrl, buildProductQuoteLink } from '../../data/site.js';
import {
  applicationsFor,
  comparisonsFor,
  guidesFor,
  localDocUrl,
  productImageAlt,
  relatedProductsFor,
  resourcesFor,
  sdsDoc,
  tdsDoc,
} from '../../utils/product-page.js';

const {
  product,
  lang = 'en',
  prefix = '',
  breadcrumbItems = [],
  description = '',
} = Astro.props;

const isNe = lang === 'ne';
const group = getGroup(product.group);
const content = getProductContent(product.slug);
const localized = content ? (isNe ? content.ne : content.en) : null;

const apps = applicationsFor(product).slice(0, 6);
const allResources = resourcesFor(product);
const comparisons = comparisonsFor(product);
const guides = guidesFor(product);
const related = relatedProductsFor(product);
const tds = tdsDoc(product);
const sds = sdsDoc(product);
const tdsLocal = localDocUrl(tds);
const sdsLocal = localDocUrl(sds);
const highlights = product.technicalHighlights ?? [];
const evidence = product.technicalEvidenceStatus === 'verified';
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname);
const productImages = product.images && product.images.length > 0 ? product.images : null;
const imageAlt = productImages ? productImageAlt(product, isNe) : '';
const galleryLabel = isNe ? 'उत्पादन तस्बिर ग्यालरी' : 'Product image gallery';
const prevLabel = isNe ? 'अघिल्लो तस्बिर' : 'Previous image';
const nextLabel = isNe ? 'अर्को तस्बिर' : 'Next image';
const thumbLabel = (i) => (isNe ? `तस्बिर ${i + 1} हेर्नुहोस्` : `View image ${i + 1}`);

const t = isNe
  ? {
      docsTitle: 'प्राविधिक कागजातहरू',
      tdsButton: 'प्राविधिक डाटा शीट (TDS) डाउनलोड गर्नुहोस् (PDF)',
      sdsButton: 'सुरक्षा डाटा शीट (SDS) डाउनलोड गर्नुहोस् (PDF)',
      catalogueTitle: 'पूर्ण उत्पादन दायरा चाहिन्छ?',
      catalogueDesc: 'हाम्रो पूर्ण FRP सामग्री तथा रेजिन दायरा हेर्नुहोस्।',
      catalogueLabel: 'उत्पादन क्याटलग डाउनलोड गर्नुहोस्',
      issuedBy: 'TDS/SDS जारीकर्ता',
      priceHeading: 'मूल्य',
      priceValue: 'मूल्य: अनुरोधमा',
      priceNote: `${product.name} को मूल्य निम्न कुरामा निर्भर गर्दछ:`,
      priceFactors: ['अर्डर परिमाण', 'उत्पादन / Resin ग्रेड', 'हालको कच्चा पदार्थ दर'],
      bulkQuote: 'थोक कोटेशन माग्नुहोस्',
      enquire: 'सोधपुछ / कोटेशन',
      whatsapp: 'WhatsApp',
      mediaNote: 'उत्पादन फोटो — स्वामीबाट प्राप्त भएपछि यहाँ देखाइनेछ।',
      aboutTitle: 'उत्पादनबारे थप',
      buyerTitle: 'खरिदकर्ताका लागि यसको अर्थ',
      featuresTitle: 'मुख्य विशेषताहरू',
      industriesTitle: 'सेवा क्षेत्रहरू',
      specsTitle: 'प्राविधिक विवरण',
      specsSource: 'स्रोत',
      detailsTitle: 'उत्पादन विवरण',
      family: 'उत्पादन समूह',
      docs: 'कागजातहरू',
      supplier: 'आपूर्तिकर्ता',
      evidenceLabel: 'प्रमाण स्थिति',
      evidenceVerified: 'आपूर्तिकर्ता कागजातसँग पुष्टि गरिएको',
      evidencePending: 'पुष्टि हुँदै',
      enquiry: 'सोधपुछ',
      enquiryVia: 'सम्पर्क पृष्ठबाट',
      appsTitle: 'प्रयोगहरू',
      appsMore: 'सबै प्रयोगहरू हेर्नुहोस्',
      compareTitle: 'उत्पादन तुलनाहरू',
      faqTitle: 'सामान्य प्रश्नहरू',
      relatedTitle: 'सम्बन्धित उत्पादनहरू',
      hubTitle: 'प्राविधिक जानकारी केन्द्र',
      hubMore: 'सबै स्रोतहरू',
    }
  : {
      docsTitle: 'Technical documents',
      tdsButton: 'Download Technical Data Sheet (PDF)',
      sdsButton: 'Download Safety Data Sheet (SDS) (PDF)',
      catalogueTitle: 'Need our complete product range?',
      catalogueDesc: 'Explore our complete FRP materials and resin range.',
      catalogueLabel: 'Download Product Catalogue',
      issuedBy: 'TDS/SDS issued by',
      priceHeading: 'Price',
      priceValue: 'PRICE ON REQUEST',
      priceNote: `${product.name} pricing varies based on:`,
      priceFactors: ['Order Quantity', 'Product / Resin Grade', 'Current Raw Material Rates'],
      bulkQuote: 'Request Bulk Quote',
      enquire: 'Enquire / get quote',
      whatsapp: 'WhatsApp',
      mediaNote: 'Product photography — owner input required. This area is reserved for the official product visual.',
      aboutTitle: 'About this product',
      buyerTitle: 'What this means for buyers',
      featuresTitle: 'Key features',
      industriesTitle: 'Industries served',
      specsTitle: 'Technical specifications',
      specsSource: 'Source',
      detailsTitle: 'Product details',
      family: 'Product family',
      docs: 'Documents',
      supplier: 'Supplier',
      evidenceLabel: 'Evidence status',
      evidenceVerified: 'Verified against supplier documentation',
      evidencePending: 'Being verified',
      enquiry: 'Enquiries',
      enquiryVia: 'Via the contact page',
      appsTitle: 'Applications',
      appsMore: 'Browse all applications',
      compareTitle: 'Product comparisons',
      faqTitle: 'Frequently asked questions',
      relatedTitle: 'Related products',
      hubTitle: 'Technical resource hub',
      hubMore: 'All resources',
    };

const bulkWa = buildProductQuoteLink(product.name, lang);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: buildCanonicalUrl(item.href) } : {}),
  })),
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  ...(product.alternateName ? { alternateName: product.alternateName } : {}),
  description: description || product.metaDescription || product.descriptor || '',
  ...(group ? { category: group.name } : {}),
  url: canonicalUrl,
  brand: { '@type': 'Brand', name: 'Samrat Poly Resins' },
  ...(highlights.length > 0
    ? {
        additionalProperty: highlights.map((item) => ({
          '@type': 'PropertyValue',
          name: item.label,
          value: item.value,
        })),
      }
    : {}),
};

const faqSchema =
  localized?.faqs && localized.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: localized.faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.q,
          acceptedAnswer: { '@type': 'Answer', text: faq.a },
        })),
      }
    : null;
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

<Breadcrumbs items={breadcrumbItems} />

<div class="product-top" data-reveal>
  <div class="product-media">
    {productImages && productImages.length === 1 ? (
      <div class="gallery-single">
        <img
          src={`/images/products/${productImages[0].src}`}
          alt={imageAlt}
          width={productImages[0].width}
          height={productImages[0].height}
          fetchpriority="high"
        />
      </div>
    ) : productImages ? (
      <div class="product-gallery" data-gallery aria-label={galleryLabel}>
        <div class="gallery-main" data-gallery-main>
          {productImages.map((img, i) => (
            <img
              class="gallery-slide"
              data-gallery-slide
              src={`/images/products/${img.src}`}
              alt={imageAlt}
              width={img.width}
              height={img.height}
              fetchpriority={i === 0 ? 'high' : undefined}
              loading={i === 0 ? 'eager' : 'lazy'}
              hidden={i !== 0}
            />
          ))}
          <button type="button" class="gallery-nav gallery-prev" data-gallery-prev aria-label={prevLabel}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
          </button>
          <button type="button" class="gallery-nav gallery-next" data-gallery-next aria-label={nextLabel}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
          </button>
        </div>
        <div class="gallery-thumbs">
          {productImages.map((img, i) => (
            <button
              type="button"
              class:list={['gallery-thumb', { 'is-active': i === 0 }]}
              data-gallery-thumb
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-label={thumbLabel(i)}
            >
              <img src={`/images/products/${img.src}`} alt="" width={img.width} height={img.height} loading="lazy" />
            </button>
          ))}
        </div>
      </div>
    ) : (
      <div
        class="media-frame"
        role="img"
        aria-label={isNe ? 'उत्पादन फोटोको लागि आरक्षित क्षेत्र' : 'Reserved product photography area'}
      >
        <img class="media-mark" src="/brand/samrat-frp-traders-mark.png" alt="" width="320" height="320" />
        <p class="media-note">{t.mediaNote}</p>
      </div>
    )}
  </div>

  <div class="product-actions">
    <div class="prod-quote">
      <p class="prod-quote-heading">{t.priceHeading}</p>
      <p class="prod-quote-value">{t.priceValue}</p>
      <p class="prod-quote-note">{t.priceNote}</p>
      <ul class="prod-quote-list">
        {t.priceFactors.map((factor) => <li>{factor}</li>)}
      </ul>
      <a class="button button-primary prod-quote-cta" href={bulkWa} target="_blank" rel="noopener">
        {t.bulkQuote}
      </a>
    </div>

    {tds && (
      <div class="prod-cta">
        <a
          class="button button-primary"
          href={tdsLocal ?? tds.url}
          target="_blank"
          rel="noopener"
          download
          aria-label={`${t.tdsButton} — ${product.name}`}
        >
          {t.tdsButton}
        </a>
      </div>
    )}

    {sds && (
      <div class="prod-cta">
        <a
          class="button button-primary"
          href={sdsLocal ?? sds.url}
          target="_blank"
          rel="noopener"
          download
          aria-label={`${t.sdsButton} — ${product.name}`}
        >
          {t.sdsButton}
        </a>
      </div>
    )}

    <div class="prod-cta prod-cta-row">
      <a class="button button-primary" href={`${prefix}/contact/`}>{t.enquire}</a>
      <a class="button wa-button" href={bulkWa} target="_blank" rel="noopener">{t.whatsapp}</a>
    </div>

    <div class="prod-catalogue-note">
      <p class="prod-catalogue-heading">{t.catalogueTitle}</p>
      <a
        class="prod-catalogue-link"
        href="/downloads/samrat-frp-traders-product-catalogue.pdf"
        target="_blank"
        rel="noopener"
        download
        aria-label={isNe
          ? 'Samrat FRP Traders उत्पादन क्याटलग (PDF) डाउनलोड गर्नुहोस्'
          : 'Download Samrat FRP Traders Product Catalogue (PDF)'}
      >
        {t.catalogueLabel} (PDF) →
      </a>
      <p class="prod-catalogue-desc">{t.catalogueDesc}</p>
    </div>

    <p class="doc-note">{t.issuedBy}: Samrat Poly Resins, India</p>
  </div>
</div>

<div class="product-layout">
  <div class="product-main">
    {product.descriptor && <p class="product-descriptor" data-reveal>{product.descriptor}</p>}

    {localized?.intro && localized.intro.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.aboutTitle}</h2>
        <div class="prose">
          {localized.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>
    )}

    {localized?.buyerNotes && localized.buyerNotes.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.buyerTitle}</h2>
        <div class="note-grid">
          {localized.buyerNotes.map((note) => (
            <div class="note-card">
              <h3>{note.title}</h3>
              <p>{note.text}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {localized?.features && localized.features.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.featuresTitle}</h2>
        <ul class="feature-list">
          {localized.features.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {highlights.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.specsTitle}</h2>
        <dl class="spec-table">
          {highlights.map((item) => (
            <div class="spec-row">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
        {product.technicalSource && (
          <p class="spec-source">
            {t.specsSource}: {product.technicalSource.issuer} — {product.technicalSource.type}
            {[product.technicalSource.reference, product.technicalSource.revision, product.technicalSource.date]
              .filter(Boolean)
              .join(' · ')}
          </p>
        )}
      </section>
    )}

    <section class="panel" data-reveal>
      <h2 class="panel-title">{t.detailsTitle}</h2>
      <div class="fact-grid">
        <div class="fact">
          <span>{t.family}</span>
          <strong>{group?.name ?? '—'}</strong>
        </div>
        <div class="fact">
          <span>{t.docs}</span>
          <strong>{[tds, sds].filter(Boolean).map((d) => d.type).join(' · ') || '—'}</strong>
        </div>
        <div class="fact">
          <span>{t.supplier}</span>
          <strong>Samrat Poly Resins, India</strong>
        </div>
        <div class="fact">
          <span>{t.evidenceLabel}</span>
          <strong>{evidence ? t.evidenceVerified : t.evidencePending}</strong>
        </div>
        <div class="fact">
          <span>{t.enquiry}</span>
          <strong><a href={`${prefix}/contact/`}>{t.enquiryVia}</a></strong>
        </div>
      </div>
    </section>

    {apps.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.appsTitle}</h2>
        {localized?.applicationsIntro && <p class="panel-lead">{localized.applicationsIntro}</p>}
        <div class="app-grid">
          {apps.map((app) => (
            <a class="app-card" href={`${prefix}/applications/${app.slug}/`}>
              <span class="app-media">
                {app.cardImage && (
                  <img
                    src={`/images/applications/${app.cardImage}`}
                    alt={app.cardImageAlt ?? ''}
                    loading="lazy"
                    width="700"
                    height="466"
                  />
                )}
              </span>
              <span class="app-body">
                <span class="app-title">{app.title}</span>
                <span class="app-desc">{app.cardDescription}</span>
              </span>
            </a>
          ))}
        </div>
        <div class="section-actions">
          <a class="button" href={`${prefix}/applications/`}>{t.appsMore}</a>
        </div>
      </section>
    )}

    {localized?.industries && localized.industries.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.industriesTitle}</h2>
        <ul class="feature-list feature-list-grid">
          {localized.industries.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {comparisons.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.compareTitle}</h2>
        <div class="compare-grid">
          {comparisons.map((r) => (
            <a class="compare-card" href={`${prefix}/resources/${r.slug}/`}>
              <span class="compare-title">{r.title}</span>
              <span class="compare-desc">{r.description}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {localized?.faqs && localized.faqs.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.faqTitle}</h2>
        <div class="faq-list">
          {localized.faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {!content && product.overview && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.aboutTitle}</h2>
        <div class="prose"><p>{product.overview}</p></div>
      </section>
    )}
  </div>

  <aside class="product-side" data-reveal>
    {related.length > 0 && (
      <div class="side-block">
        <p class="side-title">{t.relatedTitle}</p>
        <div class="side-list">
          {related.map((p) => (
            <a href={`${prefix}/products/${p.slug}/`}>
              <strong>{p.name}</strong>
              <span>{getGroup(p.group)?.name ?? ''}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    {guides.length > 0 && (
      <div class="side-block">
        <p class="side-title">{t.hubTitle}</p>
        <div class="side-list">
          {guides.map((r) => (
            <a href={`${prefix}/resources/${r.slug}/`}>
              <strong>{r.title}</strong>
              <span>{r.readingTime}</span>
            </a>
          ))}
        </div>
        {allResources.length > guides.length && (
          <a class="side-more" href={`${prefix}/resources/`}>{t.hubMore} →</a>
        )}
      </div>
    )}
  </aside>
</div>

<style>
  .product-top {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
    margin-top: 2rem;
  }

  .media-frame {
    display: grid;
    place-items: center;
    gap: 1rem;
    padding: 2rem;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
    background: linear-gradient(160deg, var(--bg-3), var(--bg));
    text-align: center;
  }

  .media-mark {
    width: 5.5rem;
    height: auto;
    opacity: 0.3;
  }

  .media-note {
    max-width: 22ch;
    margin: 0;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.08em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  /* Owner-supplied product photography. The frame wraps snugly around
     each image at its own natural aspect ratio — no fixed box, no
     letterboxing, no forced cropping. `width`/`height` attributes (from
     the real file dimensions in products.js) reserve the correct space
     before the image loads; `height: auto` then lets it render at its
     true proportions. */
  .gallery-single {
    display: inline-block;
    width: 100%;
    padding: 0.5rem;
    border: 1px solid var(--line);
    background: var(--bg-3);
  }

  .gallery-single img {
    display: block;
    width: 100%;
    height: auto;
  }

  .product-gallery {
    display: grid;
    gap: 0.6rem;
  }

  .gallery-main {
    position: relative;
    padding: 0.5rem;
    border: 1px solid var(--line);
    background: var(--bg-3);
    /* Let vertical page scroll pass through by default; the gallery
       script only takes over via preventDefault once a swipe is clearly
       horizontal, so this is a hint, not a hard lock. */
    touch-action: pan-y;
  }

  .gallery-slide {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The class-level `display: block` above otherwise wins over the
     browser's native `[hidden] { display: none }` UA rule (author styles
     beat user-agent styles regardless of specificity) — restore it
     explicitly so the hidden attribute actually hides inactive slides. */
  .gallery-slide[hidden] {
    display: none;
  }

  .gallery-nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    background: var(--bg-3);
    color: var(--ink-dim);
    cursor: pointer;
    opacity: 0;
    transform: translateY(-50%);
    transition: opacity 200ms var(--ease-premium), color 200ms var(--ease-premium), border-color 200ms var(--ease-premium);
  }

  .gallery-main:hover .gallery-nav,
  .gallery-main:focus-within .gallery-nav {
    opacity: 1;
  }

  .gallery-nav:hover {
    color: var(--ink);
    border-color: var(--accent-gold);
  }

  .gallery-nav:focus-visible {
    opacity: 1;
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .gallery-prev {
    left: 0.6rem;
  }

  .gallery-next {
    right: 0.6rem;
  }

  .gallery-thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .gallery-thumb {
    display: block;
    width: 3.75rem;
    height: 3.75rem;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg-3);
    cursor: pointer;
    transition: border-color 180ms var(--ease-premium), box-shadow 180ms var(--ease-premium);
  }

  .gallery-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-thumb:hover {
    border-color: var(--line-2);
  }

  .gallery-thumb.is-active {
    border-color: var(--accent-gold);
    box-shadow: 0 0 0 1px rgba(var(--gold-rgb), 0.35);
  }

  .gallery-thumb:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .product-actions {
    display: grid;
