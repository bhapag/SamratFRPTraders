---
import Breadcrumbs from '../Breadcrumbs.astro';
import CatalogCard from '../CatalogCard.astro';
import { getProductContent } from '../../data/product-content.js';
import { getGroup } from '../../data/products.js';
import { buildCanonicalUrl, buildProductQuoteLink } from '../../data/site.js';
import {
  applicationsFor,
  comparisonsFor,
  guidesFor,
  localDocUrl,
  relatedProductsFor,
  resourcesFor,
  sdsDoc,
  tdsDoc,
} from '../../utils/product-page.js';

const {
  product,
  lang = 'en',
  prefix = '',
  breadcrumbItems = [],
  description = '',
} = Astro.props;

const isNe = lang === 'ne';
const group = getGroup(product.group);
const content = getProductContent(product.slug);
const localized = content ? (isNe ? content.ne : content.en) : null;

const apps = applicationsFor(product).slice(0, 6);
const allResources = resourcesFor(product);
const comparisons = comparisonsFor(product);
const guides = guidesFor(product);
const related = relatedProductsFor(product);
const tds = tdsDoc(product);
const sds = sdsDoc(product);
const tdsLocal = localDocUrl(tds);
const sdsLocal = localDocUrl(sds);
const highlights = product.technicalHighlights ?? [];
const evidence = product.technicalEvidenceStatus === 'verified';
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname);

const t = isNe
  ? {
      docsTitle: 'प्राविधिक कागजातहरू',
      tdsLabel: 'Technical Data Sheet हेर्नुहोस्',
      sdsLabel: 'Safety Data Sheet हेर्नुहोस्',
      catalogueLabel: 'उत्पादन क्याटलग',
      catalogueNote: 'आपूर्तिकर्ता उत्पादन क्याटलग — Samrat Poly Resins, India',
      issuedBy: 'जारीकर्ता',
      aboutTitle: 'उत्पादनबारे थप',
      buyerTitle: 'खरिदकर्ताका लागि यसको अर्थ',
      specsTitle: 'प्राविधिक विवरण',
      specsSource: 'स्रोत',
      detailsTitle: 'उत्पादन विवरण',
      family: 'उत्पादन समूह',
      docs: 'कागजातहरू',
      supplier: 'आपूर्तिकर्ता',
      evidenceLabel: 'प्रमाण स्थिति',
      evidenceVerified: 'आपूर्तिकर्ता कागजातसँग पुष्टि गरिएको',
      evidencePending: 'पुष्टि हुँदै',
      enquiry: 'सोधपुछ',
      enquiryVia: 'सम्पर्क पृष्ठबाट',
      appsTitle: 'प्रयोगहरू',
      appsMore: 'सबै प्रयोगहरू हेर्नुहोस्',
      compareTitle: 'उत्पादन तुलनाहरू',
      faqTitle: 'सामान्य प्रश्नहरू',
      relatedTitle: 'सम्बन्धित उत्पादनहरू',
      hubTitle: 'प्राविधिक जानकारी केन्द्र',
      hubMore: 'सबै स्रोतहरू',
      quoteTitle: 'मूल्य: अनुरोधमा',
      quoteBody:
        'हालको मूल्य, उपलब्धता र प्याकेजिङ विकल्पका लागि सोधपुछ पठाउनुहोस् — प्रमाणित नभएसम्म व्यावसायिक शर्तहरू प्रकाशित गरिँदैन।',
      quoteCta: 'कोटेशन माग्नुहोस्',
      quoteWhatsApp: 'WhatsApp मा सोध्नुहोस्',
      quoteCall: 'फोन गर्नुहोस्',
    }
  : {
      docsTitle: 'Technical documents',
      tdsLabel: 'View Technical Data Sheet',
      sdsLabel: 'View Safety Data Sheet',
      catalogueLabel: 'Product catalogue',
      catalogueNote: 'Supplier product catalogue — Samrat Poly Resins, India',
      issuedBy: 'Issued by',
      aboutTitle: 'About this product',
      buyerTitle: 'What this means for buyers',
      specsTitle: 'Technical specifications',
      specsSource: 'Source',
      detailsTitle: 'Product details',
      family: 'Product family',
      docs: 'Documents',
      supplier: 'Supplier',
      evidenceLabel: 'Evidence status',
      evidenceVerified: 'Verified against supplier documentation',
      evidencePending: 'Being verified',
      enquiry: 'Enquiries',
      enquiryVia: 'Via the contact page',
      appsTitle: 'Applications',
      appsMore: 'Browse all applications',
      compareTitle: 'Product comparisons',
      faqTitle: 'Frequently asked questions',
      relatedTitle: 'Related products',
      hubTitle: 'Technical resource hub',
      hubMore: 'All resources',
      quoteTitle: 'Price on request',
      quoteBody:
        'For current pricing, availability and packaging options in Nepal, send an enquiry — commercial terms are only published once verified.',
      quoteCta: 'Request a quote',
      quoteWhatsApp: 'Ask on WhatsApp',
      quoteCall: 'Call us',
    };

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: buildCanonicalUrl(item.href) } : {}),
  })),
};

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: description || product.metaDescription || product.descriptor || '',
  ...(group ? { category: group.name } : {}),
  url: canonicalUrl,
};
---

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

<Breadcrumbs items={breadcrumbItems} />

<div class="product-layout">
  <div class="product-main">
    {product.descriptor && <p class="product-descriptor" data-reveal>{product.descriptor}</p>}

    <div class="doc-actions" data-reveal>
      {tds && (
        <a class="button button-primary doc-action" href={tdsLocal ?? tds.url} target="_blank" rel="noopener">
          {t.tdsLabel} ↗
        </a>
      )}
      {sds && (
        <a class="button doc-action" href={sdsLocal ?? sds.url} target="_blank" rel="noopener">
          {t.sdsLabel} ↗
        </a>
      )}
      <a
        class="button doc-action"
        href="/downloads/samrat-poly-resins-product-catalogue.pdf"
        target="_blank"
        rel="noopener"
      >
        {t.catalogueLabel} ↗
      </a>
    </div>
    <p class="doc-note" data-reveal>
      {t.issuedBy}: Samrat Poly Resins, India — {t.catalogueNote}
    </p>

    {localized?.intro && localized.intro.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.aboutTitle}</h2>
        <div class="prose">
          {localized.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>
    )}

    {localized?.buyerNotes && localized.buyerNotes.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.buyerTitle}</h2>
        <div class="note-grid">
          {localized.buyerNotes.map((note) => (
            <div class="note-card">
              <h3>{note.title}</h3>
              <p>{note.text}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {highlights.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.specsTitle}</h2>
        <dl class="spec-table">
          {highlights.map((item) => (
            <div class="spec-row">
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
        {product.technicalSource && (
          <p class="spec-source">
            {t.specsSource}: {product.technicalSource.issuer} — {product.technicalSource.type}
            {[product.technicalSource.reference, product.technicalSource.revision, product.technicalSource.date]
              .filter(Boolean)
              .join(' · ')}
          </p>
        )}
      </section>
    )}

    <section class="panel" data-reveal>
      <h2 class="panel-title">{t.detailsTitle}</h2>
      <div class="fact-grid">
        <div class="fact">
          <span>{t.family}</span>
          <strong>{group?.name ?? '—'}</strong>
        </div>
        <div class="fact">
          <span>{t.docs}</span>
          <strong>{[tds, sds].filter(Boolean).map((d) => d.type).join(' · ') || '—'}</strong>
        </div>
        <div class="fact">
          <span>{t.supplier}</span>
          <strong>Samrat Poly Resins, India</strong>
        </div>
        <div class="fact">
          <span>{t.evidenceLabel}</span>
          <strong>{evidence ? t.evidenceVerified : t.evidencePending}</strong>
        </div>
        <div class="fact">
          <span>{t.enquiry}</span>
          <strong><a href={`${prefix}/contact/`}>{t.enquiryVia}</a></strong>
        </div>
      </div>
    </section>

    {apps.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.appsTitle}</h2>
        {localized?.applicationsIntro && <p class="panel-lead">{localized.applicationsIntro}</p>}
        <div class="app-grid">
          {apps.map((app) => (
            <a class="app-card" href={`${prefix}/applications/${app.slug}/`}>
              <span class="app-media">
                {app.cardImage && (
                  <img
                    src={`/images/applications/${app.cardImage}`}
                    alt={app.cardImageAlt ?? ''}
                    loading="lazy"
                    width="700"
                    height="466"
                  />
                )}
              </span>
              <span class="app-body">
                <span class="app-title">{app.title}</span>
                <span class="app-desc">{app.cardDescription}</span>
              </span>
            </a>
          ))}
        </div>
        <div class="section-actions">
          <a class="button" href={`${prefix}/applications/`}>{t.appsMore}</a>
        </div>
      </section>
    )}

    {comparisons.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.compareTitle}</h2>
        <div class="compare-grid">
          {comparisons.map((r) => (
            <a class="compare-card" href={`${prefix}/resources/${r.slug}/`}>
              <span class="compare-title">{r.title}</span>
              <span class="compare-desc">{r.description}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {localized?.faqs && localized.faqs.length > 0 && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.faqTitle}</h2>
        <div class="faq-list">
          {localized.faqs.map((faq) => (
            <details class="faq-item">
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {!content && product.overview && (
      <section class="panel" data-reveal>
        <h2 class="panel-title">{t.aboutTitle}</h2>
        <div class="prose"><p>{product.overview}</p></div>
      </section>
    )}
  </div>

  <aside class="product-side" data-reveal>
    <div class="quote-box">
      <p class="quote-heading">{t.quoteTitle}</p>
      <p>{t.quoteBody}</p>
      <a
        class="button button-primary"
        href={buildProductQuoteLink(product.name, lang)}
        target="_blank"
        rel="noopener"
      >
        {t.quoteWhatsApp}
      </a>
      <a class="button" href={`${prefix}/contact/`}>{t.quoteCta}</a>
      <a class="button" href="tel:+9779805526904">{t.quoteCall}: +977 9805526904</a>
    </div>

    {related.length > 0 && (
      <div class="side-block">
        <p class="side-title">{t.relatedTitle}</p>
        <div class="side-list">
          {related.map((p) => (
            <a href={`${prefix}/products/${p.slug}/`}>
              <strong>{p.name}</strong>
              <span>{getGroup(p.group)?.name ?? ''}</span>
            </a>
          ))}
        </div>
      </div>
    )}

    {guides.length > 0 && (
      <div class="side-block">
        <p class="side-title">{t.hubTitle}</p>
        <div class="side-list">
          {guides.map((r) => (
            <a href={`${prefix}/resources/${r.slug}/`}>
              <strong>{r.title}</strong>
              <span>{r.readingTime}</span>
            </a>
          ))}
        </div>
        {allResources.length > guides.length && (
          <a class="side-more" href={`${prefix}/resources/`}>{t.hubMore} →</a>
        )}
      </div>
    )}
  </aside>
</div>

<style>
  .product-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 19rem);
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
    margin-top: 2rem;
  }

  .product-descriptor {
    max-width: 46rem;
    margin: 0 0 1.4rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .doc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .doc-note {
    margin: 0.7rem 0 0;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .panel {
    margin-top: 2.75rem;
  }

  .panel-title {
    margin-bottom: 1.1rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgba(var(--gold-rgb), 0.22);
    font-size: 1.5rem;
  }

  .panel-lead {
    margin: 0 0 1.2rem;
    color: var(--ink-dim);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .prose p {
    margin: 0 0 1.05rem;
    color: var(--ink-dim);
    font-size: 0.96rem;
    line-height: 1.75;
  }

  .prose p:last-child {
    margin-bottom: 0;
  }

  .note-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: 1rem;
  }

  .note-card {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-top: 0.2rem solid rgba(var(--gold-rgb), 0.55);
    background: var(--bg-2);
    box-shadow: var(--surface-shadow-rest);
  }

  .note-card h3 {
    margin-bottom: 0.55rem;
    color: var(--accent-gold-light);
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .note-card p {
    margin: 0;
    color: var(--ink-dim);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .spec-table {
    margin: 0;
    border: 1px solid var(--line);
    background: var(--bg-2);
  }

  .spec-row {
    display: grid;
    grid-template-columns: minmax(9rem, 15rem) 1fr;
    gap: 1rem;
    padding: 0.8rem 1.2rem;
    border-bottom: 1px solid var(--line);
  }

  .spec-row:last-child {
    border-bottom: 0;
  }

  .spec-row dt {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .spec-row dd {
    margin: 0;
    color: var(--ink);
    font-size: 0.92rem;
  }

  .spec-source {
    margin: 0.8rem 0 0;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.04em;
  }

  .fact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: 1rem;
  }

  .fact {
    padding: 0.95rem 1.1rem;
    border: 1px solid var(--line);
    background: var(--bg-3);
  }

  .fact span {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .fact strong {
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
  }

  .fact a {
    color: var(--accent-gold-light);
  }

  .app-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
  }

  .app-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--bg-3);
    box-shadow: var(--surface-shadow-rest);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 220ms var(--ease-premium), transform 220ms var(--ease-premium), box-shadow 220ms var(--ease-premium);
  }

  .app-card:hover {
    transform: translateY(-0.2rem);
    border-color: rgba(var(--gold-rgb), 0.65);
    box-shadow: var(--surface-shadow-hover);
  }

  .app-media img {
    width: 100%;
    aspect-ratio: 3 / 2;
    display: block;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }

  .app-body {
    display: grid;
    gap: 0.4rem;
    padding: 1rem 1.1rem 1.15rem;
  }

  .app-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .app-desc {
    color: var(--ink-dim);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .compare-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: 1rem;
  }

  .compare-card {
    display: grid;
    gap: 0.45rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    background: var(--bg-2);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 220ms var(--ease-premium), transform 220ms var(--ease-premium);
  }

  .compare-card:hover {
    transform: translateY(-0.2rem);
    border-color: rgba(var(--gold-rgb), 0.65);
  }

  .compare-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .compare-desc {
    color: var(--ink-dim);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .faq-item {
    border: 1px solid var(--line);
    border-bottom: 0;
    background: var(--bg-2);
  }

  .faq-item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    position: relative;
    padding: 1rem 2.4rem 1rem 1.15rem;
    cursor: pointer;
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 600;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    position: absolute;
    top: 50%;
    right: 1.05rem;
    transform: translateY(-50%);
    color: var(--accent-gold);
    font-family: var(--font-mono);
    font-size: 1.05rem;
    transition: transform 220ms var(--ease-premium);
  }

  .faq-item[open] summary::after {
    transform: translateY(-50%) rotate(45deg);
  }

  .faq-item p {
    margin: 0;
    padding: 0 1.15rem 1.1rem;
    color: var(--ink-dim);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .product-side {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 1.25rem;
  }

  .quote-box {
    padding: 1.3rem 1.25rem 1.35rem;
    border: 1px solid rgba(var(--gold-rgb), 0.45);
    background: linear-gradient(160deg, rgba(var(--gold-rgb), 0.09), rgba(var(--gold-rgb), 0.03));
  }

  .quote-heading {
    margin-bottom: 0.55rem;
    color: var(--accent-gold-light);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .quote-box p {
    color: var(--ink-dim);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .quote-box .button {
    width: 100%;
    margin-top: 0.3rem;
  }

  .side-block {
    border: 1px solid var(--line);
    background: var(--bg-2);
  }

  .side-title {
    margin: 0;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .side-list {
    display: grid;
  }

  .side-list a {
    display: grid;
    gap: 0.15rem;
    padding: 0.75rem 1.1rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: color 180ms var(--ease-premium);
  }

  .side-list a:last-child {
    border-bottom: 0;
  }

  .side-list a:hover strong {
    color: var(--accent-gold-light);
  }

  .side-list strong {
    font-size: 0.86rem;
    line-height: 1.35;
  }

  .side-list span {
    color: var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .side-more {
    display: block;
    padding: 0.75rem 1.1rem;
    color: var(--accent-gold-light);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (max-width: 53.75rem) {
    .product-layout {
      grid-template-columns: 1fr;
    }

    .product-side {
      position: static;
    }

    .spec-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
