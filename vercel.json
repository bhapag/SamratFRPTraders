{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/products/unsaturated-polyester-resin/?$",
      "status": 301,
      "headers": { "Location": "/products/polyester-resins/" }
    },
    {
      "src": "^/ne/?$",
      "status": 301,
      "headers": { "Location": "/" }
    },
    {
      "src": "^/ne/(.*)$",
      "status": 301,
      "headers": { "Location": "/$1" }
    },
    { "handle": "filesystem" },
    { "src": "^/en/(.*)$", "status": 404, "dest": "/en/404/index.html" },
    { "src": "^/(.*)$", "status": 404, "dest": "/404.html" }
  ]
}
